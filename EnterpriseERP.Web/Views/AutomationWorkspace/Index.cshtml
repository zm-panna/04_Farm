@model EnterpriseERP.Web.Controllers.AutomationPage
@{ViewData["Title"]="Automation and AI";}
<h1 data-i18n="Automation and AI">Automation and AI</h1><div class="notice"><span data-i18n="Worker">Worker</span>: <span data-i18n="@(Model.WorkerEnabled?"Enabled":"Disabled")">@(Model.WorkerEnabled?"Enabled":"Disabled")</span>. <span data-i18n="Only deterministic in-app alerts are executable. Approval records do not authorize the application to run AI-generated operations.">Only deterministic in-app alerts are executable. Approval records do not authorize the application to run AI-generated operations.</span></div>
<section class="panel"><h2 data-i18n="Branch notifications">Branch notifications</h2>@if(Model.Notifications.Count==0){<p data-i18n="No notifications for this branch.">No notifications for this branch.</p>}@foreach(var x in Model.Notifications){<p><strong data-i18n-enum="trigger" data-i18n-value="@x.Category">@x.Category</strong> <span data-i18n-system-message="notification">@x.Message</span> <small>@x.CreatedUtc.ToString("u")</small></p>}</section>
<div class="panels"><section class="panel"><h2 data-i18n="Create an in-app alert rule">Create an in-app alert rule</h2><form method="post" action="/Automation/rule">@Html.AntiForgeryToken()<label><span data-i18n="Name">Name</span><input name="name" maxlength="100" required/></label><label><span data-i18n="Trigger">Trigger</span><select name="trigger"><option value="Manual" data-i18n="Manual">Manual</option><option value="LowStock" data-i18n="LowStock">LowStock</option><option value="HealthDue" data-i18n="HealthDue">HealthDue</option></select></label><p data-i18n="LowStock means quantity ≤ 5. HealthDue uses recorded follow-up dates.">LowStock means quantity ≤ 5. HealthDue uses recorded follow-up dates.</p><button class="primary" data-i18n="Create rule">Create rule</button></form></section><section class="panel"><h2 data-i18n="Schedule one execution">Schedule one execution</h2><form method="post" action="/Automation/schedule">@Html.AntiForgeryToken()<label><span data-i18n="Rule">Rule</span><select name="ruleId">@foreach(var x in Model.Rules.Where(x=>x.Active)){<option value="@x.Id" data-i18n-template="automation-rule" data-i18n-values="@System.Text.Json.JsonSerializer.Serialize(new { name = x.Name, trigger = x.Trigger })">@x.Name (@x.Trigger)</option>}</select></label><label><span data-i18n="Due UTC (ISO 8601)">Due UTC (ISO 8601)</span><input name="dueUtc" value="@DateTimeOffset.UtcNow.AddMinutes(2).ToString("O")" required/></label><label><span data-i18n="Unique execution key">Unique execution key</span><input name="executionKey" maxlength="80" required/></label><button class="primary" data-i18n="Schedule">Schedule</button></form></section></div>
<section class="panel"><h2 data-i18n="Rules">Rules</h2><table class="data-table"><thead><tr><th data-i18n="Name">Name</th><th data-i18n="Trigger">Trigger</th><th data-i18n="Action">Action</th><th data-i18n="State">State</th><th data-i18n="Change">Change</th></tr></thead><tbody>@foreach(var x in Model.Rules){<tr><td>@x.Name</td><td data-i18n-enum="trigger" data-i18n-value="@x.Trigger">@x.Trigger</td><td data-i18n-enum="action" data-i18n-value="@x.Action">@x.Action</td><td data-i18n="@(x.Active?"Active":"Disabled")">@(x.Active?"Active":"Disabled")</td><td><form method="post" action="/Automation/toggle">@Html.AntiForgeryToken()<input type="hidden" name="ruleId" value="@x.Id"/><input type="hidden" name="active" value="@((!x.Active).ToString().ToLowerInvariant())"/><button data-i18n="@(x.Active?"Disable":"Enable")">@(x.Active?"Disable":"Enable")</button></form></td></tr>}</tbody></table></section>
<section class="panel"><h2 data-i18n="Scheduled jobs">Scheduled jobs</h2><table class="data-table"><thead><tr><th data-i18n="Key">Key</th><th data-i18n="UTC due">UTC due</th><th data-i18n="Status">Status</th><th data-i18n="Attempts">Attempts</th><th data-i18n="Result">Result</th></tr></thead><tbody>@foreach(var x in Model.Jobs){<tr><td>@x.ExecutionKey</td><td>@x.DueUtc.ToString("u")</td><td data-i18n-enum="job" data-i18n-value="@x.Status">@x.Status</td><td>@x.Attempt</td><td data-i18n="@(x.LastError is "Active rule unavailable in this company" or "Human review required; no domain write action is enabled" or "Unsupported notification trigger" ? x.LastError : null)">@x.LastError</td></tr>}</tbody></table></section>
<section class="panel" id="approval-browse"><h2 data-i18n="Proposal review history">Proposal review history</h2>
<partial name="_ActionableRecordBrowse" model="new EnterpriseERP.Web.Controllers.ActionableRecordBrowseModel(Model)" />
<table class="data-table"><thead><tr><th data-i18n="ID">ID</th><th data-i18n="Rule">Rule</th><th data-i18n="Requester">Requester</th><th data-i18n="Status">Status</th></tr></thead><tbody>@foreach(var x in Model.Approvals){<tr><td>@x.Id</td><td>@x.RuleId</td><td>@x.RequesterId</td><td data-i18n-enum="approval" data-i18n-value="@x.Status">@x.Status</td></tr>}</tbody></table></section>
<div class="panels"><section class="panel"><h2 data-i18n="Request independent proposal review">Request independent proposal review</h2><form method="post" action="/Automation/proposal">@Html.AntiForgeryToken()<label><span data-i18n="Rule">Rule</span><select name="ruleId">@foreach(var x in Model.Rules.Where(x=>x.Active)){<option value="@x.Id">@x.Name</option>}</select></label><label><span data-i18n="Exact proposal">Exact proposal</span><textarea name="payload" maxlength="10000" required></textarea></label><button class="primary" data-i18n="Request review">Request review</button></form></section><section class="panel"><h2 data-i18n="Approve a proposal">Approve a proposal</h2><p data-i18n="A different authorized person must enter the unchanged proposal. Approval is audit-only.">A different authorized person must enter the unchanged proposal. Approval is audit-only.</p><form method="post" action="/Automation/approve">@Html.AntiForgeryToken()<label><span data-i18n="Pending proposal">Pending proposal</span><select name="approvalId">@foreach(var x in Model.Approvals.Where(x=>x.Status=="Pending")){<option value="@x.Id" data-i18n-template="approval-request" data-i18n-values="@System.Text.Json.JsonSerializer.Serialize(new { id = x.Id.ToString(), rule = x.RuleId.ToString(), requester = x.RequesterId })">#@x.Id · rule @x.RuleId · requester @x.RequesterId</option>}</select></label><label><span data-i18n="Unchanged proposal">Unchanged proposal</span><textarea name="payload" maxlength="10000" required></textarea></label><button class="primary" data-i18n="Approve review">Approve review</button></form></section></div>
<section class="panel"><h2 data-i18n="Ask the configured local AI">Ask the configured local AI</h2><p data-i18n="Requires AI.Chat permission and enabled Ollama provider. Answers are advisory; no transactions or external messages are executed.">Requires AI.Chat permission and enabled Ollama provider. Answers are advisory; no transactions or external messages are executed.</p><form method="post" action="/Automation/ask">@Html.AntiForgeryToken()<label><span data-i18n="Question">Question</span><textarea name="question" maxlength="2000" required></textarea></label><button class="primary" data-i18n="Ask">Ask</button></form></section>
