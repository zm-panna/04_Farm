@model EnterpriseERP.Web.Controllers.CRMActivityEditor
@{ ViewData["Title"] = Model.Input.Id == 0 ? "New activity" : "Edit activity"; }
<section class="farm-workspace"><div class="page-head"><h1 data-i18n="@(ViewData["Title"])">@ViewData["Title"]</h1><a href="/crm/leads/@Model.Lead.Id">@Model.Lead.Name</a></div><div asp-validation-summary="All" class="notice" role="alert"></div>
<section class="panel"><form method="post" action="/crm/activities/save">@Html.AntiForgeryToken()<input asp-for="Input.Id" type="hidden"/><input asp-for="Input.LeadId" type="hidden"/><input name="Input.RowVersion" type="hidden" value="@Convert.ToBase64String(Model.Input.RowVersion)"/>
<label asp-for="Input.Reference" data-i18n="Activity reference">Activity reference</label><input asp-for="Input.Reference" maxlength="80" required readonly="@(Model.Input.Id != 0 ? "readonly" : null)"/><label asp-for="Input.Kind" data-i18n="Activity type">Activity type</label><select asp-for="Input.Kind"><option value="Task" data-i18n="Task">Task</option><option value="Call" data-i18n="Call">Call</option><option value="Meeting" data-i18n="Meeting">Meeting</option></select>
<label asp-for="Input.Title" data-i18n="Activity title">Activity title</label><input asp-for="Input.Title" maxlength="200" required/><label asp-for="Input.DueDate" data-i18n="Due date">Due date</label><input asp-for="Input.DueDate" type="date" required/>
<label asp-for="Input.OpportunityId" data-i18n="Linked opportunity">Linked opportunity</label><select asp-for="Input.OpportunityId"><option value="" data-i18n="Lead only">Lead only</option>@foreach(var row in Model.Opportunities){<option value="@row.Id">@row.Reference · @row.Title</option>}</select><label asp-for="Input.Notes" data-i18n="Internal notes">Internal notes</label><input asp-for="Input.Notes" maxlength="2000"/>
<p data-i18n="This records an internal task. It does not place a call, send a message, create an invitation or override marketing consent.">This records an internal task. It does not place a call, send a message, create an invitation or override marketing consent.</p><button class="primary" type="submit" data-i18n="Save activity">Save activity</button><a href="/crm/leads/@Model.Lead.Id" data-i18n="Cancel">Cancel</a></form></section></section>
