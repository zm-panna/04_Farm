@model EnterpriseERP.Domain.CRMQuote
<div class="table-wrap"><table><thead><tr><th data-i18n="Line">Line</th><th data-i18n="Product snapshot">Product snapshot</th><th data-i18n="Quantity">Quantity</th><th data-i18n="Unit price">Unit price</th><th data-i18n="Gross">Gross</th><th data-i18n="Discount">Discount</th><th data-i18n="Net">Net</th></tr></thead><tbody>@foreach(var line in Model.Lines.OrderBy(x=>x.LineNumber)){<tr><td>@line.LineNumber</td><td>@line.SKU · @line.ProductName</td><td>@line.Quantity.ToString("N3") @line.UnitOfMeasure</td><td>@line.UnitPrice.ToString("N"+Model.CurrencyMinorUnits)</td><td>@line.GrossAmount.ToString("N"+Model.CurrencyMinorUnits)</td><td>@line.DiscountAmount.ToString("N"+Model.CurrencyMinorUnits)</td><td>@line.NetAmount.ToString("N"+Model.CurrencyMinorUnits)</td></tr>}</tbody><tfoot><tr><th colspan="4">@Model.CurrencyCode <span data-i18n="net-only estimate">net-only estimate</span></th><td>@Model.GrossAmount.ToString("N"+Model.CurrencyMinorUnits)</td><td>@Model.DiscountAmount.ToString("N"+Model.CurrencyMinorUnits)</td><td>@Model.NetAmount.ToString("N"+Model.CurrencyMinorUnits)</td></tr></tfoot></table></div>
