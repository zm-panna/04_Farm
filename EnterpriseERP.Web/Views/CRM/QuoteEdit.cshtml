@model EnterpriseERP.Web.Controllers.CRMQuoteEditor
@{ ViewData["Title"] = Model.Input.Id == 0 ? "New quote draft" : "Edit quote draft"; }
<section class="farm-workspace"><div class="page-head"><h1 data-i18n="@(ViewData["Title"])">@ViewData["Title"]</h1><a href="/crm/opportunities/@Model.Opportunity.Id">@Model.Opportunity.Reference</a></div><div asp-validation-summary="All" class="notice" role="alert"></div>
<section class="panel"><p>@Model.Lead.Name · @Model.Lead.Email · @Model.Lead.Phone</p><p data-i18n="Saving a draft refreshes its recipient and product snapshots. Reviewed quotes must return to draft before editing.">Saving a draft refreshes its recipient and product snapshots. Reviewed quotes must return to draft before editing.</p><p><strong>@Model.CurrencyCode</strong> · @Model.CurrencyMinorUnits <span data-i18n="currency decimal places from reviewed company policy">currency decimal places from reviewed company policy</span></p>
<p class="notice" data-i18n="Net estimate only. Tax is not calculated or assumed to be zero. This is not a tax invoice, stock reservation or sales posting.">Net estimate only. Tax is not calculated or assumed to be zero. This is not a tax invoice, stock reservation or sales posting.</p>
<form method="post" action="/crm/quotes/save">@Html.AntiForgeryToken()<input asp-for="Input.Id" type="hidden"/><input asp-for="Input.OpportunityId" type="hidden"/><input name="Input.RowVersion" type="hidden" value="@Convert.ToBase64String(Model.Input.RowVersion)"/>
<label asp-for="Input.Reference" data-i18n="Quote reference">Quote reference</label><input asp-for="Input.Reference" maxlength="80" required readonly="@(Model.Input.Id != 0 ? "readonly" : null)"/><label asp-for="Input.QuoteDate" data-i18n="Quote date">Quote date</label><input asp-for="Input.QuoteDate" type="date" required/><label asp-for="Input.ValidUntil" data-i18n="Valid until">Valid until</label><input asp-for="Input.ValidUntil" type="date" required/>
<h2 data-i18n="Quote lines">Quote lines</h2><p data-i18n="Leave unused rows entirely blank or zero. Save and edit the draft to add five more rows, up to 50 lines. Discounts are explicit line amounts.">Leave unused rows entirely blank or zero. Save and edit the draft to add five more rows, up to 50 lines. Discounts are explicit line amounts.</p><div class="table-wrap"><table><thead><tr><th data-i18n="Product / stock unit">Product / stock unit</th><th data-i18n="Quantity">Quantity</th><th data-i18n="Unit price">Unit price</th><th data-i18n="Line discount">Line discount</th></tr></thead><tbody>
@for(var i=0;i<Model.Input.Lines.Count;i++){<tr><td><label class="sr-only" for="Input_Lines_@(i)__StockItemId"><span data-i18n="Product line">Product line</span> @(i+1)</label><select asp-for="Input.Lines[i].StockItemId"><option value="0" data-i18n="Unused row">Unused row</option>@foreach(var item in Model.Products){<option value="@item.Id">@item.SKU · @item.Name (@item.UnitOfMeasure)</option>}</select></td><td><label class="sr-only" for="Input_Lines_@(i)__Quantity"><span data-i18n="Quantity line">Quantity line</span> @(i+1)</label><input asp-for="Input.Lines[i].Quantity" type="number" min="0" step="0.001"/></td><td><label class="sr-only" for="Input_Lines_@(i)__UnitPrice"><span data-i18n="Unit price line">Unit price line</span> @(i+1)</label><input asp-for="Input.Lines[i].UnitPrice" type="number" min="0" step="0.001"/></td><td><label class="sr-only" for="Input_Lines_@(i)__DiscountAmount"><span data-i18n="Discount line">Discount line</span> @(i+1)</label><input asp-for="Input.Lines[i].DiscountAmount" type="number" min="0" step="0.001"/></td></tr>}
</tbody></table></div><label asp-for="Input.Terms" data-i18n="Internal quote terms">Internal quote terms</label><input asp-for="Input.Terms" maxlength="2000"/><button class="primary" type="submit" data-i18n="Save net quote draft">Save net quote draft</button><a href="/crm/opportunities/@Model.Opportunity.Id" data-i18n="Cancel">Cancel</a></form></section></section>
