@model EnterpriseERP.Web.Controllers.CRMActivityDetail
@{ ViewData["Title"]="Activity details"; var row=Model.Activity; }
<section class="farm-workspace"><div class="page-head"><div><h1>@row.Reference · @row.Title</h1><p><span data-i18n="@row.Kind">@row.Kind</span> · <span data-i18n="@row.Status">@row.Status</span> · @row.DueDate</p></div><a href="/crm/leads/@Model.Lead.Id">@Model.Lead.Name</a></div><div asp-validation-summary="All" class="notice" role="alert"></div>
<section class="panel"><p>@row.Notes</p><p><span data-i18n="Marketing consent">Marketing consent</span>: <span data-i18n="@Model.Lead.MarketingConsent">@Model.Lead.MarketingConsent</span></p>@if(row.OpportunityId.HasValue){<a href="/crm/opportunities/@row.OpportunityId" data-i18n="Linked opportunity">Linked opportunity</a>}
@if(row.Status=="Open" && Model.CanManage){<p><a href="/crm/activities/@row.Id/edit" data-i18n="Edit activity">Edit activity</a></p><form method="post" action="/crm/activities/@row.Id/close">@Html.AntiForgeryToken()<input name="rowVersion" type="hidden" value="@Convert.ToBase64String(row.RowVersion)"/><label for="activity-status" data-i18n="Close as">Close as</label><select id="activity-status" name="status"><option value="Done" data-i18n="Done">Done</option><option value="Cancelled" data-i18n="Cancelled">Cancelled</option></select><label for="completion-note" data-i18n="Completion / cancellation note">Completion / cancellation note</label><input id="completion-note" name="note" required maxlength="1000"/><button class="primary" type="submit" data-i18n="Close activity">Close activity</button></form>}
else if(row.Status != "Open"){<h2 data-i18n="Completion record">Completion record</h2><p>@row.CompletionNote</p><p>@row.CompletedBy · @row.CompletedUtc?.ToString("u")</p>}
<p data-i18n="This is an internal activity log. No communication was sent by CRM.">This is an internal activity log. No communication was sent by CRM.</p></section></section>
