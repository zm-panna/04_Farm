@model EnterpriseERP.Web.Controllers.CRMQuoteDetail
@{ ViewData["Title"]="Quote details"; var quote=Model.Quote; var open=CRMService.OpenStages.Contains(Model.Opportunity.Stage); }
<section class="farm-workspace"><div class="page-head"><div><h1>@quote.Reference</h1><p><span data-i18n="@quote.Status">@quote.Status</span> · @quote.CurrencyCode</p></div><a href="/crm/opportunities/@quote.OpportunityId">@Model.Opportunity.Reference</a></div><div asp-validation-summary="All" class="notice" role="alert"></div>
<section class="panel"><h2 data-i18n="Recipient snapshot">Recipient snapshot</h2><p>@quote.CustomerName · @quote.ContactName<br/>@quote.Email<br/>@quote.Phone<br/>@quote.Address</p><p><span data-i18n="Quote date">Quote date</span>: @quote.QuoteDate · <span data-i18n="Valid until">Valid until</span>: @quote.ValidUntil</p><p><span data-i18n="Business policy version">Business policy version</span>: @quote.BusinessPolicyVersion · <span data-i18n="Policy ID">Policy ID</span>: @quote.BusinessPolicyId</p><partial name="_QuoteLines" model="quote"/><p>@quote.Terms</p><p class="notice" data-i18n="Net estimate only. Tax is not calculated or assumed to be zero. This is not a tax invoice, stock reservation or sales posting.">Net estimate only. Tax is not calculated or assumed to be zero. This is not a tax invoice, stock reservation or sales posting.</p>
@if(Model.CanManage && quote.Status=="Draft" && open){<a href="/crm/quotes/@quote.Id/edit" data-i18n="Edit quote draft">Edit quote draft</a>}</section>
<section class="panel"><h2 data-i18n="Quote review">Quote review</h2><p>@quote.ReviewNote · @quote.ReviewedBy · @quote.ReviewedUtc?.ToString("u")</p>
@if(Model.CanReview && open && (quote.Status=="Draft" || quote.Status=="Reviewed")){<form method="post" action="/crm/quotes/@quote.Id/review">@Html.AntiForgeryToken()<input name="rowVersion" type="hidden" value="@Convert.ToBase64String(quote.RowVersion)"/><label for="review-action" data-i18n="Review action">Review action</label><select id="review-action" name="action">@if(quote.Status=="Draft"){<option value="Review" data-i18n="Approve internal quote snapshot">Approve internal quote snapshot</option>}else{<option value="ReturnToDraft" data-i18n="Return to draft and invalidate review">Return to draft and invalidate review</option>}<option value="Cancel" data-i18n="Cancel quote">Cancel quote</option></select><label for="review-note" data-i18n="Quote review note">Quote review note</label><input id="review-note" name="note" required maxlength="950"/><label><input name="reviewed" type="checkbox" value="true" required/> <span data-i18n="I reviewed the recipient, dates, currency, units, pricing and net-only scope.">I reviewed the recipient, dates, currency, units, pricing and net-only scope.</span></label><button type="submit" data-i18n="Record quote review">Record quote review</button></form>}</section>
@if(Model.Handoff!=null){<section class="panel"><h2 data-i18n="Accepted quote handoff">Accepted quote handoff</h2><a href="/crm/sales-ready/@Model.Handoff.Id">@Model.Handoff.Reference</a></section>}
@if(Model.CanReview && quote.Status=="Reviewed" && open){<section class="panel"><h2 data-i18n="Review customer conversion">Review customer conversion</h2><p class="notice" data-i18n="@CRMService.AcceptanceDisclosure">@CRMService.AcceptanceDisclosure</p><p data-i18n="A new customer uses the recipient snapshot shown above. Choosing an existing customer preserves that customer's current contact details. Consent stays with the lead; no marketing permission is transferred.">A new customer uses the recipient snapshot shown above. Choosing an existing customer preserves that customer's current contact details. Consent stays with the lead; no marketing permission is transferred.</p>
@if(Model.Lead.CustomerId.HasValue){<p><span data-i18n="This lead is already linked to customer ID">This lead is already linked to customer ID</span> @Model.Lead.CustomerId<span data-i18n=". Select that customer to continue.">. Select that customer to continue.</span></p>}
<form method="get" action="/crm/quotes/@quote.Id"><label for="customer-query" data-i18n="Find existing customer by code or name">Find existing customer by code or name</label><input id="customer-query" name="customerQuery" value="@Model.CustomerQuery" maxlength="200"/><button type="submit" data-i18n="Find customers">Find customers</button></form><p data-i18n="Showing up to 25 matching customers, plus any linked or selected customer.">Showing up to 25 matching customers, plus any linked or selected customer.</p>
<form method="post" action="/crm/quotes/accept">@Html.AntiForgeryToken()<input asp-for="Acceptance.QuoteId" type="hidden"/><input name="Acceptance.RowVersion" type="hidden" value="@Convert.ToBase64String(Model.Acceptance.RowVersion)"/><input name="Acceptance.OpportunityRowVersion" type="hidden" value="@Convert.ToBase64String(Model.Acceptance.OpportunityRowVersion)"/><input name="Acceptance.LeadRowVersion" type="hidden" value="@Convert.ToBase64String(Model.Acceptance.LeadRowVersion)"/>
<label asp-for="Acceptance.ExistingCustomerId" data-i18n="Existing customer">Existing customer</label><select asp-for="Acceptance.ExistingCustomerId"><option value="" data-i18n="Create a new customer using a new code below">Create a new customer using a new code below</option>@foreach(var customer in Model.Customers){<option value="@customer.Id">@customer.Code · @customer.Name</option>}</select><label asp-for="Acceptance.NewCustomerCode" data-i18n="New customer code, only when creating a customer">New customer code, only when creating a customer</label><input asp-for="Acceptance.NewCustomerCode" maxlength="30"/>
<label asp-for="Acceptance.SalesReadyReference" data-i18n="Unique internal handoff reference">Unique internal handoff reference</label><input asp-for="Acceptance.SalesReadyReference" maxlength="80" required/><label asp-for="Acceptance.AcceptanceEvidence" data-i18n="Evidence of customer acceptance and reviewed terms">Evidence of customer acceptance and reviewed terms</label><input asp-for="Acceptance.AcceptanceEvidence" maxlength="1000" required/><label><input asp-for="Acceptance.Reviewed" required/> <span data-i18n="I reviewed the accepted snapshot, customer link and internal-only conversion. Other open quotes for this opportunity will be cancelled.">I reviewed the accepted snapshot, customer link and internal-only conversion. Other open quotes for this opportunity will be cancelled.</span></label><button class="primary" type="submit" data-i18n="Record acceptance and create internal handoff">Record acceptance and create internal handoff</button></form></section>}</section>
