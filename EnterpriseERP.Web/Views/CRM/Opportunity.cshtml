@model EnterpriseERP.Web.Controllers.CRMOpportunityDetail
@{ ViewData["Title"]="Opportunity details"; var row=Model.Opportunity; var open=CRMService.OpenStages.Contains(row.Stage); }
<section class="farm-workspace"><div class="page-head"><div><h1>@row.Reference · @row.Title</h1><p><span data-i18n="@row.Stage">@row.Stage</span> · @row.ExpectedCloseDate</p></div><a href="/crm/leads/@Model.Lead.Id">@Model.Lead.Name</a></div><div asp-validation-summary="All" class="notice" role="alert"></div>
<section class="panel"><h2 data-i18n="Review record">Review record</h2><p>@row.ReviewNote</p><p>@row.ReviewedBy · @row.UpdatedUtc.ToString("u")</p>
@if(Model.CanManage && open){<p><a href="/crm/opportunities/@row.Id/edit" data-i18n="Edit opportunity">Edit opportunity</a> · <a href="/crm/quotes/new?opportunityId=@row.Id" data-i18n="New quote draft">New quote draft</a> · <a href="/crm/activities/new?leadId=@row.LeadId&amp;opportunityId=@row.Id" data-i18n="New activity">New activity</a></p>}
@if(Model.CanReview && open){<form method="post" action="/crm/opportunities/@row.Id/stage">@Html.AntiForgeryToken()<input name="rowVersion" type="hidden" value="@Convert.ToBase64String(row.RowVersion)"/><label for="targetStage" data-i18n="Next stage">Next stage</label><select id="targetStage" name="targetStage">@if(row.Stage=="Qualified" || row.Stage=="Negotiation"){<option value="Proposal" data-i18n="Proposal">Proposal</option>}@if(row.Stage=="Proposal"){<option value="Negotiation" data-i18n="Negotiation">Negotiation</option>}<option value="Lost" data-i18n="Lost">Lost</option></select><label for="stage-note" data-i18n="Stage review note">Stage review note</label><input id="stage-note" name="note" maxlength="950" required/><label><input name="reviewed" type="checkbox" value="true" required/> <span data-i18n="I reviewed this transition. Lost cancels all open quote drafts and reviews.">I reviewed this transition. Lost cancels all open quote drafts and reviews.</span></label><button type="submit" data-i18n="Save stage">Save stage</button></form>}
<p data-i18n="Won is recorded only through reviewed quote acceptance. Closed opportunities cannot be reopened or silently changed.">Won is recorded only through reviewed quote acceptance. Closed opportunities cannot be reopened or silently changed.</p></section>
<section class="panel"><h2 data-i18n="Latest quotes">Latest quotes</h2><p data-i18n="Showing the latest 10; use the list to search all records.">Showing the latest 10; use the list to search all records.</p><ul>@foreach(var quote in Model.Quotes){<li><a href="/crm/quotes/@quote.Id">@quote.Reference</a> · <span data-i18n="@quote.Status">@quote.Status</span> · @quote.CurrencyCode @quote.NetAmount.ToString("N"+quote.CurrencyMinorUnits) <span data-i18n="net only">net only</span></li>}</ul><a href="/crm?section=quotes&amp;leadId=@row.LeadId" data-i18n="All quotes for this lead">All quotes for this lead</a></section></section>
