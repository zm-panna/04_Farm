@model EnterpriseERP.Web.Controllers.CRMListModel
@{ ViewData["Title"] = "CRM"; string[] states = Model.Section switch { "leads" => ["Active","Converted","Archived"], "opportunities" => ["Qualified","Proposal","Negotiation","Won","Lost"], "activities" => ["Open","Overdue","Done","Cancelled"], "quotes" => ["Draft","Reviewed","Accepted","Cancelled"], _ => [] }; }
<section class="farm-workspace"><div class="page-head"><div><h1 data-i18n="CRM">CRM</h1><p data-i18n="Manage scoped leads, reviewed opportunities, due activities and net-only quote handoffs.">Manage scoped leads, reviewed opportunities, due activities and net-only quote handoffs.</p></div>@if(Model.CanManage){<a class="primary" href="/crm/leads/new" data-i18n="New lead">New lead</a>}</div>
<nav class="panel" aria-label="CRM sections" data-i18n-aria-label="CRM sections"><a href="/crm?section=leads" data-i18n="Leads">Leads</a> · <a href="/crm?section=opportunities" data-i18n="Opportunities">Opportunities</a> · <a href="/crm?section=activities" data-i18n="Activities">Activities</a> · <a href="/crm?section=quotes" data-i18n="Quotes">Quotes</a> · <a href="/crm?section=sales-ready" data-i18n="Sales-ready handoffs">Sales-ready handoffs</a></nav>
@if(Model.PolicyNotice != null){<p class="notice">@Model.PolicyNotice <a href="/business-policy" data-i18n="Business policies">Business policies</a></p>}
<section class="panel"><form method="get" action="/crm"><input name="section" type="hidden" value="@Model.Section"/><input name="leadId" type="hidden" value="@Model.LeadId"/><label for="crm-search" data-i18n="Search references or names">Search references or names</label><input id="crm-search" name="q" value="@Model.Query" maxlength="200"/>
@if(states.Length > 0){<label for="crm-status" data-i18n="Status">Status</label><select id="crm-status" name="status"><option value="" data-i18n="All">All</option>@foreach(var state in states){<option value="@state" data-i18n="@state" selected="@(Model.Status == state ? "selected" : null)">@state</option>}</select>}
<button class="primary" type="submit" data-i18n="Search">Search</button><a href="/crm?section=@Model.Section" data-i18n="Clear filters">Clear filters</a></form></section>
<section class="panel"><h2><span data-i18n="@(Model.Section switch { "leads" => "Leads", "opportunities" => "Opportunities", "activities" => "Activities", "quotes" => "Quotes", _ => "Sales-ready handoffs" })">@(Model.Section switch { "leads" => "Leads", "opportunities" => "Opportunities", "activities" => "Activities", "quotes" => "Quotes", _ => "Sales-ready handoffs" })</span> <small>(@Model.Total)</small></h2>
@if(Model.Total == 0){<p data-i18n="No records match these filters in the active branch.">No records match these filters in the active branch.</p>}
<div class="table-wrap"><table><thead><tr><th data-i18n="Reference">Reference</th><th data-i18n="Details">Details</th><th data-i18n="Status / amount">Status / amount</th><th data-i18n="Date / consent">Date / consent</th></tr></thead><tbody>
@foreach(var row in Model.Leads){<tr><td><a href="/crm/leads/@row.Id">@row.Reference</a></td><td>@row.Name<br/><small>@row.ContactName · @row.Email</small></td><td><span data-i18n="@row.Status">@row.Status</span></td><td><span data-i18n="@row.MarketingConsent">@row.MarketingConsent</span></td></tr>}
@foreach(var row in Model.Opportunities){<tr><td><a href="/crm/opportunities/@row.Id">@row.Reference</a></td><td>@row.Title</td><td><span data-i18n="@row.Stage">@row.Stage</span></td><td>@row.ExpectedCloseDate</td></tr>}
@foreach(var row in Model.Activities){<tr><td><a href="/crm/activities/@row.Id">@row.Reference</a></td><td><span data-i18n="@row.Kind">@row.Kind</span> · @row.Title</td><td><span data-i18n="@row.Status">@row.Status</span></td><td>@row.DueDate @if(row.Status=="Open" && row.DueDate<Model.Today){<strong data-i18n="Overdue">Overdue</strong>}</td></tr>}
@foreach(var row in Model.Quotes){<tr><td><a href="/crm/quotes/@row.Id">@row.Reference</a></td><td>@row.CustomerName<br/>@row.CurrencyCode @row.NetAmount.ToString("N"+row.CurrencyMinorUnits) <small data-i18n="net only">net only</small></td><td><span data-i18n="@row.Status">@row.Status</span></td><td>@row.ValidUntil</td></tr>}
@foreach(var row in Model.Handoffs){<tr><td><a href="/crm/sales-ready/@row.Id">@row.Reference</a></td><td>@row.CustomerCode · @row.CustomerName</td><td>@row.CurrencyCode @row.NetAmount.ToString("N"+row.CurrencyMinorUnits) <small data-i18n="net only">net only</small></td><td>@row.CreatedUtc.ToString("u")</td></tr>}
</tbody></table></div>
<p><span data-i18n="Page">Page</span> @Model.Page · <span data-i18n="25 records per page">25 records per page</span></p><nav aria-label="CRM pagination" data-i18n-aria-label="CRM pagination">@if(Model.Page > 1){<a asp-action="Index" asp-route-section="@Model.Section" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-leadId="@Model.LeadId" asp-route-page="@(Model.Page-1)" data-i18n="Previous">Previous</a>} @if(Model.Page*25 < Model.Total){<a asp-action="Index" asp-route-section="@Model.Section" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-leadId="@Model.LeadId" asp-route-page="@(Model.Page+1)" data-i18n="Next">Next</a>}</nav></section>
<p class="notice" data-i18n="CRM records internal work only. No emails, messages, stock reservations, sales invoices or ledger postings are created automatically.">CRM records internal work only. No emails, messages, stock reservations, sales invoices or ledger postings are created automatically.</p></section>
