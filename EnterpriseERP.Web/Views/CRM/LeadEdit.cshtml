@model EnterpriseERP.Web.CRMLeadInput
@{ ViewData["Title"] = Model.Id == 0 ? "New lead" : "Edit lead"; }
<section class="farm-workspace"><div class="page-head"><h1 data-i18n="@(ViewData["Title"])">@ViewData["Title"]</h1><a href="/crm" data-i18n="Leads">Leads</a></div><div asp-validation-summary="All" class="notice" role="alert"></div>
<section class="panel"><form method="post" action="/crm/leads/save">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"/><input name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)" type="hidden"/>
<label asp-for="Reference" data-i18n="Unique lead reference">Unique lead reference</label><input asp-for="Reference" required maxlength="80" readonly="@(Model.Id != 0 ? "readonly" : null)"/>
<label asp-for="Name" data-i18n="Lead / business name">Lead / business name</label><input asp-for="Name" required maxlength="160"/><label asp-for="ContactName" data-i18n="Contact name">Contact name</label><input asp-for="ContactName" maxlength="200"/>
<label asp-for="Email" data-i18n="Email">Email</label><input asp-for="Email" type="email" maxlength="200"/><label asp-for="Phone" data-i18n="Phone">Phone</label><input asp-for="Phone" maxlength="40"/>
<label asp-for="Address" data-i18n="Address">Address</label><input asp-for="Address" maxlength="500"/><label asp-for="Source" data-i18n="Lead source">Lead source</label><input asp-for="Source" maxlength="200"/>
<label asp-for="Notes" data-i18n="Internal notes">Internal notes</label><input asp-for="Notes" maxlength="2000"/>
<h2 data-i18n="Marketing consent">Marketing consent</h2><p data-i18n="Unknown is the default. Consent is recorded for marketing only; no outreach is sent by this module. Contact changes require fresh consent evidence or Unknown.">Unknown is the default. Consent is recorded for marketing only; no outreach is sent by this module. Contact changes require fresh consent evidence or Unknown.</p>
<label asp-for="MarketingConsent" data-i18n="Consent state">Consent state</label><select asp-for="MarketingConsent"><option value="Unknown" data-i18n="Unknown">Unknown</option><option value="Granted" data-i18n="Granted">Granted</option><option value="Withdrawn" data-i18n="Withdrawn">Withdrawn</option></select>
<label asp-for="ConsentEvidence" data-i18n="Consent source, purpose and date evidence">Consent source, purpose and date evidence</label><input asp-for="ConsentEvidence" maxlength="1000"/><label><input asp-for="ConsentReviewed"/> <span data-i18n="I reviewed any consent change and its evidence.">I reviewed any consent change and its evidence.</span></label>
<button class="primary" type="submit" data-i18n="Save lead">Save lead</button><a href="@(Model.Id == 0 ? "/crm" : "/crm/leads/"+Model.Id)" data-i18n="Cancel">Cancel</a></form></section></section>
