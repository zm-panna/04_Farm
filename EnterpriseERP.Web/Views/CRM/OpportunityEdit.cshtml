@model EnterpriseERP.Web.Controllers.CRMOpportunityEditor
@{ ViewData["Title"] = Model.Input.Id == 0 ? "Qualify opportunity" : "Edit opportunity"; }
<section class="farm-workspace"><div class="page-head"><h1 data-i18n="@(ViewData["Title"])">@ViewData["Title"]</h1><a href="/crm/leads/@Model.Lead.Id">@Model.Lead.Reference · @Model.Lead.Name</a></div><div asp-validation-summary="All" class="notice" role="alert"></div>
<section class="panel"><form method="post" action="/crm/opportunities/save">@Html.AntiForgeryToken()<input asp-for="Input.Id" type="hidden"/><input asp-for="Input.LeadId" type="hidden"/><input name="Input.RowVersion" type="hidden" value="@Convert.ToBase64String(Model.Input.RowVersion)"/><input name="Input.LeadRowVersion" type="hidden" value="@Convert.ToBase64String(Model.Input.LeadRowVersion)"/>
<label asp-for="Input.Reference" data-i18n="Opportunity reference">Opportunity reference</label><input asp-for="Input.Reference" required maxlength="80" readonly="@(Model.Input.Id != 0 ? "readonly" : null)"/>
<label asp-for="Input.Title" data-i18n="Opportunity title">Opportunity title</label><input asp-for="Input.Title" required maxlength="200"/><label asp-for="Input.ExpectedCloseDate" data-i18n="Expected close date">Expected close date</label><input asp-for="Input.ExpectedCloseDate" type="date" required/>
<label asp-for="Input.ReviewNote" data-i18n="Qualification / review note">Qualification / review note</label><input asp-for="Input.ReviewNote" required maxlength="1000"/><label><input asp-for="Input.Reviewed" required/> <span data-i18n="I reviewed this lead and the opportunity details.">I reviewed this lead and the opportunity details.</span></label><button class="primary" type="submit" data-i18n="Save reviewed opportunity">Save reviewed opportunity</button><a href="/crm/leads/@Model.Lead.Id" data-i18n="Cancel">Cancel</a></form></section></section>
