@model EnterpriseERP.Web.Controllers.CRMSalesReadyDetail
@{ ViewData["Title"]="Sales-ready handoff"; var row=Model.Handoff; }
<section class="farm-workspace"><div class="page-head"><div><h1>@row.Reference</h1><p data-i18n="Internal sales-ready handoff">Internal sales-ready handoff</p></div><a href="/crm?section=sales-ready" data-i18n="Sales-ready handoffs">Sales-ready handoffs</a></div><section class="panel"><p class="notice" data-i18n="@CRMService.AcceptanceDisclosure">@CRMService.AcceptanceDisclosure</p><p>@row.CustomerCode · @row.CustomerName · <span data-i18n="Customer ID">Customer ID</span> @row.CustomerId</p><p><a href="/crm/quotes/@row.QuoteId">@Model.Quote.Reference</a> · <a href="/crm/opportunities/@row.OpportunityId" data-i18n="Linked opportunity">Linked opportunity</a> · <a href="/crm/leads/@row.LeadId" data-i18n="Linked lead">Linked lead</a></p><partial name="_QuoteLines" model="Model.Quote"/><h2 data-i18n="Acceptance evidence">Acceptance evidence</h2><p>@row.AcceptanceEvidence</p><p>@row.CreatedBy · @row.CreatedUtc.ToString("u")</p><p data-i18n="This historical handoff is immutable. It is not proof that a sale has been posted or fulfilled. Review the core Sales workflow separately; there is no automatic sales posting or tax configuration in CRM.">This historical handoff is immutable. It is not proof that a sale has been posted or fulfilled. Review the core Sales workflow separately; there is no automatic sales posting or tax configuration in CRM.</p><a href="/Sales" data-i18n="Sales">Sales</a></section></section>
