@model EnterpriseERP.Web.Controllers.CRMLeadDetail
@{ ViewData["Title"] = "Lead details"; var lead=Model.Lead; }
<section class="farm-workspace"><div class="page-head"><div><h1>@lead.Reference · @lead.Name</h1><p data-i18n="@lead.Status">@lead.Status</p></div><a href="/crm" data-i18n="Leads">Leads</a></div><div asp-validation-summary="All" class="notice" role="alert"></div>
<section class="panel"><h2 data-i18n="Contact details">Contact details</h2><p>@lead.ContactName<br/>@lead.Email<br/>@lead.Phone<br/>@lead.Address</p><p><strong data-i18n="Lead source">Lead source</strong>: @lead.Source</p><p>@lead.Notes</p><p><strong data-i18n="Marketing consent">Marketing consent</strong>: <span data-i18n="@lead.MarketingConsent">@lead.MarketingConsent</span> · @lead.ConsentRecordedUtc?.ToString("u")</p><p>@lead.ConsentEvidence</p>
@if(lead.CustomerId.HasValue){<p><span data-i18n="Linked customer ID">Linked customer ID</span>: @lead.CustomerId · <a href="/Parties" data-i18n="Suppliers &amp; Customers">Suppliers &amp; Customers</a></p>}
@if(Model.CanManage && lead.Status!="Archived"){<p><a href="/crm/leads/@lead.Id/edit" data-i18n="Edit lead">Edit lead</a> · <a href="/crm/opportunities/new?leadId=@lead.Id" data-i18n="Qualify opportunity">Qualify opportunity</a> · <a href="/crm/activities/new?leadId=@lead.Id" data-i18n="New activity">New activity</a></p>}
@if(Model.CanManage){<form method="post" action="/crm/leads/@lead.Id/archive">@Html.AntiForgeryToken()<input name="rowVersion" type="hidden" value="@Convert.ToBase64String(lead.RowVersion)"/><input name="archive" type="hidden" value="@(lead.Status=="Archived"?"false":"true")"/><label><input name="reviewed" type="checkbox" value="true" required/> <span data-i18n="I reviewed this archive or restore action. History is retained.">I reviewed this archive or restore action. History is retained.</span></label><button type="submit" data-i18n="@(lead.Status=="Archived"?"Restore lead":"Archive lead")">@(lead.Status=="Archived"?"Restore lead":"Archive lead")</button></form>}</section>
<section class="panel"><h2 data-i18n="Latest opportunities">Latest opportunities</h2><p data-i18n="Showing the latest 10; use the list to search all records.">Showing the latest 10; use the list to search all records.</p><ul>@foreach(var row in Model.Opportunities){<li><a href="/crm/opportunities/@row.Id">@row.Reference · @row.Title</a> · <span data-i18n="@row.Stage">@row.Stage</span></li>}</ul><a href="/crm?section=opportunities&amp;leadId=@lead.Id" data-i18n="All opportunities for this lead">All opportunities for this lead</a></section>
<section class="panel"><h2 data-i18n="Latest activities">Latest activities</h2><ul>@foreach(var row in Model.Activities){<li><a href="/crm/activities/@row.Id">@row.Reference · @row.Title</a> · @row.DueDate · <span data-i18n="@row.Status">@row.Status</span></li>}</ul><a href="/crm?section=activities&amp;leadId=@lead.Id" data-i18n="All activities for this lead">All activities for this lead</a></section>
<section class="panel"><h2 data-i18n="Consent history">Consent history</h2><p data-i18n="Consent changes are retained with actor, time and evidence. No permission to send is inferred from Unknown.">Consent changes are retained with actor, time and evidence. No permission to send is inferred from Unknown.</p><ul>@foreach(var row in Model.ConsentEvents){<li>@row.RecordedUtc.ToString("u") · <span data-i18n="@row.PreviousConsent">@row.PreviousConsent</span> → <span data-i18n="@row.Consent">@row.Consent</span> · @row.ActorId<br/>@row.Evidence</li>}</ul><p>@Model.ConsentTotal <span data-i18n="records">records</span></p>@if(Model.ConsentPage>1){<a href="/crm/leads/@lead.Id?consentPage=@(Model.ConsentPage-1)" data-i18n="Previous">Previous</a>} @if(Model.ConsentPage*20<Model.ConsentTotal){<a href="/crm/leads/@lead.Id?consentPage=@(Model.ConsentPage+1)" data-i18n="Next">Next</a>}</section></section>
