@model EnterpriseERP.Web.Controllers.StockTransferDetail
@{ ViewData["Title"] = "Transfer details"; var t = Model.Transfer; }
<section class="farm-workspace"><div class="page-head"><div><h1>@t.Reference</h1><p>@t.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") · @t.CreatedBy</p></div><a href="/stock-transfers" data-transfer-i18n="Transfer history">Transfer history</a></div>
<section class="panel"><h2 data-transfer-i18n="Immutable transfer record">Immutable transfer record</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-transfer-i18n="Location / product at posting">Location / product at posting</th><th data-transfer-i18n="Quantity before">Quantity before</th><th data-transfer-i18n="Quantity after">Quantity after</th><th data-transfer-i18n="Value before">Value before</th><th data-transfer-i18n="Value after">Value after</th><th data-transfer-i18n="Movement ID">Movement ID</th></tr></thead><tbody><tr><td>@t.SourceBranchName<br/>@t.SourceSku · @t.SourceProductName</td><td>@t.SourceQuantityBefore.ToString("N3")</td><td>@t.SourceQuantityAfter.ToString("N3")</td><td>@t.SourceValueBefore.ToString("N3")</td><td>@t.SourceValueAfter.ToString("N3")</td><td>@t.SourceMovementId</td></tr><tr><td>@t.DestinationBranchName<br/>@t.DestinationSku · @t.DestinationProductName</td><td>@t.DestinationQuantityBefore.ToString("N3")</td><td>@t.DestinationQuantityAfter.ToString("N3")</td><td>@t.DestinationValueBefore.ToString("N3")</td><td>@t.DestinationValueAfter.ToString("N3")</td><td>@t.DestinationMovementId</td></tr></tbody></table></div><p><span data-i18n="Quantity">Quantity</span>: @t.Quantity.ToString("N3") @t.UnitOfMeasure · <span data-transfer-i18n="Transferred carrying value">Transferred carrying value</span>: @t.CostAmount.ToString("N3")</p>@if(!string.IsNullOrEmpty(t.Note)){<p>@t.Note</p>}<a href="/stock-ledger?productId=@(Model.ActiveBranchId==t.SourceBranchId?t.SourceStockItemId:t.DestinationStockItemId)" data-transfer-i18n="View active branch stock ledger">View active branch stock ledger</a></section>
<section class="panel"><h2 data-transfer-i18n="Paired accounting journals">Paired accounting journals</h2><p data-transfer-i18n="1300 is inventory. 1290 is interbranch clearing; its debit and credit cancel across this company.">1300 is inventory. 1290 is interbranch clearing; its debit and credit cancel across this company.</p>
@if(t.CostAmount==0){<p data-transfer-i18n="Zero-value stock transfer: no monetary journal is required.">Zero-value stock transfer: no monetary journal is required.</p>}
@foreach(var voucher in Model.Vouchers){<h3>@(voucher.BranchId==t.SourceBranchId?t.SourceBranchName:t.DestinationBranchName): @voucher.Reference (#@voucher.Id)</h3><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Account">Account</th><th data-i18n="Debit">Debit</th><th data-i18n="Credit">Credit</th></tr></thead><tbody>@foreach(var line in voucher.Lines.OrderBy(x=>x.Id)){<tr><td>@line.AccountCode</td><td>@line.Debit.ToString("N3")</td><td>@line.Credit.ToString("N3")</td></tr>}</tbody></table></div>}</section>
<section class="panel"><h2 data-transfer-i18n="Correcting a transfer">Correcting a transfer</h2><p data-transfer-i18n="Switch to the receiving branch and post a new transfer in the opposite direction, with a new reference and this original reference in the note. Available stock and current carrying value are checked again; subsequent receipts or consumption can change the returned value.">Switch to the receiving branch and post a new transfer in the opposite direction, with a new reference and this original reference in the note. Available stock and current carrying value are checked again; subsequent receipts or consumption can change the returned value.</p><a href="/Context" data-i18n="Switch Company / Branch">Switch Company / Branch</a></section></section>

