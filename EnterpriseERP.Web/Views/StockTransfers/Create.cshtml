@model EnterpriseERP.Web.Controllers.StockTransferEditor
@{ ViewData["Title"] = "New stock transfer"; var source = Model.Sources.FirstOrDefault(x => x.Id == Model.Input.SourceItemId); var destination = Model.Destinations.FirstOrDefault(x => x.Id == Model.Input.DestinationBranchId); }
<section class="farm-workspace"><div class="page-head"><div><h1 data-transfer-i18n="New stock transfer">New stock transfer</h1><p>@Model.SourceBranch</p></div><a href="/stock-transfers" data-transfer-i18n="Transfer history">Transfer history</a></div>
<div asp-validation-summary="All" class="notice" role="alert"></div>
<section class="panel"><h2 data-transfer-i18n="Choose source and destination">Choose source and destination</h2><p data-transfer-i18n="Transfers post immediately between branches of this company. Both products must use the same SKU and stock unit.">Transfers post immediately between branches of this company. Both products must use the same SKU and stock unit.</p>
<form method="get" action="/stock-transfers/new"><label for="sourceItemId" data-transfer-i18n="Source product">Source product</label><select id="sourceItemId" name="sourceItemId" required><option value="" data-i18n="Choose an item">Choose an item</option>@foreach(var item in Model.Sources){<option value="@item.Id" selected="@(item.Id==Model.Input.SourceItemId?"selected":null)">@item.SKU · @item.Name (@item.QuantityOnHand.ToString("N3") @item.UnitOfMeasure)</option>}</select>
<label for="destinationBranchId" data-transfer-i18n="Destination branch">Destination branch</label><select id="destinationBranchId" name="destinationBranchId" required><option value="" data-transfer-i18n="Choose a branch">Choose a branch</option>@foreach(var branch in Model.Destinations){<option value="@branch.Id" selected="@(branch.Id==Model.Input.DestinationBranchId?"selected":null)">@branch.Name</option>}</select><button class="primary" type="submit" data-transfer-i18n="Find matching destination products">Find matching destination products</button></form>
@if(Model.Destinations.Count==0){<p class="notice" data-transfer-i18n="Access to another branch in this company is required to transfer stock.">Access to another branch in this company is required to transfer stock.</p>}</section>
@if(source is not null && destination is not null){<section class="panel"><h2>@source.SKU: @Model.SourceBranch → @destination.Name</h2>
@if(Model.DestinationItems.Count==0){<p class="notice" data-transfer-i18n="No matching SKU exists in this destination. Create the product in that branch first, using the same stock unit.">No matching SKU exists in this destination. Create the product in that branch first, using the same stock unit.</p>}
else{<form method="post" action="/stock-transfers/post">@Html.AntiForgeryToken()<input asp-for="Input.SourceItemId" type="hidden"/><input asp-for="Input.DestinationBranchId" type="hidden"/>
<label asp-for="Input.DestinationItemId" data-transfer-i18n="Destination product">Destination product</label><select asp-for="Input.DestinationItemId" required>@foreach(var item in Model.DestinationItems){<option value="@item.Id">@item.SKU · @item.Name (@item.QuantityOnHand.ToString("N3") @item.UnitOfMeasure)</option>}</select>
<p><span data-transfer-i18n="Stock unit">Stock unit</span>: @(source.UnitOfMeasure==""?"?":source.UnitOfMeasure)</p>
<label asp-for="Input.Quantity" data-i18n="Quantity">Quantity</label><input asp-for="Input.Quantity" type="number" min="0.001" max="@source.QuantityOnHand.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.001" required/>
<label asp-for="Input.Reference" data-transfer-i18n="Unique transfer reference">Unique transfer reference</label><input asp-for="Input.Reference" maxlength="80" required/>
<label asp-for="Input.Note" data-transfer-i18n="Transfer note / original reference for a correction">Transfer note / original reference for a correction</label><textarea asp-for="Input.Note" maxlength="500"></textarea>
<p data-transfer-i18n="Exact carrying value and both journals are calculated at posting. Posted movements cannot be edited or deleted.">Exact carrying value and both journals are calculated at posting. Posted movements cannot be edited or deleted.</p>
<button class="primary" type="submit" data-transfer-i18n="Post transfer to both branches">Post transfer to both branches</button></form>}</section>}
<section class="panel"><p data-transfer-i18n="This workflow tracks branch stock. Physical warehouse bins, batches, expiry dates and lot allocation are not tracked.">This workflow tracks branch stock. Physical warehouse bins, batches, expiry dates and lot allocation are not tracked.</p></section></section>

