@model EnterpriseERP.Web.Controllers.StockTransferList
@{ ViewData["Title"] = "Stock transfers"; }
<section class="farm-workspace">
<div class="page-head"><div><h1 data-transfer-i18n="Stock transfers">Stock transfers</h1><p data-transfer-i18n="Posted transfers involving the active branch and branches you can access.">Posted transfers involving the active branch and branches you can access.</p></div>@if(Model.CanTransfer){<a class="primary" href="/stock-transfers/new" data-transfer-i18n="New stock transfer">New stock transfer</a>}</div>
<p><a href="/Inventory" data-i18n="Inventory">Inventory</a> · <a href="/stock-ledger" data-i18n="Stock Movement Ledger">Stock Movement Ledger</a></p>
<section class="panel"><form method="get" action="/stock-transfers"><label for="transfer-search" data-transfer-i18n="Transfer reference">Transfer reference</label><input id="transfer-search" name="q" value="@Model.Query" maxlength="80"/><button type="submit" data-i18n="Filter">Filter</button></form></section>
<section class="panel"><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Date (UTC)">Date (UTC)</th><th data-i18n="Reference">Reference</th><th data-transfer-i18n="Source branch / product">Source branch / product</th><th data-transfer-i18n="Destination branch / product">Destination branch / product</th><th data-i18n="Quantity">Quantity</th><th data-transfer-i18n="Transferred carrying value">Transferred carrying value</th></tr></thead><tbody>
@foreach(var transfer in Model.Transfers){<tr><td>@transfer.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td><td><a href="/stock-transfers/@transfer.Id">@transfer.Reference</a></td><td>@transfer.SourceBranchName<br/>@transfer.SourceSku · @transfer.SourceProductName</td><td>@transfer.DestinationBranchName<br/>@transfer.DestinationSku · @transfer.DestinationProductName</td><td>@transfer.Quantity.ToString("N3") @transfer.UnitOfMeasure</td><td>@transfer.CostAmount.ToString("N3")</td></tr>}
@if(Model.Transfers.Count==0){<tr><td colspan="6" data-transfer-i18n="No transfers found.">No transfers found.</td></tr>}
</tbody></table></div><nav aria-label="Transfer pages">@if(Model.Page>1){<a href="/stock-transfers?page=@(Model.Page-1)&q=@Uri.EscapeDataString(Model.Query??"")" data-i18n="Previous">Previous</a>} @(Model.Page) / @Math.Max(1,(Model.Total+24)/25) @if(Model.Page*25<Model.Total){<a href="/stock-transfers?page=@(Model.Page+1)&q=@Uri.EscapeDataString(Model.Query??"")" data-i18n="Next">Next</a>}</nav></section></section>

