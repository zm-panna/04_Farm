@model EcommerceManagePage
@{ViewData["Title"]="Manage catalog";}
<div class="page-header"><h1 data-i18n="Manage catalog">Manage catalog</h1><a href="/Ecommerce" class="muted-btn" data-i18n="Back to catalog">Back to catalog</a></div>
<p class="notice" data-i18n="Publishing needs an approved company currency and tax policy. Customer links use existing verified identities with branch access; entering an email never claims an account.">Publishing needs an approved company currency and tax policy. Customer links use existing verified identities with branch access; entering an email never claims an account.</p>
<form method="post" action="/Ecommerce/customer-link" class="panel">@Html.AntiForgeryToken()<h2 data-i18n="Link verified customer">Link verified customer</h2><label data-i18n="Verified identity">Verified identity</label><select name="existingUserId" required><option value="" data-i18n="Select">Select</option>@foreach(var user in Model.Identities){<option value="@user.Id">@user.Email · @user.Id</option>}</select><label data-i18n="Customer">Customer</label><select name="partyId" required><option value="" data-i18n="Select">Select</option>@foreach(var customer in Model.Customers){<option value="@customer.Id">@customer.Code · @customer.Name</option>}</select><label><input type="checkbox" name="confirmIdentityVerified" value="true" required style="width:auto"/><span data-i18n="I verified this existing account belongs to the selected customer.">I verified this existing account belongs to the selected customer.</span></label><button class="primary" data-i18n="Link customer">Link customer</button><p><span data-i18n="Existing links">Existing links</span>: @Model.Links.Count</p></form>
<form method="post" action="/Ecommerce/product" class="panel">@Html.AntiForgeryToken()<h2 data-i18n="Publish product">Publish product</h2><label data-i18n="Stock item">Stock item</label><select name="stockItemId" required><option value="" data-i18n="Select">Select</option>@foreach(var stock in Model.Stock){<option value="@stock.Id">@stock.SKU · @stock.Name · @stock.UnitOfMeasure</option>}</select><label data-i18n="Product title">Product title</label><input name="title" maxlength="160" required/><label data-i18n="Description">Description</label><textarea name="description" maxlength="2000"></textarea><label data-i18n="Category">Category</label><input name="category" maxlength="100"/><label data-i18n="Net unit price">Net unit price</label><input name="netUnitPrice" type="number" min="@Model.MoneyStep" step="@Model.MoneyStep" required/><label data-i18n="Approved tax policy">Approved tax policy</label><select name="taxPolicyId" required><option value="" data-i18n="Select">Select</option>@foreach(var tax in Model.TaxPolicies.Where(x=>x.Status=="Approved")){<option value="@tax.Id" data-i18n-template="ecommerce-tax-policy" data-i18n-values="@System.Text.Json.JsonSerializer.Serialize(new { code = tax.Code, version = tax.Version.ToString(System.Globalization.CultureInfo.InvariantCulture), rate = tax.RatePercent.ToString(System.Globalization.CultureInfo.InvariantCulture), treatment = tax.TaxTreatment })">@tax.Code v@tax.Version · @tax.RatePercent% · @tax.TaxTreatment</option>}</select><label><input name="published" type="checkbox" value="true" style="width:auto"/><span data-i18n="Published">Published</span></label><button class="primary" data-i18n="Save product">Save product</button></form>
<section class="panel"><h2 data-i18n="Existing products">Existing products</h2>@foreach(var product in Model.Products){<details><summary>@product.Title · @product.CurrencyCode @Model.Money(product.NetUnitPrice) · <span data-i18n="@(product.Published ? "Published" : "Unpublished")">@(product.Published ? "Published" : "Unpublished")</span></summary><form method="post" action="/Ecommerce/product">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@product.Id"/><input type="hidden" name="stockItemId" value="@product.StockItemId"/><input type="hidden" name="revisionToken" value="@product.RevisionToken"/><label data-i18n="Product title">Product title</label><input name="title" value="@product.Title" maxlength="160" required/><label data-i18n="Description">Description</label><textarea name="description" maxlength="2000">@product.Description</textarea><label data-i18n="Category">Category</label><input name="category" value="@product.Category" maxlength="100"/><label data-i18n="Net unit price">Net unit price</label><input name="netUnitPrice" value="@product.NetUnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="@Model.MoneyStep" step="@Model.MoneyStep" required/><label data-i18n="Approved tax policy">Approved tax policy</label><select name="taxPolicyId" required>@foreach(var tax in Model.TaxPolicies.Where(x=>x.Status=="Approved")){<option value="@tax.Id" selected="@(product.TaxPolicyId==tax.Id)" data-i18n-template="ecommerce-tax-policy" data-i18n-values="@System.Text.Json.JsonSerializer.Serialize(new { code = tax.Code, version = tax.Version.ToString(System.Globalization.CultureInfo.InvariantCulture), rate = tax.RatePercent.ToString(System.Globalization.CultureInfo.InvariantCulture), treatment = tax.TaxTreatment })">@tax.Code v@tax.Version · @tax.RatePercent% · @tax.TaxTreatment</option>}</select><label><input name="published" type="checkbox" value="true" checked="@product.Published" style="width:auto"/><span data-i18n="Published">Published</span></label><button class="primary" data-i18n="Save product">Save product</button></form></details>}</section>
