@model EcommerceOrdersPage
@{ViewData["Title"]=Model.Staff ? "Order fulfillment" : "My orders"; var route=Model.Staff?"/Ecommerce/staff/orders":"/Ecommerce/orders";}
<div class="page-header"><h1 data-i18n="@ViewData["Title"]">@ViewData["Title"]</h1><a href="/Ecommerce" class="muted-btn" data-i18n="Back to catalog">Back to catalog</a></div>
<form method="get" action="@route" class="panel"><label data-i18n="Order reference">Order reference</label><input name="search" value="@Model.Search" maxlength="100"/><label data-i18n="Status">Status</label><select name="status"><option value="" data-i18n="All">All</option>@foreach(var status in new[]{"Submitted","Approved","Fulfilled","Cancelled"}){<option value="@status" selected="@(Model.Status==status)" data-i18n="@status">@status</option>}</select><button class="primary" data-i18n="Search">Search</button></form>
<section class="panel"><p><span data-i18n="Orders">Orders</span>: @Model.Total</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Order reference">Order reference</th><th data-i18n="Customer">Customer</th><th data-i18n="Status">Status</th><th data-i18n="Total">Total</th><th data-i18n="Payment verification">Payment verification</th></tr></thead><tbody>@foreach(var order in Model.Orders){<tr><td><a href="@route/@order.Id">@order.Reference</a></td><td>@order.CustomerName</td><td data-i18n="@order.Status">@order.Status</td><td>@order.CurrencyCode @EcommerceMoneyPresentation.Format(order.GrossAmount, order.CurrencyMinorUnits)</td><td data-i18n="Pending manual verification">Pending manual verification</td></tr>}</tbody></table></div>@if(Model.Total==0){<p data-i18n="No orders match your filters.">No orders match your filters.</p>}<nav aria-label="Order pages" data-i18n-aria-label="Order pages"><span data-i18n="Page">Page</span> @Model.Page / @Model.Pages @if(Model.Page>1){<a href="@route?page=@(Model.Page-1)&amp;search=@Uri.EscapeDataString(Model.Search)&amp;status=@Model.Status" data-i18n="Previous">Previous</a>} @if(Model.Page<Model.Pages){<a href="@route?page=@(Model.Page+1)&amp;search=@Uri.EscapeDataString(Model.Search)&amp;status=@Model.Status" data-i18n="Next">Next</a>}</nav></section>
