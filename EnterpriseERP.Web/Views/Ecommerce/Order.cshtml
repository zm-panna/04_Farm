@model EcommerceOrderPage
@{var order=Model.Order; ViewData["Title"]=order.Reference; var route=Model.Staff?"/Ecommerce/staff/orders":"/Ecommerce/orders";}
<div class="page-header"><div><h1>@order.Reference</h1><p>@order.CustomerName · <span data-i18n="@order.Status">@order.Status</span></p></div><a href="@route" class="muted-btn" data-i18n="Back to orders">Back to orders</a></div>
<p class="notice" data-i18n="Payment is pending manual verification. No payment provider has been charged. Financial receipts and refunds are recorded separately against linked sales documents.">Payment is pending manual verification. No payment provider has been charged. Financial receipts and refunds are recorded separately against linked sales documents.</p>
<section class="panel"><p><span data-i18n="Branch collection">Branch collection</span> · @order.CountryCode @order.RegionCode · @order.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Product">Product</th><th data-i18n="Quantity">Quantity</th><th data-i18n="Net amount">Net amount</th><th data-i18n="Tax">Tax</th><th data-i18n="Total">Total</th></tr></thead><tbody>@foreach(var line in order.Lines){<tr><td>@line.Title</td><td>@line.Quantity.ToString("N3") @line.UnitOfMeasure</td><td>@Model.Money(line.NetAmount)</td><td>@Model.Money(line.TaxAmount) (@line.TaxRatePercent.ToString("N3")%, <span data-i18n="@line.TaxTreatment">@line.TaxTreatment</span>)</td><td>@Model.Money(line.GrossAmount)</td></tr>}</tbody></table></div><p><strong>@order.CurrencyCode @Model.Money(order.GrossAmount)</strong></p></section>
@if(Model.Staff && order.Status=="Submitted"){
<form method="post" action="@route/@order.Id/approve" class="panel">@Html.AntiForgeryToken()<input name="stateToken" value="@order.StateToken" type="hidden"/><h2 data-i18n="Review order">Review order</h2><label data-i18n="Review note">Review note</label><textarea name="reviewNote" maxlength="1000" required></textarea><label><input type="checkbox" name="confirmReview" value="true" required style="width:auto"/><span data-i18n="I reviewed the customer identity, stock, configured tax and collection arrangements.">I reviewed the customer identity, stock, configured tax and collection arrangements.</span></label><button class="primary" data-i18n="Approve order">Approve order</button></form>}
@if(Model.Staff && order.Status=="Approved"){
<form method="post" action="@route/@order.Id/fulfill" class="panel">@Html.AntiForgeryToken()<input name="stateToken" value="@order.StateToken" type="hidden"/><h2 data-i18n="Fulfill order">Fulfill order</h2><label><input name="confirmFulfillment" value="true" type="checkbox" required style="width:auto"/><span data-i18n="I confirm goods are released for branch collection and the customer receivable, sales, tax and inventory cost will be posted. Payment remains unverified.">I confirm goods are released for branch collection and the customer receivable, sales, tax and inventory cost will be posted. Payment remains unverified.</span></label><button class="primary" data-i18n="Post fulfillment">Post fulfillment</button></form>}
@if(order.Status is "Submitted" or "Approved"){
<form method="post" action="@route/@order.Id/cancel" class="panel">@Html.AntiForgeryToken()<input name="stateToken" value="@order.StateToken" type="hidden"/><label data-i18n="Cancellation reason">Cancellation reason</label><input name="reason" maxlength="1000" required/><button class="muted-btn" data-i18n="Cancel and release stock">Cancel and release stock</button></form>}
@if(order.Status=="Fulfilled"){
<section class="panel"><h2 data-i18n="Fulfillment and returns">Fulfillment and returns</h2>@foreach(var line in order.Lines){var fulfillment=Model.Fulfillments.SingleOrDefault(x=>x.EcommerceOrderLineId==line.Id); var returned=Model.Returns.Where(x=>x.EcommerceOrderLineId==line.Id).Sum(x=>x.Quantity);<p><strong>@line.Title</strong> · <span data-i18n="Returned quantity">Returned quantity</span>: @returned.ToString("N3") / @line.Quantity.ToString("N3") @if(Model.Staff && fulfillment!=null){<a href="/Accounts" data-i18n="Finance documents">Finance documents</a><span> #@fulfillment.FinanceDocumentId</span>}</p>@if(Model.Staff && returned<line.Quantity){<form method="post" action="@route/@order.Id/return">@Html.AntiForgeryToken()<input type="hidden" name="lineId" value="@line.Id"/><input type="hidden" name="requestToken" value="@Guid.NewGuid().ToString("N")"/><label data-i18n="Return quantity">Return quantity</label><input name="quantity" type="number" min="0.001" step="0.001" max="@((line.Quantity-returned).ToString(System.Globalization.CultureInfo.InvariantCulture))" required/><label data-i18n="Return reason">Return reason</label><input name="reason" maxlength="1000" required/><label><input type="checkbox" name="confirmReceived" value="true" required style="width:auto"/><span data-i18n="Returned goods have been received and are suitable for restocking.">Returned goods have been received and are suitable for restocking.</span></label><button class="muted-btn" data-i18n="Record linked return">Record linked return</button></form>}}</section>}
<section class="panel"><h2 data-i18n="Order history">Order history</h2>@foreach(var entry in order.Events.OrderBy(x=>x.Id)){<p><strong data-i18n="@entry.Action">@entry.Action</strong> · @entry.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC<br/>@if(Model.Staff){@entry.Note}else{<span data-i18n="@entry.Note">@entry.Note</span>}</p>}</section>
