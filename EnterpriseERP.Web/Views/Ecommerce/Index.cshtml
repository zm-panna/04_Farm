@model EcommerceBrowsePage
@{ ViewData["Title"] = "Ecommerce"; }
<div class="page-header"><div><span class="eyebrow" data-i18n="Customer storefront">Customer storefront</span><h1 data-i18n="Ecommerce">Ecommerce</h1><p class="subtle" data-i18n="Published branch products. Review configured tax and the full total in your cart before ordering.">Published branch products. Review configured tax and the full total in your cart before ordering.</p></div><div class="actions"><a href="/Ecommerce/cart" class="primary" data-i18n="My cart">My cart</a><a href="/Ecommerce/orders" class="muted-btn" data-i18n="My orders">My orders</a>@if(Model.Staff){<a href="/Ecommerce/staff/orders" class="muted-btn" data-i18n="Order fulfillment">Order fulfillment</a>}<a href="/Ecommerce/manage" class="muted-btn" data-i18n="Manage catalog">Manage catalog</a></div></div>
<p class="notice" data-i18n="Branch collection only. Payments are manually verified outside checkout; no card is charged here.">Branch collection only. Payments are manually verified outside checkout; no card is charged here.</p>
<form method="get" action="/Ecommerce" class="panel"><label data-i18n="Search products">Search products</label><input name="search" value="@Model.Search" maxlength="100"/><label data-i18n="Category">Category</label><input name="category" value="@Model.Category" maxlength="100"/><button class="primary" data-i18n="Search">Search</button><a href="/Ecommerce" data-i18n="Clear filters">Clear filters</a></form>
<section class="panel"><p><span data-i18n="Products">Products</span>: @Model.Total</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Product">Product</th><th data-i18n="Category">Category</th><th data-i18n="Net unit price">Net unit price</th><th data-i18n="Available">Available</th><th data-i18n="Quantity">Quantity</th></tr></thead><tbody>
@foreach(var row in Model.Products){<tr><td><strong>@row.Product.Title</strong><p>@row.Product.Description</p></td><td>@row.Product.Category</td><td>@row.Product.CurrencyCode @Model.Money(row.Product.NetUnitPrice) <small data-i18n="Tax calculated in cart">Tax calculated in cart</small></td><td>@row.Available.ToString("N3") @row.Unit</td><td><form method="post" action="/Ecommerce/cart/line">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@row.Product.Id"/><input type="number" name="quantity" min="0.001" step="0.001" value="1" required aria-label="Quantity" data-i18n-aria-label="Quantity"/><button class="primary" data-i18n="Set cart quantity">Set cart quantity</button></form></td></tr>}
</tbody></table></div>@if(Model.Total==0){<p data-i18n="No published products match your filters.">No published products match your filters.</p>}
<nav aria-label="Catalog pages" data-i18n-aria-label="Catalog pages"><span data-i18n="Page">Page</span> @Model.Page / @Model.Pages @if(Model.Page>1){<a href="@Url.Action("Index",new{page=Model.Page-1,search=Model.Search,category=Model.Category})" data-i18n="Previous">Previous</a>} @if(Model.Page<Model.Pages){<a href="@Url.Action("Index",new{page=Model.Page+1,search=Model.Search,category=Model.Category})" data-i18n="Next">Next</a>}</nav></section>
