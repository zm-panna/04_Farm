@model EcommerceCartPage
@{ViewData["Title"]="My cart"; var cart=Model.Cart;}
<div class="page-header"><h1 data-i18n="My cart">My cart</h1><a href="/Ecommerce" class="muted-btn" data-i18n="Continue shopping">Continue shopping</a></div><p>@Model.CustomerName</p>
@if(cart==null || cart.Lines.Count==0){<section class="panel"><p data-i18n="Your cart is empty.">Your cart is empty.</p></section>}
else{
<section class="panel"><p class="notice" data-i18n="A cart does not reserve stock. Quotes expire after 30 minutes; refresh each quantity if prices or policies change.">A cart does not reserve stock. Quotes expire after 30 minutes; refresh each quantity if prices or policies change.</p><p><span data-i18n="Quote expires UTC">Quote expires UTC</span>: @cart.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Product">Product</th><th data-i18n="Quantity">Quantity</th><th data-i18n="Net amount">Net amount</th><th data-i18n="Tax">Tax</th><th data-i18n="Total">Total</th></tr></thead><tbody>
@foreach(var line in cart.Lines){<tr><td>@line.Title</td><td><form method="post" action="/Ecommerce/cart/line">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@line.EcommerceProductId"/><input type="hidden" name="expectedCartToken" value="@cart.RevisionToken"/><input name="quantity" type="number" min="0" step="0.001" value="@line.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" required aria-label="Quantity" data-i18n-aria-label="Quantity"/><button data-i18n="Update">Update</button><small data-i18n="Set zero to remove">Set zero to remove</small></form></td><td>@line.CurrencyCode @Model.Money(line.NetAmount)</td><td>@Model.Money(line.TaxAmount)</td><td>@Model.Money(line.GrossAmount)</td></tr>}
</tbody></table></div><p><strong><span data-i18n="Order total">Order total</span>: @cart.Lines.First().CurrencyCode @Model.Money(cart.Lines.Sum(x=>x.GrossAmount))</strong></p></section>
<form method="post" action="/Ecommerce/checkout" class="panel">@Html.AntiForgeryToken()<input type="hidden" name="checkoutToken" value="@cart.RevisionToken"/><h2 data-i18n="Confirm order">Confirm order</h2><p data-i18n="Collect from the selected branch after staff approval. There is no delivery charge. Payment stays pending and unverified; this checkout does not charge you. You can cancel before fulfillment. Staff must review returned goods before recording any return or refund.">Collect from the selected branch after staff approval. There is no delivery charge. Payment stays pending and unverified; this checkout does not charge you. You can cancel before fulfillment. Staff must review returned goods before recording any return or refund.</p><label><input name="confirmOrder" type="checkbox" value="true" required style="width:auto"/><span data-i18n="I confirm these products, quantities, configured tax, total and branch collection terms.">I confirm these products, quantities, configured tax, total and branch collection terms.</span></label><button class="primary" data-i18n="Place order and reserve stock">Place order and reserve stock</button></form>
}
