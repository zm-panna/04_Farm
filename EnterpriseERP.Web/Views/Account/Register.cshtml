@model EnterpriseERP.Web.Controllers.RegisterInput
@{ ViewData["Title"] = "Sign up"; }
<div class="form-card">
<h1>Sign up</h1>
<form method="post" asp-action="Register">
 @Html.AntiForgeryToken()
 <div asp-validation-summary="All" role="alert"></div>
 <label asp-for="Email"></label><input asp-for="Email" autocomplete="username" required />
 <label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" required />
 <p>Use at least 12 characters, including uppercase, lowercase, a number and a symbol.</p>
 <label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" autocomplete="new-password" required />
 <button type="submit">Sign up</button>
</form>
<p>Already registered? <a asp-action="Login">Sign in</a></p>
</div>
