@model EnterpriseERP.Web.Controllers.ChangePasswordInput
@{ ViewData["Title"] = "Change password"; }
<h1 data-i18n="Change password">Change password</h1>
@if (TempData["Success"] is string message) { <p role="status">@message</p> }
<p data-i18n="Choose a unique password of at least 12 characters. Your other sessions will be invalidated when their security stamp is next checked.">Choose a unique password of at least 12 characters. Your other sessions will be invalidated when their security stamp is next checked.</p>
<form asp-action="ChangePassword" method="post">
 @Html.AntiForgeryToken()
 <div asp-validation-summary="All" role="alert"></div>
 <label asp-for="CurrentPassword" data-i18n="Current password">Current password</label><input asp-for="CurrentPassword" autocomplete="current-password" />
 <label asp-for="NewPassword" data-i18n="New password">New password</label><input asp-for="NewPassword" autocomplete="new-password" />
 <label asp-for="ConfirmPassword" data-i18n="Confirm new password">Confirm new password</label><input asp-for="ConfirmPassword" autocomplete="new-password" />
 <label for="AuthenticatorCode" data-i18n="Authenticator code (required when MFA is enabled)">Authenticator code (required when MFA is enabled)</label><input id="AuthenticatorCode" name="AuthenticatorCode" inputmode="numeric" maxlength="32" autocomplete="one-time-code" />
 <button type="submit" data-i18n="Change password">Change password</button>
</form>

<p><a href="/Account/Security" data-i18n="Authenticator and recovery settings">Authenticator and recovery settings</a></p>
