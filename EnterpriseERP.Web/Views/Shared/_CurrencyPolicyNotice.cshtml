@model EnterpriseERP.Web.Controllers.OperationsWorkspaceModel
@if(Model.CurrencyCode is not null){<div class="notice"><span data-i18n="Locked company currency">Locked company currency</span>: <bdi>@Model.CurrencyCode</bdi> · <span data-i18n="Payment increment">Payment increment</span>: <bdi>@Model.MoneyStep</bdi>. <span data-i18n="New document totals and cash amounts must match the approved currency precision. Unit prices and internal carrying costs may retain three decimals. Historical fractional values remain visible and require a reviewed correction before settlement.">New document totals and cash amounts must match the approved currency precision. Unit prices and internal carrying costs may retain three decimals. Historical fractional values remain visible and require a reviewed correction before settlement.</span></div>}
else{<div class="notice"><span data-i18n="Company currency is unconfigured. Amounts retain the legacy three-decimal accounting contract until independently reviewed; no currency label or conversion is assumed.">Company currency is unconfigured. Amounts retain the legacy three-decimal accounting contract until independently reviewed; no currency label or conversion is assumed.</span></div>}
