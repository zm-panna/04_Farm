@inject EnterpriseERP.Web.PermissionService NavigationPermissions
@{ bool isSignedIn = User.Identity?.IsAuthenticated == true; bool canManageStaff = false; if (User.Identity?.IsAuthenticated == true) { try { await NavigationPermissions.Demand("Permissions.Manage"); canManageStaff = true; } catch (UnauthorizedAccessException) { } } }
<!doctype html>
<html lang="en" dir="ltr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] | Smart Farm AI ERP</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/vendor/datatables/dataTables.min.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/farm-server-tables.css" asp-append-version="true"/></head>
<body><a class="skip-link" href="#main" data-i18n="Skip to main content">Skip to main content</a><span id="language-announcement" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></span><div class="app-shell @(isSignedIn ? "" : "guest-shell")" id="shell">@if(isSignedIn){<aside class="side" aria-label="ERP navigation" data-i18n-aria-label="ERP navigation"><a class="brand" href="/"><span class="brand-mark">✳</span><span><strong>FarmSphere</strong><small>SMART FARM AI ERP</small></span></a><div class="nav-label"><span data-i18n="Workspace">Workspace</span></div><nav>
<a href="/" class="@(Context.Request.Path == "/" ? "active" : "")"><span class="nav-icon">▦</span><span data-i18n="Overview">Overview</span></a><a href="/Context"><span class="nav-icon">⌘</span><span data-i18n="Company &amp; Branch">Company &amp; Branch</span></a><a href="/animals"><span class="nav-icon">♧</span><span data-i18n="Livestock">Livestock</span></a><a href="/milk-entry"><span class="nav-icon">◉</span><span data-i18n="Dairy Management">Dairy Management</span></a><a href="/Fattening"><span class="nav-icon">◈</span><span data-i18n="Fattening">Fattening</span></a><a href="/animal-health"><span class="nav-icon">♡</span><span data-i18n="Animal Health">Animal Health</span></a><a href="/FeedManagement"><span class="nav-icon">▤</span><span data-i18n="Feed Management">Feed Management</span></a>
<a href="/breeding"><span class="nav-icon">♧</span><span data-i18n="Breeding">Breeding</span></a><a href="/Expenses"><span class="nav-icon">▧</span><span data-i18n="Farm expenses">Farm expenses</span></a></nav><div class="nav-label" data-i18n="Business &amp; Finance">Business &amp; Finance</div><nav><a href="/products"><span class="nav-icon">◧</span><span data-i18n="Product Master">Product Master</span></a><a href="/Inventory"><span class="nav-icon">▥</span><span data-i18n="Inventory">Inventory</span></a><a href="/stock-transfers"><span class="nav-icon">⇄</span><span data-i18n="Stock transfers">Stock transfers</span></a><a href="/Parties"><span class="nav-icon">♙</span><span data-i18n="Suppliers &amp; Customers">Suppliers &amp; Customers</span></a><a href="/Purchase"><span class="nav-icon">⬇</span><span data-i18n="Purchase">Purchase</span></a><a href="/Sales"><span class="nav-icon">⬈</span><span data-i18n="Sales">Sales</span></a><a href="/Accounts"><span class="nav-icon">▧</span><span data-i18n="Accounts">Accounts</span></a><a href="/Reports"><span class="nav-icon">◫</span><span data-i18n="Reports">Reports</span></a></nav><div class="nav-label"><span data-i18n="Management">Management</span></div><nav><a href="/support/tickets"><span class="nav-icon">☏</span><span data-i18n="Customer Care">Customer Care</span></a><a href="/Subscription"><span class="nav-icon">◷</span><span data-i18n="Subscription">Subscription</span></a><a href="/Automation"><span class="nav-icon">⚡</span><span data-i18n="AI Automation">AI Automation</span></a>@if(canManageStaff){<a href="/Administration"><span class="nav-icon">♙</span><span data-i18n="Administration">Administration</span></a><a href="/admin/permissions"><span class="nav-icon">♙</span><span data-i18n="Permissions">Permissions</span></a>}</nav><div class="nav-label" data-i18n="Enterprise modules">Enterprise modules</div><nav>
@foreach(var link in new[]{("HR.View","/HRPayroll","HR and payroll"),("Employee.Self","/HRPayroll/me","My employee portal"),("Payroll.View","/HRPayroll/register","Payroll register"),("CRM.View","/crm","CRM"),("FixedAssets.View","/fixed-assets","Fixed assets"),("Ecommerce.View","/ecommerce","E-commerce"),("Ecommerce.Fulfill","/ecommerce/staff/orders","Customer orders"),("BusinessPolicy.View","/business-policy","Business policy"),("AI.Read","/AIManager","AI Manager"),("Messaging.View","/Messaging","Internal messages"),("Scanning.Use","/scan","Scan workspace")})
{ bool allowed=false;try{await NavigationPermissions.Demand(link.Item1);allowed=true;}catch(UnauthorizedAccessException){}if(allowed){<a href="@link.Item2"><span class="nav-icon">◈</span><span data-i18n="@link.Item3">@link.Item3</span></a>} }
<a href="/data"><span class="nav-icon">▤</span><span data-i18n="Server data browser">Server data browser</span></a></nav><div class="side-foot"><strong data-i18n="Selected farm workspace">Selected farm workspace</strong><div data-i18n="Company, branch and permissions are verified server-side.">Company, branch and permissions are verified server-side.</div></div></aside>}
<div class="main-shell"><header class="topbar"><div style="display:flex;align-items:center;gap:12px">@if(isSignedIn){<button class="menu-toggle" id="nav-toggle" type="button" aria-label="Toggle navigation" data-i18n-aria-label="Toggle navigation" aria-expanded="false">☰</button>}<span class="breadcrumb"><span data-i18n="Farm Operations">Farm Operations</span> &nbsp; / &nbsp; <span data-i18n="@(ViewData["Title"])">@ViewData["Title"]</span></span></div><div class="top-actions"><label class="lang-wrap" for="erp-language"><span data-i18n="Language">Language</span><select id="erp-language" aria-label="ERP language" data-i18n-aria-label="ERP language"><option value="en">English</option><option value="bn">বাংলা</option><option value="banglish">Banglish</option><option value="ar" lang="ar">العربية</option></select></label>@if(isSignedIn){<a class="pill-link" href="/Context">⌘ &nbsp; <span data-i18n="Switch Company / Branch">Switch Company / Branch</span></a><a href="/Account/ChangePassword" data-i18n="Password">Password</a><a href="/Account/Security" data-i18n="Account security">Account security</a><span class="avatar" aria-hidden="true">🌱</span><form method="post" action="/Account/Logout">@Html.AntiForgeryToken()<button class="logout" type="submit"><span data-i18n="Sign out">Sign out</span></button></form>}else{<a href="/Account/Register">Sign up</a><a href="/Account/Login">Sign in</a>}</div></header><main id="main" tabindex="-1">@if(TempData["Success"] is string success){<div class="notice" role="status">@success</div>}@if(TempData["Error"] is string error){<div class="notice" role="alert">@error</div>}@if(isSignedIn){@await Component.InvokeAsync("ServerGrids", new { path = Context.Request.Path.Value ?? "" })}@RenderBody()</main></div></div>
<script src="~/js/navigation-menu.js" asp-append-version="true"></script><script src="~/js/farm-core-translations.js" asp-append-version="true"></script><script src="~/js/farm-i18n.js" asp-append-version="true"></script><script src="~/js/stock-transfer-language.js" asp-append-version="true"></script><script src="~/vendor/datatables/dataTables.min.js" asp-append-version="true"></script><script src="~/js/farm-server-tables.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>