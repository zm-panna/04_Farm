@model EnterpriseERP.Web.BreedingPage
@{ ViewData["Title"] = "Breeding"; var today = Model.Today; }
<div class="page-header"><div><span class="eyebrow" data-business-i18n="Reproductive history">Reproductive history</span><h1 data-business-i18n="Breeding &amp; Calving">Breeding &amp; Calving</h1><p class="subtle" data-i18n="Record service, track expected dates and keep a permanent outcome history.">Record service, track expected dates and keep a permanent outcome history.</p></div><a class="muted-btn" href="/animal-health" data-business-i18n="Animal health">Animal health</a></div>
<div asp-validation-summary="All" class="notice" role="alert"></div>
<p class="notice" data-i18n="Select a breeding-eligible animal. Sex, maturity and veterinary eligibility are not inferred by this register. The initial expected date is only a cattle planning default; enter the date advised for the animal. A calving outcome records history; register the calf separately in Livestock.">Select a breeding-eligible animal. Sex, maturity and veterinary eligibility are not inferred by this register. The initial expected date is only a cattle planning default; enter the date advised for the animal. A calving outcome records history; register the calf separately in Livestock.</p>
<div class="kpi-grid"><div class="kpi"><span class="kpi-head" data-business-i18n="Open cycles">Open cycles</span><strong>@Model.Cycles.Count(x => !x.IsClosed)</strong></div><div class="kpi"><span class="kpi-head" data-business-i18n="Confirmed pregnant">Confirmed pregnant</span><strong>@Model.Cycles.Count(x => x.Status == "Pregnant")</strong></div><div class="kpi"><span class="kpi-head" data-business-i18n="Expected within 30 days">Expected within 30 days</span><strong>@Model.Cycles.Count(x => !x.IsClosed && x.ExpectedCalvingDate >= today && x.ExpectedCalvingDate <= today.AddDays(30))</strong></div><div class="kpi"><span class="kpi-head" data-business-i18n="Expected date passed">Expected date passed</span><strong>@Model.Cycles.Count(x => !x.IsClosed && x.ExpectedCalvingDate < today)</strong></div></div>
<div class="panels"><section class="panel"><h2 data-business-i18n="Record a breeding service">Record a breeding service</h2><form method="post" action="/breeding/record">@Html.AntiForgeryToken()
<label asp-for="Breeding.AnimalId" data-business-i18n="Animal">Animal</label><select asp-for="Breeding.AnimalId" required><option value="" data-business-i18n="Select animal">Select animal</option>@foreach (var a in Model.Animals.Where(x => Model.Cycles.All(c => c.AnimalId != x.Id || c.IsClosed))) { <option value="@a.Id">@a.Tag (@a.Breed)</option> }</select>
<label asp-for="Breeding.Reference" data-business-i18n="Unique service reference">Unique service reference</label><input asp-for="Breeding.Reference" maxlength="85" required />
<label asp-for="Breeding.ServiceDate" data-business-i18n="Service date">Service date</label><input asp-for="Breeding.ServiceDate" type="date" required />
<label asp-for="Breeding.ExpectedCalvingDate" data-business-i18n="Expected calving date">Expected calving date</label><input asp-for="Breeding.ExpectedCalvingDate" type="date" required />
<label asp-for="Breeding.Method" data-business-i18n="Method">Method</label><select asp-for="Breeding.Method"><option value="Natural" data-business-i18n="Natural service">Natural service</option><option value="ArtificialInsemination" data-business-i18n="Artificial insemination">Artificial insemination</option></select>
<label asp-for="Breeding.SireOrSemen" data-business-i18n="Sire / semen batch identifier">Sire / semen batch identifier</label><input asp-for="Breeding.SireOrSemen" maxlength="120" required />
<button type="submit" class="primary" data-business-i18n="Record service">Record service</button></form></section>
<section class="panel"><h2 data-business-i18n="Record a cycle outcome">Record a cycle outcome</h2><p class="subtle" data-i18n="A pregnancy check keeps the cycle open. Not pregnant, calved and aborted close it. Closed cycles remain in the history.">A pregnancy check keeps the cycle open. Not pregnant, calved and aborted close it. Closed cycles remain in the history.</p><form method="post" action="/breeding/outcome">@Html.AntiForgeryToken()
<label asp-for="OutcomeEntry.CycleId" data-business-i18n="Open cycle">Open cycle</label><select asp-for="OutcomeEntry.CycleId" required><option value="" data-business-i18n="Select cycle">Select cycle</option>@foreach (var c in Model.Cycles.Where(x => !x.IsClosed)) { <option value="@c.Id" data-i18n-template="breeding-cycle" data-i18n-values="@System.Text.Json.JsonSerializer.Serialize(new { tag = Model.AnimalTags.GetValueOrDefault(c.AnimalId) ?? "", reference = c.Reference, status = c.Status })">@Model.AnimalTags.GetValueOrDefault(c.AnimalId) · @c.Reference (@c.Status)</option> }</select>
<label asp-for="OutcomeEntry.Reference" data-business-i18n="Unique outcome reference">Unique outcome reference</label><input asp-for="OutcomeEntry.Reference" maxlength="85" required />
<label asp-for="OutcomeEntry.EventDate" data-business-i18n="Event date">Event date</label><input asp-for="OutcomeEntry.EventDate" type="date" required />
<label asp-for="OutcomeEntry.Outcome" data-business-i18n="Outcome">Outcome</label><select asp-for="OutcomeEntry.Outcome"><option value="Pregnant" data-business-i18n="Pregnancy confirmed">Pregnancy confirmed</option><option value="NotPregnant" data-business-i18n="Not pregnant (after service)">Not pregnant (after service)</option><option value="Calved" data-business-i18n="Calved">Calved</option><option value="Aborted" data-business-i18n="Aborted">Aborted</option></select>
<label asp-for="OutcomeEntry.Notes" data-business-i18n="Outcome / vet / calf details">Outcome / vet / calf details</label><textarea asp-for="OutcomeEntry.Notes" maxlength="2000" rows="4" required></textarea>
<button type="submit" class="primary" data-business-i18n="Save outcome">Save outcome</button></form></section></div>
<section class="panel"><h2 data-business-i18n="Cycle register and history">Cycle register and history</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-business-i18n="Animal / reference">Animal / reference</th><th data-business-i18n="Service / sire">Service / sire</th><th data-business-i18n="Expected calving">Expected calving</th><th data-business-i18n="Status">Status</th><th data-business-i18n="History">History</th></tr></thead><tbody>
@foreach (var c in Model.Cycles) { <tr><td><strong>@Model.AnimalTags.GetValueOrDefault(c.AnimalId, c.AnimalId.ToString())</strong><br/>@c.Reference</td><td>@c.ServiceDate.ToString("yyyy-MM-dd")<br/><span data-i18n="@c.Method">@c.Method</span><br/>@c.SireOrSemen</td><td>@c.ExpectedCalvingDate.ToString("yyyy-MM-dd") @if (!c.IsClosed && c.ExpectedCalvingDate < today) { <span class="status warn" data-i18n="Review due date">Review due date</span> }</td><td><span class="status" data-i18n="@c.Status">@c.Status</span><br/><span data-i18n="@(c.IsClosed ? "Closed" : "Open")">@(c.IsClosed ? "Closed" : "Open")</span></td><td>@foreach (var e in c.Events.OrderBy(x => x.EventDate).ThenBy(x => x.Id)) { <details><summary>@e.EventDate.ToString("yyyy-MM-dd") · <span data-i18n="@e.Outcome">@e.Outcome</span></summary><p>@e.Reference<br/>@e.Notes</p></details> }@if(c.Events.Count == 0) { <span data-i18n="No outcomes yet">No outcomes yet</span> }</td></tr> }
@if (Model.Cycles.Count == 0) { <tr><td colspan="5"><span data-i18n="No breeding cycles recorded.">No breeding cycles recorded.</span></td></tr> }
</tbody></table></div></section>


