@model EnterpriseERP.Web.Controllers.EnterpriseAiPage
@{ ViewData["Title"]="AI Manager"; }
<section class="page-head"><div><p class="eyebrow" data-i18n="Review workspace">Review workspace</p><h1 data-i18n="AI Manager">AI Manager</h1><p data-i18n="Permission-scoped facts and review drafts">Permission-scoped facts and review drafts</p></div></section>
<div class="notice" data-i18n="Review drafts use live branch facts and fixed checklists. They do not approve, post, pay, send messages or change records.">Review drafts use live branch facts and fixed checklists. They do not approve, post, pay, send messages or change records.</div>
<section class="panel"><form method="post" action="/AIManager/draft" class="form-grid">@Html.AntiForgeryToken()<label><span data-i18n="Module">Module</span><select name="module" required>@foreach(var module in Model.AllowedModules){<option value="@module" data-i18n="@module">@module</option>}</select></label><button class="btn" type="submit" data-i18n="Prepare review draft">Prepare review draft</button></form>
@if(Model.AllowedModules.Count==0){<p data-i18n="No business-module read permission is available for this account.">No business-module read permission is available for this account.</p>}
</section>
@if(Model.Draft is not null){<section class="panel"><h2 data-i18n="Review draft">Review draft</h2><p data-i18n="@Model.Draft.Mode">@Model.Draft.Mode</p><p>@Model.Draft.Snapshot.GeneratedUtc.ToString("u") · <span data-i18n="Branch">Branch</span> @Model.Draft.Snapshot.BranchId · @Model.Draft.Snapshot.CurrencyCode</p><ul>@foreach(var fact in Model.Draft.Snapshot.Facts){<li><span data-i18n="@fact.Label">@fact.Label</span>: <bdi>@fact.Count</bdi></li>}</ul><p data-i18n="@Model.Draft.Checklist">@Model.Draft.Checklist</p>
@if(Model.Draft.Snapshot.PolicyVersion.HasValue){<p><span data-i18n="Reviewed company policy version">Reviewed company policy version</span> <bdi>@Model.Draft.Snapshot.PolicyVersion</bdi>. <span data-i18n="Statutory compliance requires separate business acceptance.">Statutory compliance requires separate business acceptance.</span></p>}else{<p data-i18n="Unreviewed or unavailable; no jurisdiction or currency has been assumed.">Unreviewed or unavailable; no jurisdiction or currency has been assumed.</p>}<p><a class="btn" href="@Model.Draft.ReviewRoute" data-i18n="Open authorized workflow">Open authorized workflow</a></p><p data-i18n="Review the original records before taking any action. Required permissions and independent approvals still apply.">Review the original records before taking any action. Required permissions and independent approvals still apply.</p></section>}
