@model EnterpriseERP.Web.Controllers.OperationsWorkspaceModel
@{ViewData["Title"]="Inventory";}
<div class="page-header"><div><span class="eyebrow" data-i18n="Stock control">Stock control</span><h1 data-i18n="Inventory">Inventory</h1><p class="subtle" data-i18n="Physical quantities and exact inventory carrying values for your active branch.">Physical quantities and exact inventory carrying values for your active branch.</p></div><div><a class="muted-btn" href="/stock-ledger" data-i18n="Movement history">Movement history</a> <a class="primary" href="/Purchase" data-i18n="Receive stock">Receive stock</a></div></div>
@if(TempData["Error"] is string error){<div class="notice" role="alert">@error</div>}
@if(TempData["Success"] is string success){<div class="notice" role="status">@success</div>}
<partial name="_BoundedRegisterPager" model="@(new EnterpriseERP.Web.Controllers.BoundedRegisterPager("/Inventory", Model.StockPage))" />
<section class="panel"><h2 data-i18n="Stock balances">Stock balances</h2><p class="subtle" data-i18n="Average unit cost is rounded for display. Journals use the exact carrying value, including the remaining balance on final depletion.">Average unit cost is rounded for display. Journals use the exact carrying value, including the remaining balance on final depletion.</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="SKU">SKU</th><th data-i18n="Product">Product</th><th data-i18n="Quantity">Quantity</th><th data-i18n="Average unit cost">Average unit cost</th><th data-i18n="Exact carrying value">Exact carrying value</th></tr></thead><tbody>@foreach(var item in Model.Stock){var balance=Model.InventoryBalances.SingleOrDefault(x=>x.StockItemId==item.Id);<tr><td>@item.SKU</td><td><a href="/stock-ledger?productId=@item.Id">@item.Name</a></td><td>@item.QuantityOnHand.ToString("N3")</td><td>@item.UnitCost.ToString("N3")</td><td>@(balance!=null?balance.Value.ToString("N3"):item.QuantityOnHand==0?"0.000":"Opening valuation review required")</td></tr>}</tbody></table></div>@if(Model.Stock.Count==0){<p class="empty"><a href="/products" data-i18n="Create a product to begin.">Create a product to begin.</a></p>}</section>
<section class="panel"><h2 data-i18n="Low-stock purchase suggestions">Low-stock purchase suggestions</h2><p class="subtle" data-i18n="Default reorder point 5 and target 10 apply until configured. Suggestions subtract approved open orders; drafts are not committed supply.">Default reorder point 5 and target 10 apply until configured. Suggestions subtract approved open orders; drafts are not committed supply.</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Item">Item</th><th data-i18n="On hand">On hand</th><th data-i18n="Reorder / target">Reorder / target</th><th data-i18n="Open ordered">Open ordered</th><th data-i18n="Suggested">Suggested</th><th data-i18n="Next step">Next step</th></tr></thead><tbody>@foreach(var item in Model.Stock){var policy=Model.ReorderPolicies.FirstOrDefault(x=>x.StockItemId==item.Id);var point=policy?.ReorderPoint??5;var target=policy?.TargetQuantity??10;var ordered=Model.OpenOrdered.GetValueOrDefault(item.Id);var suggested=Math.Max(0,target-item.QuantityOnHand-ordered);if(item.QuantityOnHand<=point){<tr><td>@item.SKU</td><td>@item.QuantityOnHand.ToString("N3")</td><td>@point.ToString("N3") / @target.ToString("N3")</td><td>@ordered.ToString("N3")</td><td>@suggested.ToString("N3")</td><td>@if(suggested>0){<a href="/Purchase?itemId=@item.Id"><span data-i18n="Create purchase order">Create purchase order</span></a>}else{<span data-i18n="Covered by open orders">Covered by open orders</span>}</td></tr>}}</tbody></table></div></section>
<section class="panel"><h2 data-i18n="Reorder policy">Reorder policy</h2><form method="post" action="/Inventory/reorder-policy">@Html.AntiForgeryToken()<label for="reorder-item" data-i18n="Stock item">Stock item</label><select id="reorder-item" name="itemId" required><option value="" data-i18n="Choose an item">Choose an item</option>@foreach(var item in Model.Stock){<option value="@item.Id">@item.SKU — @item.Name</option>}</select><label for="reorder-point" data-i18n="Reorder point">Reorder point</label><input id="reorder-point" name="reorderPoint" type="number" min="0" step="0.001" required/><label for="target-qty" data-i18n="Target quantity">Target quantity</label><input id="target-qty" name="targetQuantity" type="number" min="0" step="0.001" required/><button class="primary" type="submit" data-i18n="Save reorder policy">Save reorder policy</button></form></section>
<section class="panel"><h2 data-i18n="Stock adjustment">Stock adjustment</h2><p class="subtle" data-i18n="Enter a positive quantity for found/opening stock or a negative quantity for loss. Additions use the item&#x27;s current unit cost and credit opening/adjustment equity 3900; losses debit expense 6100. Use Purchase and Sales for trading transactions. Previously imported nonzero stock requires an approved opening valuation.">Enter a positive quantity for found/opening stock or a negative quantity for loss. Additions use the item's current unit cost and credit opening/adjustment equity 3900; losses debit expense 6100. Use Purchase and Sales for trading transactions. Previously imported nonzero stock requires an approved opening valuation.</p><form method="post" action="/Inventory/adjust">@Html.AntiForgeryToken()<label for="adjust-item" data-i18n="Stock item">Stock item</label><select id="adjust-item" name="itemId" required><option value="" data-i18n="Choose an item">Choose an item</option>@foreach(var item in Model.Stock){<option value="@item.Id">@item.SKU — @item.Name</option>}</select><label for="adjust-qty" data-i18n="Signed quantity change">Signed quantity change</label><input id="adjust-qty" name="delta" type="number" step="0.001" required/><label for="adjust-ref" data-i18n="Unique adjustment reference">Unique adjustment reference</label><input id="adjust-ref" name="reference" maxlength="80" required/><button class="primary" type="submit" data-i18n="Adjust stock &amp; post journal">Adjust stock &amp; post journal</button></form></section>
