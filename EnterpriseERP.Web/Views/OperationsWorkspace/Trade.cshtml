@model EnterpriseERP.Web.Controllers.OperationsWorkspaceModel
@{ var purchase=Model.Kind=="Purchase"; var path=purchase?"/Purchase":"/Sales"; ViewData["Title"]=purchase?"Purchase":"Sales"; }
@await Html.PartialAsync("~/Views/Shared/_CurrencyPolicyNotice.cshtml",Model)
<div class="page-header"><div><span class="eyebrow" data-i18n="Linked operational documents">Linked operational documents</span><h1 data-i18n="@(ViewData["Title"])">@ViewData["Title"]</h1><p class="subtle" data-i18n="Post stock transactions, return items and follow document balances.">Post stock transactions, return items and follow document balances.</p></div><a class="muted-btn" href="/Accounts" data-i18n="Payments &amp; accounts">Payments &amp; accounts</a></div>
@if(TempData["Error"] is string error){<div class="notice" role="alert">@error</div>}
@if(TempData["Success"] is string success){<div class="notice" role="status">@success</div>}
@if(purchase){
<section class="panel"><h2 data-i18n="Create a single-line purchase order">Create a single-line purchase order</h2><p class="subtle" data-i18n="Draft → approval → partial/full receipt. Approval is internal and does not send an order to the supplier. Stock and payable are posted only when goods are received.">Draft → approval → partial/full receipt. Approval is internal and does not send an order to the supplier. Stock and payable are posted only when goods are received.</p><form method="post" action="/Purchase/order">@Html.AntiForgeryToken()<label for="po-supplier" data-i18n="Supplier">Supplier</label><select id="po-supplier" name="supplierId" required><option value="" data-i18n="Choose an active supplier">Choose an active supplier</option>@foreach(var p in Model.Parties.Where(x=>x.Active)){<option value="@p.Id">@p.Code — @p.Name</option>}</select><label for="po-item" data-i18n="Stock item">Stock item</label><select id="po-item" name="ItemId" required><option value="" data-i18n="Choose an item">Choose an item</option>@foreach(var item in Model.Stock){<option value="@item.Id" selected="@(item.Id==Model.SelectedStockItemId?"selected":null)">@item.SKU — @item.Name</option>}</select><label for="po-qty" data-i18n="Order quantity">Order quantity</label><input id="po-qty" name="Quantity" type="number" min="0.001" step="0.001" value="@Model.SuggestedQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" required/><label for="po-price" data-i18n="Agreed unit price">Agreed unit price</label><input id="po-price" name="Price" type="number" min="0.001" step="0.001" required/><label for="po-reference" data-i18n="Unique order reference">Unique order reference</label><input id="po-reference" name="Reference" maxlength="80" required/><button class="primary" type="submit" data-i18n="Create draft order">Create draft order</button></form><p><a href="/Inventory" data-i18n="Low-stock suggestions">Low-stock suggestions</a> · <a href="/Parties" data-i18n="Add supplier">Add supplier</a></p></section>
<section class="panel"><h2 data-i18n="Purchase orders">Purchase orders</h2>
@await Html.PartialAsync("~/Views/OperationsWorkspace/_WorkspaceBrowse.cshtml", new EnterpriseERP.Web.Controllers.WorkspaceBrowseModel(Model, EnterpriseERP.Web.Controllers.WorkspaceBrowseKind.Orders))
<div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Reference / supplier">Reference / supplier</th><th data-i18n="Item">Item</th><th data-i18n="Ordered / received">Ordered / received</th><th data-i18n="Price / order total">Price / order total</th><th data-i18n="Status">Status</th><th data-i18n="Action">Action</th></tr></thead><tbody>@foreach(var order in Model.Orders){<tr><td>@order.Reference<br/>@Model.Parties.FirstOrDefault(x=>x.Id==order.SupplierId)?.Name</td><td>@Model.Stock.FirstOrDefault(x=>x.Id==order.StockItemId)?.SKU</td><td>@order.Quantity.ToString("N3") / @order.ReceivedQuantity.ToString("N3")</td><td>@order.UnitPrice.ToString("N3") / @order.Amount.ToString("N3")</td><td data-i18n-enum="order" data-i18n-value="@order.Status">@order.Status</td><td>@if(order.Status=="Draft"){<form method="post" action="/Purchase/order/approve">@Html.AntiForgeryToken()<input type="hidden" name="orderId" value="@order.Id"/><button class="primary" type="submit" data-i18n="Approve">Approve</button></form>}@if(order.Status is "Approved" or "PartiallyReceived"){<form method="post" action="/Purchase/order/receive">@Html.AntiForgeryToken()<input type="hidden" name="orderId" value="@order.Id"/><label><span data-i18n="Receipt quantity">Receipt quantity</span><input name="quantity" type="number" min="0.001" max="@((order.Quantity-order.ReceivedQuantity).ToString(System.Globalization.CultureInfo.InvariantCulture))" step="0.001" required/></label><label><span data-i18n="Unique receipt reference">Unique receipt reference</span><input name="reference" maxlength="80" required/></label><button class="primary" type="submit" data-i18n="Receive &amp; post">Receive &amp; post</button></form>}@if(order.Status is not ("Received" or "Cancelled")){<form method="post" action="/Purchase/order/cancel">@Html.AntiForgeryToken()<input type="hidden" name="orderId" value="@order.Id"/><button class="muted-btn" type="submit" data-i18n="Cancel unreceived balance">Cancel unreceived balance</button></form>}</td></tr>}</tbody></table></div></section>
<section class="panel"><h2 data-i18n="Order receipt links">Order receipt links</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Order">Order</th><th data-i18n="Receipt ID">Receipt ID</th><th data-i18n="Quantity">Quantity</th><th data-i18n="Posted amount">Posted amount</th></tr></thead><tbody>@foreach(var r in Model.OrderReceipts){<tr><td>@Model.Orders.First(x=>x.Id==r.PurchaseOrderId).Reference</td><td>@r.PurchaseReceiptId</td><td>@r.Quantity.ToString("N3")</td><td>@r.Amount.ToString("N3")</td></tr>}</tbody></table></div></section>
}
<div class="panels"><section class="panel"><h2 data-i18n="@(purchase?"Immediate purchase receipt":"Post a product sale")">@(purchase?"Immediate purchase receipt":"Post a product sale")</h2><p class="subtle" data-i18n="All quantities and amounts accept up to 3 decimal places. Entries use your active company and branch.">All quantities and amounts accept up to 3 decimal places. Entries use your active company and branch.</p>
@if(Model.Stock.Count==0){<p class="empty"><a href="/products" data-i18n="Create a stock item first.">Create a stock item first.</a></p>}else{
<form method="post" action="@path/post">@Html.AntiForgeryToken()
<label for="trade-party" data-i18n="@(purchase?"Supplier":"Customer")">@(purchase?"Supplier":"Customer")</label><select id="trade-party" name="PartyId"><option value="" data-i18n="Unassigned (settlement still required)">Unassigned (settlement still required)</option>@foreach(var p in Model.Parties.Where(x=>x.Active)){<option value="@p.Id">@p.Code — @p.Name</option>}</select><p class="subtle"><a href="/Parties" data-i18n="Manage suppliers &amp; customers">Manage suppliers &amp; customers</a></p>
<label for="stock" data-i18n="Stock item">Stock item</label><select id="stock" name="ItemId" required><option value="" data-i18n="Choose an item">Choose an item</option>@foreach(var item in Model.Stock){<option value="@item.Id" data-i18n-template="stock-availability" data-i18n-values="@System.Text.Json.JsonSerializer.Serialize(new { sku = item.SKU, name = item.Name, quantity = item.QuantityOnHand.ToString("N3") })">@item.SKU — @item.Name (available @item.QuantityOnHand.ToString("N3"))</option>}</select>
<label for="qty" data-i18n="Quantity">Quantity</label><input id="qty" name="Quantity" type="number" min="0.001" step="0.001" required/>
<label for="price" data-i18n="@(purchase?"Unit purchase price":"Unit sale price")">Unit @(purchase?"purchase":"sale") price</label><input id="price" name="Price" type="number" min="0.001" step="0.001" required/>
<label for="reference" data-i18n="Unique reference">Unique reference</label><input id="reference" name="Reference" maxlength="80" required/>
<button class="primary" type="submit" data-i18n="@(purchase?"Receive & post payable":"Sell & post receivable")">@(purchase?"Receive & post payable":"Sell & post receivable")</button></form>}
</section><section class="panel"><h2 data-i18n="Return stock">Return stock</h2><p class="subtle" data-i18n="Returns reverse the original document amount. A paid document can create a refund due in Accounts.">Returns reverse the original document amount. A paid document can create a refund due in Accounts.</p>
<p class="subtle" data-i18n="Search or change the documents page to choose an older document.">Search or change the documents page to choose an older document.</p>
@await Html.PartialAsync("~/Views/OperationsWorkspace/_WorkspaceBrowse.cshtml", new EnterpriseERP.Web.Controllers.WorkspaceBrowseModel(Model, EnterpriseERP.Web.Controllers.WorkspaceBrowseKind.Documents))
<form method="post" action="@path/return">@Html.AntiForgeryToken()<label for="return-doc" data-i18n="Original document">Original document</label><select id="return-doc" name="documentId" required><option value="" data-i18n="Choose a document">Choose a document</option>@foreach(var doc in Model.Documents.Where(x=>x.Kind==Model.Kind)){<option value="@doc.Id" data-i18n-template="original-document" data-i18n-values="@System.Text.Json.JsonSerializer.Serialize(new { reference = doc.Reference, amount = Model.Money(doc.Amount) })">@doc.Reference — original @Model.Money(doc.Amount)</option>}</select>
<label for="return-qty" data-i18n="Quantity to return">Quantity to return</label><input id="return-qty" name="quantity" type="number" min="0.001" step="0.001" required/>
<label for="return-ref" data-i18n="Unique return reference">Unique return reference</label><input id="return-ref" name="reference" maxlength="80" required/><button class="primary" type="submit" data-i18n="Post return">Post return</button></form>
</section></div>
@if(!purchase&&Model.CanSellAnimals){<section class="panel"><h2 data-i18n="Sell livestock">Sell livestock</h2><p class="subtle" data-i18n="Posts sale revenue, removes the animal&#x27;s acquisition cost and creates a collectible receivable.">Posts sale revenue, removes the animal's acquisition cost and creates a collectible receivable.</p><form method="post" action="/Sales/animal">@Html.AntiForgeryToken()<label for="animal-customer" data-i18n="Customer">Customer</label><select id="animal-customer" name="customerId"><option value="" data-i18n="Unassigned">Unassigned</option>@foreach(var p in Model.Parties.Where(x=>x.Active)){<option value="@p.Id">@p.Name</option>}</select><label for="animal" data-i18n="Available animal">Available animal</label><select id="animal" name="animalId" required><option value="" data-i18n="Choose an animal">Choose an animal</option>@foreach(var animal in Model.Animals){<option value="@animal.Id">@animal.Tag — @animal.Breed</option>}</select><label for="animal-amount" data-i18n="Sale amount">Sale amount</label><input id="animal-amount" name="amount" type="number" min="@Model.MoneyStep" step="@Model.MoneyStep" required/><label for="animal-ref" data-i18n="Unique sale reference">Unique sale reference</label><input id="animal-ref" name="reference" maxlength="80" required/><button class="primary" type="submit" data-i18n="Sell animal &amp; post">Sell animal &amp; post</button></form></section>}
<section class="panel"><h2 data-i18n="Documents">Documents</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Reference">Reference</th><th data-i18n="Type">Type</th><th data-i18n="Party">Party</th><th data-i18n="Original amount">Original amount</th><th data-i18n="Returned">Returned</th><th data-i18n="Paid / net of refunds">Paid / net of refunds</th><th data-i18n="Outstanding">Outstanding</th></tr></thead><tbody>@foreach(var doc in Model.Documents){<tr><td>@doc.Reference</td><td data-i18n-enum="document" data-i18n-value="@doc.Kind">@doc.Kind</td><td data-i18n="@(doc.PartyAssigned ? null : "Unassigned")">@doc.Party</td><td>@Model.Money(doc.Amount)</td><td>@Model.Money(doc.Returned)</td><td>@Model.Money(doc.Paid)</td><td>@Model.Money(doc.Outstanding) <span data-i18n="@(doc.Outstanding<0?"refund due":null)">@(doc.Outstanding<0?"refund due":"")</span></td></tr>}</tbody></table></div>@if(Model.Documents.Count==0){<p class="empty" data-i18n="No documents posted yet.">No documents posted yet.</p>}</section>
<section class="panel"><h2 data-i18n="Returns for listed documents">Returns for listed documents</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Return reference">Return reference</th><th data-i18n="Original document">Original document</th><th data-i18n="Quantity">Quantity</th><th data-i18n="Credit amount">Credit amount</th><th data-i18n="Inventory value">Inventory value</th></tr></thead><tbody>@foreach(var item in Model.Returns){<tr><td>@item.Reference</td><td>@Model.Documents.First(x=>x.Id==item.FinanceDocumentId).Reference</td><td>@item.Quantity.ToString("N3")</td><td>@item.Amount.ToString("N3")</td><td>@item.CostAmount.ToString("N3")</td></tr>}</tbody></table></div></section>
