@model EnterpriseERP.Web.Controllers.OperationsWorkspaceModel
@{ViewData["Title"]="Suppliers & Customers";}
<div class="page-header"><div><span class="eyebrow" data-i18n="Branch trading partners">Branch trading partners</span><h1 data-i18n="Suppliers &amp; Customers">Suppliers &amp; Customers</h1><p class="subtle" data-i18n="Use party records on purchase orders, receipts and sales documents.">Use party records on purchase orders, receipts and sales documents.</p></div><a class="muted-btn" href="/Purchase" data-i18n="Purchase orders">Purchase orders</a></div>
@if(TempData["Error"] is string error){<div class="notice" role="alert">@error</div>}
@if(TempData["Success"] is string success){<div class="notice" role="status">@success</div>}
<section class="panel"><h2 data-i18n="Add a party">Add a party</h2><form method="post" action="/Parties/create">@Html.AntiForgeryToken()<label for="party-kind" data-i18n="Type">Type</label><select id="party-kind" name="kind"><option value="Supplier" data-i18n="Supplier">Supplier</option><option value="Customer" data-i18n="Customer">Customer</option></select><label for="party-code" data-i18n="Unique branch code">Unique branch code</label><input id="party-code" name="code" maxlength="30" required/><label for="party-name" data-i18n="Name">Name</label><input id="party-name" name="name" maxlength="160" required/><label for="party-email" data-i18n="Email (optional)">Email (optional)</label><input id="party-email" name="email" type="email" maxlength="200"/><label for="party-phone" data-i18n="Phone (optional)">Phone (optional)</label><input id="party-phone" name="phone" maxlength="40"/><label for="party-address" data-i18n="Address (optional)">Address (optional)</label><input id="party-address" name="address" maxlength="500"/><button class="primary" type="submit" data-i18n="Create party">Create party</button></form></section>
<partial name="_BoundedRegisterPager" model="@(new EnterpriseERP.Web.Controllers.BoundedRegisterPager("/Parties", Model.PartiesPage))" />
<section class="panel"><h2 data-i18n="Party directory">Party directory</h2><p class="subtle" data-i18n="Deactivate a record to prevent new trading documents. Existing balances and history stay available for settlement.">Deactivate a record to prevent new trading documents. Existing balances and history stay available for settlement.</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Code">Code</th><th data-i18n="Type">Type</th><th data-i18n="Name">Name</th><th data-i18n="Contact">Contact</th><th data-i18n="Status">Status</th><th data-i18n="Action">Action</th></tr></thead><tbody>@foreach(var p in Model.Parties){<tr><td>@p.Code</td><td data-i18n-enum="party" data-i18n-value="@p.Kind">@p.Kind</td><td>@p.Name<br/>@p.Address</td><td>@p.Email<br/>@p.Phone</td><td data-i18n="@(p.Active?"Active":"Inactive")">@(p.Active?"Active":"Inactive")</td><td><form method="post" action="/Parties/status">@Html.AntiForgeryToken()<input type="hidden" name="partyId" value="@p.Id"/><input type="hidden" name="active" value="@(!p.Active?"true":"false")"/><button class="muted-btn" type="submit" data-i18n="@(p.Active?"Deactivate":"Activate")">@(p.Active?"Deactivate":"Activate")</button></form></td></tr>}</tbody></table></div></section>
