@model EnterpriseERP.Web.Controllers.OperationsWorkspaceModel
@{ViewData["Title"]="Accounts"; var s=Model.Statement!;}
@await Html.PartialAsync("~/Views/Shared/_CurrencyPolicyNotice.cshtml",Model)
<div class="page-header"><div><span class="eyebrow" data-i18n="Finance workspace">Finance workspace</span><h1 data-i18n="Accounts">Accounts</h1><p class="subtle" data-i18n="Document settlement, bank matching, journals and financial reports.">Document settlement, bank matching, journals and financial reports.</p></div><a class="muted-btn" href="/Accounts/opening" data-i18n="Opening balances">Opening balances</a><a class="muted-btn" href="/Accounts/periods" data-i18n="Close accounting period">Close accounting period</a><a class="muted-btn" href="/Reports" data-i18n="Report exports">Report exports</a></div>
@if(TempData["Error"] is string error){<div class="notice" role="alert">@error</div>}
@if(TempData["Success"] is string success){<div class="notice" role="status">@success</div>}
<div class="notice"><span data-i18n="Operational management reports use the configured 1xxx assets, 2xxx liabilities, 3xxx equity, 4xxx revenue, 5xxx cost and 6xxx expense mapping. Confirm the chart and opening balances with your accountant before statutory use. Negative document balances are refunds due.">Operational management reports use the configured 1xxx assets, 2xxx liabilities, 3xxx equity, 4xxx revenue, 5xxx cost and 6xxx expense mapping. Confirm the chart and opening balances with your accountant before statutory use. Negative document balances are refunds due.</span></div>
<div class="kpi-grid"><div class="kpi"><span data-i18n="Revenue through">Revenue through</span> @Model.Through<strong>@s.Revenue.ToString("N3")</strong></div><div class="kpi"><span data-i18n="Profit through">Profit through</span> @Model.Through<strong>@s.Profit.ToString("N3")</strong></div><div class="kpi"><span data-i18n="Current inventory carrying value">Current inventory carrying value</span><strong>@Model.InventoryCarryingValue.ToString("N3")</strong></div><div class="kpi"><span data-i18n="Inventory vs GL difference">Inventory vs GL difference</span><strong>@((Model.InventoryCarryingValue-Model.InventoryLedgerValue).ToString("N3"))</strong><small><bdi>@Model.MissingInventoryValuations</bdi> <span data-i18n="stock items need opening valuation review">stock items need opening valuation review</span></small></div></div>
<div class="panels"><section class="panel"><h2 data-i18n="Payment or refund">Payment or refund</h2><p class="subtle" data-i18n="Choose an open document. A positive balance posts a payment; a negative balance posts a refund. Amount cannot exceed the balance.">Choose an open document. A positive balance posts a payment; a negative balance posts a refund. Amount cannot exceed the balance.</p><form method="post" action="/Accounts/payment">@Html.AntiForgeryToken()<label for="payment-doc" data-i18n="Document">Document</label><select id="payment-doc" name="documentId" required><option value="" data-i18n="Choose an open document">Choose an open document</option>@foreach(var d in Model.Documents.Where(x=>x.Outstanding!=0)){<option value="@d.Id" data-i18n-template="@(d.PartyAssigned ? "document-settlement" : "unassigned-settlement")" data-i18n-values="@System.Text.Json.JsonSerializer.Serialize(new { reference = d.Reference, kind = d.Kind, party = d.Party, amount = Model.Money(d.Outstanding), balance = d.Outstanding < 0 ? "refund" : "due" })">@d.Reference (@d.Kind, @d.Party) — @Model.Money(d.Outstanding) @(d.Outstanding<0?"refund":"due")</option>}</select><label for="payment-amount" data-i18n="Amount">Amount</label><input id="payment-amount" name="amount" type="number" min="@Model.MoneyStep" step="@Model.MoneyStep" required/><label for="payment-ref" data-i18n="Unique reference">Unique reference</label><input id="payment-ref" name="reference" maxlength="80" required/><button class="primary" type="submit" data-i18n="Post settlement">Post settlement</button></form></section>
<section class="panel"><h2 data-i18n="Bank statement entry">Bank statement entry</h2><p class="subtle" data-i18n="Enter receipts as positive and withdrawals as negative. Cash/bank account: 1000.">Enter receipts as positive and withdrawals as negative. Cash/bank account: 1000.</p><form method="post" action="/Accounts/bank-line">@Html.AntiForgeryToken()<label for="bank-ref" data-i18n="Bank reference">Bank reference</label><input id="bank-ref" name="reference" maxlength="80" required/><label for="bank-amount" data-i18n="Signed amount">Signed amount</label><input id="bank-amount" name="amount" type="number" step="@Model.MoneyStep" required/><label for="bank-date" data-i18n="Value date">Value date</label><input id="bank-date" name="date" type="date" value="@Model.Today.ToString("yyyy-MM-dd")" required/><button class="primary" type="submit" data-i18n="Save bank line">Save bank line</button></form></section></div>
<section class="panel"><h2 data-i18n="Reconcile a bank line">Reconcile a bank line</h2><p class="subtle" data-i18n="One statement line matches one voucher with an identical signed cash/bank amount. A voucher can only be matched once.">One statement line matches one voucher with an identical signed cash/bank amount. A voucher can only be matched once.</p><p class="subtle" data-i18n="Search or change the bank lines and vouchers pages to choose older unmatched records.">Search or change the bank lines and vouchers pages to choose older unmatched records.</p>
<h3 data-i18n="Bank statement line search">Bank statement line search</h3>
<p class="subtle" data-i18n="These filters also control the bank history below.">These filters also control the bank history below.</p>
@await Html.PartialAsync("~/Views/OperationsWorkspace/_WorkspaceBrowse.cshtml", new EnterpriseERP.Web.Controllers.WorkspaceBrowseModel(Model, EnterpriseERP.Web.Controllers.WorkspaceBrowseKind.BankLines))
<h3 data-i18n="Cash/bank voucher search">Cash/bank voucher search</h3>
@await Html.PartialAsync("~/Views/OperationsWorkspace/_WorkspaceBrowse.cshtml", new EnterpriseERP.Web.Controllers.WorkspaceBrowseModel(Model, EnterpriseERP.Web.Controllers.WorkspaceBrowseKind.CashVouchers))
<form method="post" action="/Accounts/reconcile">@Html.AntiForgeryToken()<label for="match-line" data-i18n="Unmatched statement line">Unmatched statement line</label><select id="match-line" name="statementLineId" required><option value="" data-i18n="Choose a statement line">Choose a statement line</option>@foreach(var line in Model.BankLines.Where(x=>x.MatchedVoucherId==null)){<option value="@line.Id">@line.ValueDate — @line.ExternalReference — @line.Amount.ToString("N3")</option>}</select><label for="match-voucher" data-i18n="Unmatched cash/bank voucher">Unmatched cash/bank voucher</label><select id="match-voucher" name="voucherId" required><option value="" data-i18n="Choose a voucher">Choose a voucher</option>@foreach(var v in Model.CashVouchers){<option value="@v.Id">@v.Reference — @v.Lines.Where(x=>x.AccountCode=="1000").Sum(x=>x.Debit-x.Credit).ToString("N3")</option>}</select><button class="primary" type="submit" data-i18n="Match bank transaction">Match bank transaction</button></form></section>
<section class="panel"><h2 data-i18n="Manual journal">Manual journal</h2><p class="subtle" data-i18n="For cash, equity, revenue and expense adjustments. Use operational documents for inventory, livestock assets, payables and receivables.">For cash, equity, revenue and expense adjustments. Use operational documents for inventory, livestock assets, payables and receivables.</p><form method="post" action="/Accounts/journal">@Html.AntiForgeryToken()<label for="journal-ref" data-i18n="Unique reference">Unique reference</label><input id="journal-ref" name="reference" maxlength="80" required/><label for="debit-account" data-i18n="Debit account code">Debit account code</label><input id="debit-account" name="debitAccount" pattern="[1-6][0-9]{3}" maxlength="4" required/><label for="credit-account" data-i18n="Credit account code">Credit account code</label><input id="credit-account" name="creditAccount" pattern="[1-6][0-9]{3}" maxlength="4" required/><label for="journal-amount" data-i18n="Amount">Amount</label><input id="journal-amount" name="amount" type="number" min="@Model.MoneyStep" step="@Model.MoneyStep" required/><button class="primary" type="submit" data-i18n="Post balanced journal">Post balanced journal</button></form></section>
<section class="panel"><h2 data-i18n="Financial report filters">Financial report filters</h2><form method="get" action="/Accounts"><input type="hidden" name="BankPage" value="@Model.BankLinesPage.PageNumber"/><input type="hidden" name="BankSearch" value="@Model.BankLinesPage.Search"/><input type="hidden" name="BankUnmatchedOnly" value="@Model.BankUnmatchedOnly.ToString()"/><input type="hidden" name="VoucherPage" value="@Model.CashVouchersPage.PageNumber"/><input type="hidden" name="VoucherSearch" value="@Model.CashVouchersPage.Search"/><label for="from" data-i18n="Ledger from">Ledger from</label><input id="from" name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")" required/><label for="through" data-i18n="Through (inclusive)">Through (inclusive)</label><input id="through" name="through" type="date" value="@Model.Through.ToString("yyyy-MM-dd")" required/><label for="account" data-i18n="Ledger account code (optional)">Ledger account code (optional)</label><input id="account" name="account" maxlength="20" value="@Model.Account"/><button class="primary" type="submit" data-i18n="Apply filters">Apply filters</button></form></section>
<section class="panel"><h2><span data-i18n="Trial balance through">Trial balance through</span> @Model.Through</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Account">Account</th><th data-i18n="Debit">Debit</th><th data-i18n="Credit">Credit</th></tr></thead><tbody>@foreach(var line in Model.TrialBalance){<tr><td>@line.Account</td><td>@line.Debit.ToString("N3")</td><td>@line.Credit.ToString("N3")</td></tr>}</tbody><tfoot><tr><th data-i18n="Total">Total</th><th>@Model.TrialBalance.Sum(x=>x.Debit).ToString("N3")</th><th>@Model.TrialBalance.Sum(x=>x.Credit).ToString("N3")</th></tr></tfoot></table></div><p><span data-i18n="Assets">Assets</span> @s.Assets.ToString("N3") · <span data-i18n="Liabilities">Liabilities</span> @s.Liabilities.ToString("N3") · <span data-i18n="Posted equity">Posted equity</span> @s.Equity.ToString("N3") · <span data-i18n="Unclosed profit">Unclosed profit</span> @s.Profit.ToString("N3")</p></section>
<section class="panel"><h2 data-i18n="Ledger">Ledger</h2><p class="subtle"><span data-i18n="Showing latest">Showing latest</span> <bdi>@Model.Ledger.Count</bdi> / <bdi>@Model.LedgerCount</bdi> <span data-i18n="matching lines. Narrow the dates or account to see older entries.">matching lines. Narrow the dates or account to see older entries.</span></p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Date">Date</th><th data-i18n="Reference">Reference</th><th data-i18n="Account">Account</th><th data-i18n="Debit">Debit</th><th data-i18n="Credit">Credit</th></tr></thead><tbody>@foreach(var line in Model.Ledger){<tr><td>@line.Date.UtcDateTime.ToString("yyyy-MM-dd")</td><td>@line.Reference</td><td>@line.Account</td><td>@line.Debit.ToString("N3")</td><td>@line.Credit.ToString("N3")</td></tr>}</tbody></table></div></section>
<section class="panel"><h2 data-i18n="Document balances">Document balances</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Reference">Reference</th><th data-i18n="Type">Type</th><th data-i18n="Party">Party</th><th data-i18n="Original">Original</th><th data-i18n="Returns">Returns</th><th data-i18n="Net settled">Net settled</th><th data-i18n="Due / refund">Due / refund</th></tr></thead><tbody>@foreach(var d in Model.Documents){<tr><td>@d.Reference</td><td data-i18n-enum="document" data-i18n-value="@d.Kind">@d.Kind</td><td data-i18n="@(d.PartyAssigned ? null : "Unassigned")">@d.Party</td><td>@Model.Money(d.Amount)</td><td>@Model.Money(d.Returned)</td><td>@Model.Money(d.Paid)</td><td>@Model.Money(d.Outstanding)</td></tr>}</tbody></table></div></section>
<section class="panel"><h2 data-i18n="Latest 100 payments &amp; refunds">Latest 100 payments &amp; refunds</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Reference">Reference</th><th data-i18n="Party / direction">Party / direction</th><th data-i18n="Amount">Amount</th><th data-i18n="Voucher">Voucher</th></tr></thead><tbody>@foreach(var p in Model.Payments){<tr><td>@p.Reference</td><td data-i18n-enum="payment" data-i18n-value="@p.PartyType">@p.PartyType</td><td>@p.Amount.ToString("N3")</td><td>@p.VoucherId</td></tr>}</tbody></table></div></section>
<section class="panel"><h2 data-i18n="Bank statement lines">Bank statement lines</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Value date">Value date</th><th data-i18n="Bank reference">Bank reference</th><th data-i18n="Amount">Amount</th><th data-i18n="Matched voucher">Matched voucher</th></tr></thead><tbody>@foreach(var line in Model.BankLines){<tr><td>@line.ValueDate</td><td>@line.ExternalReference</td><td>@line.Amount.ToString("N3")</td><td data-i18n="@(line.MatchedVoucherId is null?"Unmatched":null)">@(line.MatchedVoucherId?.ToString()??"Unmatched")</td></tr>}</tbody></table></div></section>
