@model EnterpriseERP.Domain.AccountingPeriodClose
@{ViewData["Title"]="Accounting period close";var today=(DateOnly)ViewData["BusinessToday"]!;}
<h1 data-i18n="Accounting period close">Accounting period close</h1><div class="notice"><span data-i18n="Closing is a financial control. Reconcile your books, export reports, and obtain your accounting approval first. This interface cannot reopen a closed period.">Closing is a financial control. Reconcile your books, export reports, and obtain your accounting approval first. This interface cannot reopen a closed period.</span></div>
<section class="panel"><h2 data-i18n="Current lock">Current lock</h2>@if(Model is null){<p data-i18n="No period has been closed.">No period has been closed.</p>}else{<p><span data-i18n="Closed through">Closed through</span> <bdi>@Model.ClosedThrough.ToString("yyyy-MM-dd")</bdi></p>}@if(Model is not null){<p>@Model.Reason</p>}</section>
<section class="panel"><form method="post" action="/Accounts/periods/close">@Html.AntiForgeryToken()<label><span data-i18n="Closed through">Closed through</span><input type="date" name="through" max="@today.AddDays(-1).ToString("yyyy-MM-dd")" required/></label><label><span data-i18n="Approval/reconciliation reason">Approval/reconciliation reason</span><textarea name="reason" maxlength="500" required></textarea></label><button class="primary" data-i18n="Close accounting period">Close accounting period</button></form></section><a href="/Accounts" data-i18n="Back to Accounts">Back to Accounts</a>
