@model EnterpriseERP.Web.OpeningBalancePage
@{ViewData["Title"]="Opening balances";}
<div class="page-header"><div><span class="eyebrow" data-i18n="Finance workspace">Finance workspace</span><h1 data-i18n="Opening balances">Opening balances</h1><p class="subtle" data-i18n="One reviewed opening per empty branch, with itemized inventory and livestock values.">One reviewed opening per empty branch, with itemized inventory and livestock values.</p></div><a href="/Accounts" class="muted-btn" data-i18n="Back to Accounts">Back to Accounts</a></div>
<div asp-validation-summary="All" class="notice" role="alert"></div>
@if(Model.Existing is { } existing)
{
<section class="panel"><h2 data-i18n="Posted opening balance">Posted opening balance</h2><p>@existing.Reference · @existing.OpeningDate.ToString("yyyy-MM-dd") · @existing.RecordedBy</p><p>@existing.ReviewNote</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Account">Account</th><th data-i18n="Debit">Debit</th><th data-i18n="Credit">Credit</th></tr></thead><tbody>@foreach(var line in existing.Voucher.Lines){<tr><td>@line.AccountCode</td><td>@line.Debit.ToString("N3")</td><td>@line.Credit.ToString("N3")</td></tr>}</tbody></table></div><p data-i18n="Opening records are immutable. Corrections require a separately authorized accounting procedure.">Opening records are immutable. Corrections require a separately authorized accounting procedure.</p>
<h2 data-i18n="Opening stock source values">Opening stock source values</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Stock item">Stock item</th><th data-i18n="Quantity">Quantity</th><th data-i18n="Exact carrying value">Exact carrying value</th></tr></thead><tbody>@foreach(var row in existing.Stocks){<tr><td>#@row.StockItemId</td><td>@row.Quantity.ToString("N3")</td><td>@row.Value.ToString("N3")</td></tr>}</tbody></table></div>
<h2 data-i18n="Opening animal source values">Opening animal source values</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Animal">Animal</th><th data-i18n="Value">Value</th></tr></thead><tbody>@foreach(var row in existing.Animals){<tr><td>#@row.AnimalId</td><td>@row.Value.ToString("N3")</td></tr>}</tbody></table></div></section>
}
else if(Model.HasFinancialActivity)
{<p class="notice" data-i18n="Opening balances are unavailable because this branch already has financial or stock activity.">Opening balances are unavailable because this branch already has financial or stock activity.</p>}
else
{
<p class="notice" data-i18n="Use accountant-reviewed opening values, not estimates. Receivables and payables require party documents and are excluded. Existing nonzero master values need a separate reviewed migration.">Use accountant-reviewed opening values, not estimates. Receivables and payables require party documents and are excluded. Existing nonzero master values need a separate reviewed migration.</p>
<form method="post" action="/Accounts/opening/post">@Html.AntiForgeryToken()
<section class="panel"><h2 data-i18n="Opening review">Opening review</h2><label asp-for="Opening.Reference" data-i18n="Unique reference">Unique reference</label><input asp-for="Opening.Reference" maxlength="60" required/><label asp-for="Opening.OpeningDate" data-i18n="Date">Date</label><input asp-for="Opening.OpeningDate" type="date" required/><label asp-for="Opening.ReviewNote" data-i18n="Review note and source records">Review note and source records</label><input asp-for="Opening.ReviewNote" maxlength="1000" required/></section>
<section class="panel"><h2 data-i18n="Approved opening accounts">Approved opening accounts</h2><p data-i18n="Enter debit or credit per account. Inventory 1300 and livestock 1400 are added automatically from the itemized values below. Total debits must equal total credits.">Enter debit or credit per account. Inventory 1300 and livestock 1400 are added automatically from the itemized values below. Total debits must equal total credits.</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Account">Account</th><th data-i18n="Debit">Debit</th><th data-i18n="Credit">Credit</th></tr></thead><tbody>
@for(var i=0;i<Model.Opening.Ledger.Count;i++){<tr><td><input asp-for="Opening.Ledger[i].AccountCode" type="hidden"/>@Model.Opening.Ledger[i].AccountCode <span data-i18n="@OpeningBalanceService.Accounts.GetValueOrDefault(Model.Opening.Ledger[i].AccountCode ?? "", "Unknown")">@OpeningBalanceService.Accounts.GetValueOrDefault(Model.Opening.Ledger[i].AccountCode ?? "", "Unknown")</span></td><td><input asp-for="Opening.Ledger[i].Debit" type="number" min="0" step="0.001" aria-label="Debit" data-i18n-aria-label="Debit"/></td><td><input asp-for="Opening.Ledger[i].Credit" type="number" min="0" step="0.001" aria-label="Credit" data-i18n-aria-label="Credit"/></td></tr>}
</tbody></table></div></section>
<section class="panel"><h2 data-i18n="Opening stock source values">Opening stock source values</h2><p data-i18n="Select only zero-quantity products. Supply the physical quantity and exact total opening value. Average unit cost is derived; source values and stock movements are recorded together.">Select only zero-quantity products. Supply the physical quantity and exact total opening value. Average unit cost is derived; source values and stock movements are recorded together.</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Stock item">Stock item</th><th data-i18n="Quantity">Quantity</th><th data-i18n="Exact carrying value">Exact carrying value</th></tr></thead><tbody id="opening-stock-rows">
@for(var i=0;i<Model.Opening.Stocks.Count;i++){<tr><td><select asp-for="Opening.Stocks[i].StockItemId" aria-label="Stock item" data-i18n-aria-label="Stock item"><option value="0" data-i18n="Unused row">Unused row</option>@foreach(var item in Model.StockItems){<option value="@item.Id">@item.SKU · @item.Name</option>}</select></td><td><input asp-for="Opening.Stocks[i].Quantity" type="number" min="0" step="0.001" aria-label="Quantity" data-i18n-aria-label="Quantity"/></td><td><input asp-for="Opening.Stocks[i].Value" type="number" min="0" step="0.001" aria-label="Value" data-i18n-aria-label="Value"/></td></tr>}
</tbody></table></div><button class="muted-btn" type="button" data-opening-add="opening-stock-rows" data-i18n="Add stock row">Add stock row</button></section>
<section class="panel"><h2 data-i18n="Opening animal source values">Opening animal source values</h2><p data-i18n="Select only unsold animals with zero recorded cost. The reviewed opening value becomes their recorded cost basis; no purchase or supplier payable is invented.">Select only unsold animals with zero recorded cost. The reviewed opening value becomes their recorded cost basis; no purchase or supplier payable is invented.</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Animal">Animal</th><th data-i18n="Value">Value</th></tr></thead><tbody id="opening-animal-rows">
@for(var i=0;i<Model.Opening.Animals.Count;i++){<tr><td><select asp-for="Opening.Animals[i].AnimalId" aria-label="Animal" data-i18n-aria-label="Animal"><option value="0" data-i18n="Unused row">Unused row</option>@foreach(var animal in Model.Animals){<option value="@animal.Id">@animal.Tag · @animal.Breed</option>}</select></td><td><input asp-for="Opening.Animals[i].Value" type="number" min="0" step="0.001" aria-label="Value" data-i18n-aria-label="Value"/></td></tr>}
</tbody></table></div><button class="muted-btn" type="button" data-opening-add="opening-animal-rows" data-i18n="Add animal row">Add animal row</button></section>
<section class="panel"><label><input asp-for="Opening.ConfirmReviewed" type="checkbox" style="width:auto"/><span data-i18n="I confirm the opening balances, account mapping and itemized source values were reviewed.">I confirm the opening balances, account mapping and itemized source values were reviewed.</span></label><button class="primary" type="submit" data-i18n="Post reviewed opening">Post reviewed opening</button></section></form>
}

@section Scripts { <script src="~/js/opening-balance.js" asp-append-version="true"></script> }
