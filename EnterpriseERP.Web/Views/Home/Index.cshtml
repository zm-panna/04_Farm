@model EnterpriseERP.Web.Controllers.DashboardPage
@{ViewData["Title"]="Overview";}
<section class="page-header"><div><span class="eyebrow" data-i18n="Farm management / Overview">Farm management / Overview</span><h1 data-i18n="Overview">Overview</h1><p class="subtle" data-i18n="Live records from your selected company and branch.">Live records from your selected company and branch.</p></div><a class="muted-btn" href="/Context" data-i18n="Switch farm">Switch farm</a></section>
<section class="hero"><div><span class="eyebrow" data-i18n="Welcome to FarmSphere">Welcome to FarmSphere</span><h2 data-i18n="Daily farm operations">Daily farm operations</h2><p data-i18n="Track animals, production, feed, inventory and posted finances in one authorized workspace.">Track animals, production, feed, inventory and posted finances in one authorized workspace.</p><a class="primary" href="/animals" data-i18n="Open animal registry">Open animal registry</a></div><div class="hero-stat"><span data-i18n="Current scope">Current scope</span><strong><span data-i18n="Company">Company</span> @User.FindFirst("ActiveCompanyId")?.Value</strong><span><span data-i18n="Branch">Branch</span> @User.FindFirst("ActiveBranchId")?.Value</span></div></section>
<section class="kpi-grid" aria-label="Live key indicators" data-i18n-aria-label="Live key indicators"><article class="kpi"><span data-i18n="Active animals">Active animals</span><strong data-i18n="@(Model.Summary is null ? "Restricted" : null)">@(Model.Summary?.AnimalCount.ToString() ?? "Restricted")</strong><small data-i18n="Unsold registered animals">Unsold registered animals</small></article><article class="kpi"><span data-i18n="Milk production">Milk production</span><strong data-i18n="@(Model.Summary is null ? "Restricted" : null)">@(Model.Summary?.MilkLitres.ToString("N3") ?? "Restricted")</strong><small data-i18n="Recorded litres, all dates">Recorded litres, all dates</small></article><article class="kpi"><span data-i18n="Stock value">Stock value</span><strong data-i18n="@(Model.Summary is null ? "Restricted" : null)">@(Model.Summary?.StockValue.ToString("N3") ?? "Restricted")</strong><small data-i18n="Exact posted inventory carrying value">Exact posted inventory carrying value</small></article><article class="kpi"><span data-i18n="Product sales">Product sales</span><strong data-i18n="@(Model.Summary is null ? "Restricted" : null)">@(Model.Summary?.Sales.ToString("N3") ?? "Restricted")</strong><small data-i18n="Posted gross sales, before returns">Posted gross sales, before returns</small></article></section>
<div class="panels"><section class="panel"><h2 data-i18n="Quick access">Quick access</h2><div class="quick-grid"><a class="quick-card" href="/animals" data-i18n="Animal registry">Animal registry</a><a class="quick-card" href="/milk-entry" data-i18n="Milk production">Milk production</a><a class="quick-card" href="/FeedManagement" data-i18n="Feed consumption">Feed consumption</a><a class="quick-card" href="/Purchase" data-i18n="Purchase receipt">Purchase receipt</a><a class="quick-card" href="/Sales" data-i18n="Product &amp; livestock sales">Product &amp; livestock sales</a><a class="quick-card" href="/Accounts" data-i18n="Accounts &amp; payments">Accounts &amp; payments</a><a class="quick-card" href="/breeding" data-i18n="Breeding records">Breeding records</a><a class="quick-card" href="/Fattening" data-i18n="Fattening plans">Fattening plans</a><a class="quick-card" href="/Expenses" data-i18n="Farm expenses">Farm expenses</a></div></section><section class="panel"><h2 data-i18n="Attention center">Attention center</h2>@if(Model.HealthDue.HasValue){<p><a href="/animal-health"><bdi>@Model.HealthDue</bdi> <span data-i18n="health records due for review">health records due for review</span></a></p>}@if(Model.OpenTickets.HasValue){<p><a href="/support/tickets"><bdi>@Model.OpenTickets</bdi> <span data-i18n="open support tickets">open support tickets</span></a></p>}<p data-i18n="Due dates reflect recorded plans and require staff review; they are not veterinary recommendations.">Due dates reflect recorded plans and require staff review; they are not veterinary recommendations.</p><a class="muted-btn" href="/Automation" data-i18n="In-app automation">In-app automation</a></section></div>
<section class="panel"><h2 data-i18n="Reports and billing">Reports and billing</h2><p><a href="/Reports" data-i18n="Financial reports and exports">Financial reports and exports</a> · <a href="/Subscription" data-i18n="Subscription invoices">Subscription invoices</a>@if(Model.CanManageStaff){<span> · </span><a href="/admin/permissions" data-i18n="Access permissions">Access permissions</a>}</p></section>
