@model EnterpriseERP.Web.Controllers.BusinessPolicyPage
@{ ViewData["Title"] = "Business policy"; }
<section class="page-head"><div><p class="eyebrow" data-i18n="Company settings">Company settings</p><h1 data-i18n="Business policy">Business policy</h1><p data-i18n="Reviewed jurisdiction, currency, timezone and tax versions">Reviewed jurisdiction, currency, timezone and tax versions</p></div></section>
<div class="notice" role="note" data-i18n="These settings record an accountant-reviewed policy. Country selection does not establish statutory compliance. Each company has one locked accounting currency; no foreign-exchange conversion occurs. Changes create new effective-dated versions and never rewrite posted documents. Payroll, sales tax, US state/local rules and each Arab country&#x27;s requirements must be reviewed separately.">These settings record an accountant-reviewed policy. Country selection does not establish statutory compliance. Each company has one locked accounting currency; no foreign-exchange conversion occurs. Changes create new effective-dated versions and never rewrite posted documents. Payroll, sales tax, US state/local rules and each Arab country's requirements must be reviewed separately.</div>
@if(Model.Currency is not null){<div class="notice"><span data-i18n="Accounting denomination:">Accounting denomination:</span> @Model.Currency.CurrencyCode, @Model.Currency.CurrencyMinorUnits <span data-i18n="decimal places. Locked after independent approval.">decimal places. Locked after independent approval.</span></div>}else{<div class="notice" role="alert" data-i18n="No approved accounting denomination. Existing amounts are unlabelled until their currency is explicitly reviewed; no default currency is assumed.">No approved accounting denomination. Existing amounts are unlabelled until their currency is explicitly reviewed; no default currency is assumed.</div>}
<form method="get" class="form-grid"><label><span data-i18n="Search">Search</span><input name="search" value="@Model.Search" maxlength="100" /></label><label><span data-i18n="Status">Status</span><select name="status"><option value="" data-i18n="All statuses">All statuses</option>@foreach(var state in new[]{"Draft","Approved","Rejected"}){<option value="@state" selected="@(Model.Status==state)" data-i18n="@state">@state</option>}</select></label><button class="btn" type="submit" data-i18n="Apply filters">Apply filters</button></form>
<section class="panel"><h2 data-i18n="Company policy versions">Company policy versions</h2><div class="table-wrap"><table><thead><tr><th data-i18n="Version">Version</th><th data-i18n="Jurisdiction">Jurisdiction</th><th data-i18n="Currency / timezone">Currency / timezone</th><th data-i18n="Effective period">Effective period</th><th data-i18n="Review basis">Review basis</th><th data-i18n="Status / approval">Status / approval</th></tr></thead><tbody>
@foreach(var item in Model.Policies){<tr><td>@item.Version</td><td>@item.CountryCode @item.RegionCode</td><td>@item.CurrencyCode (@item.CurrencyMinorUnits)<br/>@item.TimeZoneId</td><td>@item.EffectiveFrom.ToString("yyyy-MM-dd") <span data-i18n="to">to</span> @(item.EffectiveTo?.ToString("yyyy-MM-dd")??"")</td><td>@item.ReviewBasis<br/><span data-i18n="Existing amounts reviewed:">Existing amounts reviewed:</span> <span data-i18n="@(item.ExistingLedgerCurrencyConfirmed?"Yes":"No")">@(item.ExistingLedgerCurrencyConfirmed?"Yes":"No")</span></td><td><span data-i18n="@item.Status">@item.Status</span><br/><span data-i18n="Created:">Created:</span> @item.CreatedBy<br/><span data-i18n="Reviewed:">Reviewed:</span> @item.ApprovedBy @if(item.Status=="Draft"&&Model.CanApprove){<form method="post" action="/business-policy/review">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="versionToken" value="@Convert.ToBase64String(item.RowVersion)"/><button type="submit" name="approve" value="true" data-i18n="Approve and lock currency">Approve and lock currency</button><button type="submit" name="approve" value="false" data-i18n="Reject">Reject</button></form>}</td></tr>}
</tbody></table></div><p><span data-i18n="Page">Page</span> @Model.Page <span data-i18n="of">of</span> @Math.Max(1,(Model.Total+19)/20) · @Model.Total <span data-i18n="records">records</span></p><a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Math.Max(1,Model.Page-1))" asp-route-taxPage="@Model.TaxPage" data-i18n="Previous">Previous</a> · <a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page+1)" asp-route-taxPage="@Model.TaxPage" data-i18n="Next">Next</a></section>
@if(Model.CanManage){<section class="panel"><h2 data-i18n="Propose company policy">Propose company policy</h2><form method="post" action="/business-policy/propose" class="form-grid">@Html.AntiForgeryToken()
<label><span data-i18n="Country code (BD, US, AE, SA, etc.)">Country code (BD, US, AE, SA, etc.)</span><input name="CountryCode" maxlength="2" minlength="2" required/></label><label><span data-i18n="State / region (required for US)">State / region (required for US)</span><input name="RegionCode" maxlength="60"/></label><label><span data-i18n="Currency code">Currency code</span><input name="CurrencyCode" maxlength="3" minlength="3" value="@Model.Currency?.CurrencyCode" required/></label><label><span data-i18n="Currency decimal places">Currency decimal places</span><select name="CurrencyMinorUnits" required><option value="" data-i18n="Select explicitly">Select explicitly</option>@foreach(var n in new[]{0,1,2,3}){<option value="@n">@n</option>}</select></label>
<label><span data-i18n="Timezone identifier">Timezone identifier</span><input name="TimeZoneId" placeholder="Asia/Dhaka, Asia/Dubai, America/New_York" maxlength="100" required/></label><label><span data-i18n="Effective from">Effective from</span><input name="EffectiveFrom" type="date" required/></label><label><span data-i18n="Effective through (optional)">Effective through (optional)</span><input name="EffectiveTo" type="date"/></label><label><span data-i18n="Review basis / accountant approval reference">Review basis / accountant approval reference</span><textarea name="ReviewBasis" maxlength="2000" required></textarea></label><label><input name="ExistingLedgerCurrencyConfirmed" value="true" type="checkbox"/><span data-i18n="I reviewed existing ledger, stock valuations, subscriptions and documents and confirm they already use this currency. No conversion is performed.">I reviewed existing ledger, stock valuations, subscriptions and documents and confirm they already use this currency. No conversion is performed.</span></label><button type="submit" class="btn" data-i18n="Submit for independent review">Submit for independent review</button></form></section>}
<section class="panel"><h2 data-i18n="Sales tax policy versions">Sales tax policy versions</h2><p data-i18n="Exclusive, per-line percentage tax only. Rates are entered by an authorized reviewer. This does not determine tax jurisdiction, filing obligations, tax-inclusive pricing, compound taxes or foreign exchange.">Exclusive, per-line percentage tax only. Rates are entered by an authorized reviewer. This does not determine tax jurisdiction, filing obligations, tax-inclusive pricing, compound taxes or foreign exchange.</p><div class="table-wrap"><table><thead><tr><th data-i18n="Policy">Policy</th><th data-i18n="Treatment / explicit rate">Treatment / explicit rate</th><th data-i18n="Jurisdiction / account">Jurisdiction / account</th><th data-i18n="Effective period / basis">Effective period / basis</th><th data-i18n="Status">Status</th></tr></thead><tbody>
@foreach(var item in Model.Taxes){<tr><td>@item.Code v@item.Version<br/>@item.Name</td><td><span data-i18n="@item.TaxTreatment">@item.TaxTreatment</span><br/>@item.RatePercent %</td><td>@item.CountryCode @item.RegionCode / @item.CurrencyCode<br/>@item.TaxLiabilityAccount</td><td>@item.EffectiveFrom.ToString("yyyy-MM-dd") <span data-i18n="to">to</span> @(item.EffectiveTo?.ToString("yyyy-MM-dd")??"")<br/>@item.Reason</td><td><span data-i18n="@item.Status">@item.Status</span><br/>@item.ApprovedBy @if(item.Status=="Draft"&&Model.CanApproveTax){<form method="post" action="/business-policy/tax/review">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="versionToken" value="@Convert.ToBase64String(item.RowVersion)"/><button type="submit" name="approve" value="true" data-i18n="Approve tax policy">Approve tax policy</button><button type="submit" name="approve" value="false" data-i18n="Reject">Reject</button></form>}</td></tr>}
</tbody></table></div><p><span data-i18n="Page">Page</span> @Model.TaxPage <span data-i18n="of">of</span> @Math.Max(1,(Model.TaxTotal+19)/20) · @Model.TaxTotal <span data-i18n="records">records</span></p><a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@Model.Page" asp-route-taxPage="@(Math.Max(1,Model.TaxPage-1))" data-i18n="Previous">Previous</a> · <a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@Model.Page" asp-route-taxPage="@(Model.TaxPage+1)" data-i18n="Next">Next</a></section>
@if(Model.CanManageTax){<section class="panel"><h2 data-i18n="Propose sales tax policy">Propose sales tax policy</h2><form method="post" action="/business-policy/tax/propose" class="form-grid">@Html.AntiForgeryToken()<label><span data-i18n="Policy code">Policy code</span><input name="Code" maxlength="40" required/></label><label><span data-i18n="Name">Name</span><input name="Name" maxlength="120" required/></label><label><span data-i18n="Tax treatment">Tax treatment</span><select name="TaxTreatment" required><option value="" data-i18n="Select explicitly">Select explicitly</option><option value="Standard" data-i18n="Standard">Standard</option><option value="Exempt" data-i18n="Exempt">Exempt</option><option value="OutOfScope" data-i18n="OutOfScope">OutOfScope</option></select></label><label><span data-i18n="Explicit percentage">Explicit percentage</span><input name="RatePercent" type="number" step="0.001" min="0" max="100" required/></label><label><span data-i18n="Tax liability account (2xxx, except 2100)">Tax liability account (2xxx, except 2100)</span><input name="TaxLiabilityAccount" pattern="2[0-9]{3}" maxlength="4" required/></label><label><span data-i18n="Effective from">Effective from</span><input name="EffectiveFrom" type="date" required/></label><label><span data-i18n="Effective through">Effective through</span><input name="EffectiveTo" type="date"/></label><label><span data-i18n="Reviewed source / exemption basis">Reviewed source / exemption basis</span><textarea name="Reason" maxlength="2000" required></textarea></label><button type="submit" class="btn" data-i18n="Submit for independent review">Submit for independent review</button></form></section>}
