@model FixedAssetRunInput
@{ViewData["Title"]="Prepare monthly depreciation";}
<section class="farm-workspace"><div class="page-head"><h1 data-i18n="Prepare monthly depreciation">Prepare monthly depreciation</h1><a href="/fixed-assets/depreciation" data-i18n="Run history">Run history</a></div><div asp-validation-summary="All" class="notice" role="alert"></div><section class="panel"><p data-i18n="This saves a preview of eligible assets in the active branch. A different authorized user reviews it before posting. Complete earlier due months first. Disposed, non-depreciable, zero-cost and residual-floor assets are excluded.">This saves a preview of eligible assets in the active branch. A different authorized user reviews it before posting. Complete earlier due months first. Disposed, non-depreciable, zero-cost and residual-floor assets are excluded.</p><form method="post" action="/fixed-assets/depreciation/new">@Html.AntiForgeryToken()<label asp-for="Reference" data-i18n="Unique run reference">Unique run reference</label><input asp-for="Reference" maxlength="80" required/><label asp-for="Period" data-i18n="Completed month-end date">Completed month-end date</label><input asp-for="Period" type="date" required/><button class="primary" type="submit" data-i18n="Calculate and save preview">Calculate and save preview</button> <a href="/fixed-assets/depreciation" data-i18n="Cancel without saving">Cancel without saving</a></form></section></section>
