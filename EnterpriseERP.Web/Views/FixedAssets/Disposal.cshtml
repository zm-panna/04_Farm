@model EnterpriseERP.Web.Controllers.FixedAssetDisposalDetail
@{ViewData["Title"]="Review asset disposal";var d=Model.Disposal;var fmt=$"N{d.CurrencyMinorUnits}";}
<section class="farm-workspace"><div class="page-head"><div><h1>@d.Reference</h1><p><span data-i18n-enum="asset" data-i18n-value="@d.Status">@d.Status</span> · @d.DisposalDate.ToString("yyyy-MM-dd") · @Model.Asset.AssetCode</p></div><a href="/fixed-assets/@Model.Asset.Id" data-i18n="Asset details">Asset details</a></div><section class="panel"><h2 data-i18n="Disposal review">Disposal review</h2><p><span data-i18n="Buyer / recipient">Buyer / recipient</span>: @d.Counterparty · <span data-i18n="Reason">Reason</span>: @d.Reason</p><p><span data-i18n="Cost">Cost</span> @d.Cost.ToString(fmt) − <span data-i18n="accumulated depreciation">accumulated depreciation</span> @d.AccumulatedDepreciation.ToString(fmt) = <span data-i18n="carrying value">carrying value</span> @d.CurrencyCode @d.CarryingValue.ToString(fmt).</p><p><span data-i18n="Proceeds">Proceeds</span> @d.Proceeds.ToString(fmt) − <span data-i18n="carrying value">carrying value</span> @d.CarryingValue.ToString(fmt) = @if(d.GainLoss>=0){<span data-i18n="gain">gain</span>}else{<span data-i18n="loss">loss</span>} @Math.Abs(d.GainLoss).ToString(fmt).</p><p><span data-i18n="Company policy version">Company policy version</span> @d.BusinessPolicyVersion · <span data-i18n="Prepared by">Prepared by</span> @d.CreatedBy · <span data-i18n="Approved by">Approved by</span> @if(d.ApprovedBy is null){<span data-i18n="Pending">Pending</span>}else{@d.ApprovedBy} · <span data-i18n="Posted by">Posted by</span> @if(d.PostedBy is null){<span data-i18n="Pending">Pending</span>}else{@d.PostedBy}</p><p>@d.ReviewNote</p>@if(d.Status=="Cancelled"){<p><span data-i18n="Cancelled by">Cancelled by</span> @d.CancelledBy: @d.CancellationReason</p>}<h3 data-i18n="Proposed journal">Proposed journal</h3><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Account">Account</th><th data-i18n="Debit">Debit</th><th data-i18n="Credit">Credit</th></tr></thead><tbody><tr><td>@if(d.Settlement=="Cash"){<span data-i18n="1000 Cash / bank">1000 Cash / bank</span>}else{<span data-i18n="1500 Other receivable">1500 Other receivable</span>}</td><td>@d.Proceeds.ToString(fmt)</td><td>0</td></tr><tr><td data-i18n="1690 Accumulated depreciation">1690 Accumulated depreciation</td><td>@d.AccumulatedDepreciation.ToString(fmt)</td><td>0</td></tr><tr><td data-i18n="1600 Asset cost">1600 Asset cost</td><td>0</td><td>@d.Cost.ToString(fmt)</td></tr>@if(d.GainLoss>0){<tr><td data-i18n="4800 Disposal gain">4800 Disposal gain</td><td>0</td><td>@d.GainLoss.ToString(fmt)</td></tr>}@if(d.GainLoss<0){<tr><td data-i18n="6801 Disposal loss">6801 Disposal loss</td><td>@Math.Abs(d.GainLoss).ToString(fmt)</td><td>0</td></tr>}</tbody></table></div><p data-i18n="Zero-value lines are omitted from the posted journal. A zero-cost, zero-proceeds disposal creates no monetary journal.">Zero-value lines are omitted from the posted journal. A zero-cost, zero-proceeds disposal creates no monetary journal.</p>@if(Model.Voucher is not null){<partial name="_Journal" model="Model.Voucher"/>}</section><partial name="_WorkflowActions" model="@(new EnterpriseERP.Web.Controllers.FixedAssetWorkflowActions($"/fixed-assets/disposals/{d.Id}",d.RowVersion,d.Status,Model.Can("FixedAssets.Approve"),Model.Can("FixedAssets.Post"),Model.Can("FixedAssets.Dispose")))"/></section>
