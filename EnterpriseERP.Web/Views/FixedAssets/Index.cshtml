@model EnterpriseERP.Web.Controllers.FixedAssetList
@{ ViewData["Title"] = "Fixed Asset register"; }
<section class="farm-workspace"><div class="page-head"><div><h1 data-i18n="Fixed Asset register">Fixed Asset register</h1><p data-i18n="Reviewed acquisition, custody, depreciation and disposal in the active branch.">Reviewed acquisition, custody, depreciation and disposal in the active branch.</p></div><div><a href="/fixed-assets/depreciation" data-i18n="Depreciation runs">Depreciation runs</a> @if(Model.Can("FixedAssets.Create")){<a class="primary" href="/fixed-assets/new" data-i18n="New acquisition">New acquisition</a>}</div></div>
<section class="panel"><form method="get"><label for="q" data-i18n="Search code, name, serial or custodian">Search code, name, serial or custodian</label><input id="q" name="q" value="@Model.Query" maxlength="160"/><label for="status" data-i18n="Status">Status</label><select id="status" name="status"><option value="" data-i18n="All statuses">All statuses</option>@foreach(var s in new[]{"Draft","Approved","Active","Disposed","Cancelled"}){<option value="@s" selected="@(Model.Status==s?"selected":null)" data-i18n-enum="asset" data-i18n-value="@s">@s</option>}</select><button type="submit" data-i18n="Search">Search</button><a href="/fixed-assets" data-i18n="Reset">Reset</a></form></section>
<section class="panel"><p>@Model.Total <span data-i18n="assets">assets</span> · <span data-i18n="Page">Page</span> @Model.Page <span data-i18n="of">of</span> @Math.Max(1,(Model.Total+24)/25)</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Asset">Asset</th><th data-i18n="Status">Status</th><th data-i18n="Custody">Custody</th><th data-i18n="Cost">Cost</th><th data-i18n="Accumulated depreciation">Accumulated depreciation</th><th data-i18n="Book value">Book value</th><th data-i18n="Policy">Policy</th></tr></thead><tbody>
@foreach(var a in Model.Assets){<tr><td><a href="/fixed-assets/@a.Id">@a.AssetCode · @a.Name</a><br/>@a.Category</td><td><span data-i18n-enum="asset" data-i18n-value="@a.Status">@a.Status</span></td><td>@a.Custodian<br/>@a.Location</td><td>@a.CurrencyCode @a.Cost.ToString($"N{a.CurrencyMinorUnits}")</td><td>@a.AccumulatedDepreciation.ToString($"N{a.CurrencyMinorUnits}")</td><td>@(a.Status=="Disposed"?"0":(a.Cost-a.AccumulatedDepreciation).ToString($"N{a.CurrencyMinorUnits}"))</td><td>@if(a.DepreciationMethod=="None"){<span data-i18n="Non-depreciable">Non-depreciable</span>}else{<span data-i18n="Monthly straight line">Monthly straight line</span>}<br/>@a.UsefulLifeMonths <span data-i18n="months">months</span></td></tr>}
@if(Model.Assets.Count==0){<tr><td colspan="7" data-i18n="No matching assets. Create a reviewed acquisition to start the register.">No matching assets. Create a reviewed acquisition to start the register.</td></tr>}</tbody></table></div><nav aria-label="Asset register pages" data-i18n-aria-label="Asset register pages">@if(Model.Page>1){<a asp-action="Index" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-page="@(Model.Page-1)" data-i18n="Previous">Previous</a>} @if(Model.Page*25<Model.Total){<a asp-action="Index" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-page="@(Model.Page+1)" data-i18n="Next">Next</a>}</nav></section>
<p class="notice" data-i18n="Amounts follow the approved company currency. Drafts and approved acquisitions are not posted book balances. Finance actions record journals only; they never transfer money.">Amounts follow the approved company currency. Drafts and approved acquisitions are not posted book balances. Finance actions record journals only; they never transfer money.</p></section>
