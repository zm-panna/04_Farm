@model EnterpriseERP.Web.Controllers.FixedAssetCustodyEditor
@{ViewData["Title"]="Record custody change";}
<section class="farm-workspace"><div class="page-head"><h1><span data-i18n="Record custody change">Record custody change</span>: @Model.Asset.AssetCode</h1><a href="/fixed-assets/@Model.Asset.Id" data-i18n="Asset details">Asset details</a></div><div asp-validation-summary="All" class="notice" role="alert"></div><section class="panel"><p><span data-i18n="Current custody">Current custody</span>: @Model.Asset.Custodian · @Model.Asset.Location. <span data-i18n="This changes custody within the active branch; it does not transfer the asset between company books.">This changes custody within the active branch; it does not transfer the asset between company books.</span></p><form method="post" action="/fixed-assets/@Model.Asset.Id/custody">@Html.AntiForgeryToken()<input name="Input.RowVersion" value="@Convert.ToBase64String(Model.Input.RowVersion)" type="hidden"/><label asp-for="Input.EffectiveDate" data-i18n="Effective date">Effective date</label><input asp-for="Input.EffectiveDate" type="date" required/><label asp-for="Input.Custodian" data-i18n="New custodian">New custodian</label><input asp-for="Input.Custodian" maxlength="160" required/><label asp-for="Input.Location" data-i18n="New location in this branch">New location in this branch</label><input asp-for="Input.Location" maxlength="160" required/><label asp-for="Input.Reason" data-i18n="Reason / handover evidence">Reason / handover evidence</label><textarea asp-for="Input.Reason" maxlength="1000" required></textarea><button class="primary" type="submit" data-i18n="Record custody event">Record custody event</button> <a href="/fixed-assets/@Model.Asset.Id" data-i18n="Cancel without saving">Cancel without saving</a></form></section></section>
