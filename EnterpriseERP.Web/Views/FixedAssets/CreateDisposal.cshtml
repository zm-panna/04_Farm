@model EnterpriseERP.Web.Controllers.FixedAssetDisposalEditor
@{ViewData["Title"]="Prepare fixed asset disposal";var a=Model.Asset;}
<section class="farm-workspace"><div class="page-head"><h1><span data-i18n="Prepare disposal">Prepare disposal</span>: @a.AssetCode · @a.Name</h1><a href="/fixed-assets/@a.Id" data-i18n="Asset details">Asset details</a></div><div asp-validation-summary="All" class="notice" role="alert"></div><section class="panel"><p><span data-i18n="Current carrying value">Current carrying value</span>: @a.CurrencyCode @((a.Cost-a.AccumulatedDepreciation).ToString($"N{a.CurrencyMinorUnits}"))</p><p data-i18n="Post any missing depreciation through the previous month first. Disposal does not calculate a partial-month charge. A different reviewer approves this preview before the asset is derecognized. No money is sent or collected.">Post any missing depreciation through the previous month first. Disposal does not calculate a partial-month charge. A different reviewer approves this preview before the asset is derecognized. No money is sent or collected.</p><form method="post" action="/fixed-assets/@a.Id/dispose">@Html.AntiForgeryToken()<input name="Input.AssetRowVersion" value="@Convert.ToBase64String(Model.Input.AssetRowVersion)" type="hidden"/><label asp-for="Input.Reference" data-i18n="Unique disposal reference">Unique disposal reference</label><input asp-for="Input.Reference" maxlength="80" required/><label asp-for="Input.DisposalDate" data-i18n="Disposal date">Disposal date</label><input asp-for="Input.DisposalDate" type="date" required/><label asp-for="Input.Counterparty" data-i18n="Buyer / disposal recipient">Buyer / disposal recipient</label><input asp-for="Input.Counterparty" maxlength="160" required/><label asp-for="Input.Proceeds"><span data-i18n="Recorded proceeds in">Recorded proceeds in</span> @a.CurrencyCode</label><input asp-for="Input.Proceeds" type="number" min="0" step="0.001" required/><label asp-for="Input.Settlement" data-i18n="Recorded settlement">Recorded settlement</label><select asp-for="Input.Settlement" required><option value="" data-i18n="Choose explicitly">Choose explicitly</option><option value="Cash" data-i18n="Cash / bank received (1000)">Cash / bank received (1000)</option><option value="Receivable" data-i18n="Other receivable (1500)">Other receivable (1500)</option></select><label asp-for="Input.Reason" data-i18n="Reason and supporting evidence">Reason and supporting evidence</label><textarea asp-for="Input.Reason" maxlength="1000" required></textarea><button class="primary" type="submit" data-i18n="Save disposal preview for review">Save disposal preview for review</button> <a href="/fixed-assets/@a.Id" data-i18n="Cancel without saving">Cancel without saving</a></form></section></section>
