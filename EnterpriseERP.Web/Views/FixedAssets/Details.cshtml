@model EnterpriseERP.Web.Controllers.FixedAssetDetail
@{ ViewData["Title"] = "Fixed asset details"; var a=Model.Asset; var fmt=$"N{a.CurrencyMinorUnits}"; }
<section class="farm-workspace"><div class="page-head"><div><h1>@a.AssetCode · @a.Name</h1><p><span data-i18n-enum="asset" data-i18n-value="@a.Status">@a.Status</span> · @a.Category · @a.SerialNumber</p></div><a href="/fixed-assets" data-i18n="Register">Register</a></div>
<section class="panel"><h2 data-i18n="Acquisition and approved estimates">Acquisition and approved estimates</h2><p><span data-i18n="Source reference">Source reference</span>: @a.SourceReference · <span data-i18n="Acquisition date">Acquisition date</span>: @a.AcquisitionDate.ToString("yyyy-MM-dd")</p><p><span data-i18n="Cost">Cost</span>: @a.CurrencyCode @a.Cost.ToString(fmt) · <span data-i18n="Accumulated depreciation">Accumulated depreciation</span>: @a.AccumulatedDepreciation.ToString(fmt) · @if(a.Status=="Disposed"){<span data-i18n="Carrying value at disposal">Carrying value at disposal</span>}else{<span data-i18n="Book value">Book value</span>}: @((a.Cost-a.AccumulatedDepreciation).ToString(fmt))</p><p><span data-i18n="Method">Method</span>: @if(a.DepreciationMethod=="None"){<span data-i18n="Non-depreciable">Non-depreciable</span>}else{<span data-i18n="Monthly straight line">Monthly straight line</span>} · <span data-i18n="Life">Life</span>: @a.UsefulLifeMonths <span data-i18n="months">months</span> · <span data-i18n="Residual">Residual</span>: @a.ResidualValue.ToString(fmt) · <span data-i18n="Start">Start</span>: @a.DepreciationStart.ToString("yyyy-MM-dd")</p><p><span data-i18n="Policy rationale">Policy rationale</span>: @a.PolicyReason</p><p><span data-i18n="Company business policy version">Company business policy version</span>: @a.BusinessPolicyVersion · @a.CurrencyCode (@a.CurrencyMinorUnits <span data-i18n="decimal places">decimal places</span>)</p><p><span data-i18n="Prepared by">Prepared by</span> @a.CreatedBy <span data-i18n="at">at</span> @a.CreatedUtc.ToString("u") · <span data-i18n="Approved by">Approved by</span> @if(a.ApprovedBy is null){<span data-i18n="Pending">Pending</span>}else{@a.ApprovedBy} · <span data-i18n="Posted by">Posted by</span> @if(a.PostedBy is null){<span data-i18n="Pending">Pending</span>}else{@a.PostedBy}</p>@if(a.ApprovedUtc.HasValue){<p><span data-i18n="Approved at">Approved at</span> @a.ApprovedUtc.Value.ToString("u"): @a.ReviewNote</p>}@if(a.Status=="Cancelled"){<p><span data-i18n="Cancelled by">Cancelled by</span> @a.CancelledBy: @a.CancellationReason</p>}@if(a.DisposedOn.HasValue){<p><span data-i18n="Disposed on">Disposed on</span> @a.DisposedOn.Value.ToString("yyyy-MM-dd"). <span data-i18n="Remaining active-register book value is zero; historical cost and depreciation remain visible.">Remaining active-register book value is zero; historical cost and depreciation remain visible.</span></p>}<p>@a.Notes</p>
@if(Model.Can("FixedAssets.Edit") && a.Status!="Cancelled"){<a href="/fixed-assets/@a.Id/edit" data-i18n="Edit descriptive metadata">Edit descriptive metadata</a>}
@if(a.Status=="Draft" || a.Status=="Approved"){<h3 data-i18n="Proposed acquisition journal">Proposed acquisition journal</h3><p><span data-i18n="Debit 1600 asset cost">Debit 1600 asset cost</span> @a.Cost.ToString(fmt); <span data-i18n="credit">credit</span> @if(a.AcquisitionSettlement=="Cash"){<span data-i18n="1000 cash/bank">1000 cash/bank</span>}else{<span data-i18n="2500 other payable">2500 other payable</span>} @a.Cost.ToString(fmt).</p><p data-i18n="Zero-cost assets have no monetary journal. Financial source facts cannot be edited; cancel and recreate an unposted draft when needed.">Zero-cost assets have no monetary journal. Financial source facts cannot be edited; cancel and recreate an unposted draft when needed.</p>}
@foreach(var v in Model.Vouchers){<partial name="_Journal" model="v"/>}</section>
<partial name="_WorkflowActions" model="@(new EnterpriseERP.Web.Controllers.FixedAssetWorkflowActions($"/fixed-assets/{a.Id}",a.RowVersion,a.Status,Model.Can("FixedAssets.Approve"),Model.Can("FixedAssets.Post"),Model.Can("FixedAssets.Create")))"/>
<section class="panel"><h2 data-i18n="Custody history">Custody history</h2><p><span data-i18n="Current custodian">Current custodian</span>: @a.Custodian · <span data-i18n="Location">Location</span>: @a.Location</p>@if(a.Status=="Active" && Model.Can("FixedAssets.Custody")){<a href="/fixed-assets/@a.Id/custody" data-i18n="Record custody change">Record custody change</a>}<div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Effective date">Effective date</th><th data-i18n="From">From</th><th data-i18n="To">To</th><th data-i18n="Reason / recorded by">Reason / recorded by</th></tr></thead><tbody>@foreach(var c in Model.Custody){<tr><td>@c.EffectiveDate.ToString("yyyy-MM-dd")</td><td>@c.PreviousCustodian · @c.PreviousLocation</td><td>@c.Custodian · @c.Location</td><td>@c.Reason<br/>@c.RecordedBy</td></tr>}@if(Model.Custody.Count==0){<tr><td colspan="4" data-i18n="Custody history starts when acquisition is posted.">Custody history starts when acquisition is posted.</td></tr>}</tbody></table></div></section>
<section class="panel"><h2 data-i18n="Posted depreciation">Posted depreciation</h2><a href="/fixed-assets/depreciation" data-i18n="View depreciation runs">View depreciation runs</a><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Period">Period</th><th data-i18n="Charge">Charge</th><th data-i18n="Accumulated after">Accumulated after</th><th data-i18n="Run">Run</th></tr></thead><tbody>@foreach(var d in Model.Depreciation){<tr><td>@d.Period.ToString("yyyy-MM-dd")</td><td>@d.Amount.ToString(fmt)</td><td>@d.AccumulatedAfter.ToString(fmt)</td><td><a href="/fixed-assets/depreciation/@d.FixedAssetDepreciationRunId"><span data-i18n="Review run">Review run</span> @d.FixedAssetDepreciationRunId</a></td></tr>}@if(Model.Depreciation.Count==0){<tr><td colspan="4" data-i18n="No posted depreciation.">No posted depreciation.</td></tr>}</tbody></table></div></section>
<section class="panel"><h2 data-i18n="Disposal history">Disposal history</h2>@if(a.Status=="Active" && Model.Can("FixedAssets.Dispose") && !Model.Disposals.Any(x=>x.Status!="Cancelled")){<a href="/fixed-assets/@a.Id/dispose" data-i18n="Prepare disposal for review">Prepare disposal for review</a>}@foreach(var d in Model.Disposals){<p><a href="/fixed-assets/disposals/@d.Id">@d.Reference</a> · <span data-i18n-enum="asset" data-i18n-value="@d.Status">@d.Status</span> · @d.DisposalDate.ToString("yyyy-MM-dd") · <span data-i18n="Proceeds">Proceeds</span> @d.CurrencyCode @d.Proceeds.ToString(fmt)</p>}@if(Model.Disposals.Count==0){<p data-i18n="No disposal records.">No disposal records.</p>}</section></section>
