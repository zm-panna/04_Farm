@model EnterpriseERP.Web.Controllers.FixedAssetRunList
@{ViewData["Title"]="Depreciation runs";}
<section class="farm-workspace"><div class="page-head"><h1 data-i18n="Depreciation runs">Depreciation runs</h1><div><a href="/fixed-assets" data-i18n="Asset register">Asset register</a> @if(Model.Can("FixedAssets.Depreciate")){<a href="/fixed-assets/depreciation/new" class="primary" data-i18n="Prepare monthly run">Prepare monthly run</a>}</div></div><section class="panel"><form method="get"><label for="q" data-i18n="Reference">Reference</label><input name="q" id="q" value="@Model.Query"/><label for="status" data-i18n="Status">Status</label><select name="status" id="status"><option value="" data-i18n="All statuses">All statuses</option>@foreach(var s in new[]{"Draft","Approved","Posted","Cancelled"}){<option value="@s" selected="@(s==Model.Status?"selected":null)" data-i18n-enum="asset" data-i18n-value="@s">@s</option>}</select><button type="submit" data-i18n="Search">Search</button><a href="/fixed-assets/depreciation" data-i18n="Reset">Reset</a></form></section><section class="panel"><p>@Model.Total <span data-i18n="runs">runs</span> · <span data-i18n="Page">Page</span> @Model.Page <span data-i18n="of">of</span> @Math.Max(1,(Model.Total+24)/25)</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Reference">Reference</th><th data-i18n="Period">Period</th><th data-i18n="Status">Status</th><th data-i18n="Total">Total</th><th data-i18n="Prepared / approved by">Prepared / approved by</th></tr></thead><tbody>@foreach(var r in Model.Runs){<tr><td><a href="/fixed-assets/depreciation/@r.Id">@r.Reference</a></td><td>@r.Period.ToString("yyyy-MM-dd")</td><td><span data-i18n-enum="asset" data-i18n-value="@r.Status">@r.Status</span></td><td>@r.CurrencyCode @r.Total.ToString($"N{r.CurrencyMinorUnits}")</td><td>@r.CreatedBy / @if(r.ApprovedBy is null){<span data-i18n="Pending">Pending</span>}else{@r.ApprovedBy}</td></tr>}@if(Model.Runs.Count==0){<tr><td colspan="5" data-i18n="No matching depreciation runs.">No matching depreciation runs.</td></tr>}</tbody></table></div><nav aria-label="Depreciation run pages" data-i18n-aria-label="Depreciation run pages">@if(Model.Page>1){<a asp-action="Runs" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-page="@(Model.Page-1)" data-i18n="Previous">Previous</a>} @if(Model.Page*25<Model.Total){<a asp-action="Runs" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-page="@(Model.Page+1)" data-i18n="Next">Next</a>}</nav></section></section>
