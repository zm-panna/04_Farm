@model EnterpriseERP.Domain.Voucher
<h3><span data-i18n="Posted journal">Posted journal</span> @Model.Reference (#@Model.Id)</h3><p>@Model.Date.ToString("yyyy-MM-dd")</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Account">Account</th><th data-i18n="Debit">Debit</th><th data-i18n="Credit">Credit</th></tr></thead><tbody>@foreach(var line in Model.Lines.OrderBy(x=>x.Id)){<tr><td>@line.AccountCode</td><td>@line.Debit.ToString("N3")</td><td>@line.Credit.ToString("N3")</td></tr>}</tbody><tfoot><tr><th data-i18n="Total">Total</th><td>@Model.Lines.Sum(x=>x.Debit).ToString("N3")</td><td>@Model.Lines.Sum(x=>x.Credit).ToString("N3")</td></tr></tfoot></table></div>
