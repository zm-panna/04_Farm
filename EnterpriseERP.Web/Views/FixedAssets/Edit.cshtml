@model FixedAssetMetadataInput
@{ ViewData["Title"]="Edit fixed asset metadata"; }
<section class="farm-workspace"><div class="page-head"><h1 data-i18n="Edit fixed asset metadata">Edit fixed asset metadata</h1><a href="/fixed-assets/@Model.Id" data-i18n="Return to asset / reload current record">Return to asset / reload current record</a></div><div asp-validation-summary="All" class="notice" role="alert"></div><section class="panel"><p data-i18n="Only descriptive fields can change. Custody uses its own append-only history; approved cost and depreciation estimates are locked.">Only descriptive fields can change. Custody uses its own append-only history; approved cost and depreciation estimates are locked.</p><form method="post" action="/fixed-assets/@Model.Id/edit">@Html.AntiForgeryToken()<input name="RowVersion" value="@Convert.ToBase64String(Model.RowVersion)" type="hidden"/><label asp-for="Name" data-i18n="Name">Name</label><input asp-for="Name" maxlength="160" required/><label asp-for="Category" data-i18n="Category">Category</label><input asp-for="Category" maxlength="120" required/><label asp-for="SerialNumber" data-i18n="Serial number">Serial number</label><input asp-for="SerialNumber" maxlength="160"/><label asp-for="Notes" data-i18n="Notes">Notes</label><textarea asp-for="Notes" maxlength="1000"></textarea><button class="primary" type="submit" data-i18n="Save metadata">Save metadata</button> <a href="/fixed-assets/@Model.Id" data-i18n="Cancel without saving">Cancel without saving</a></form></section></section>
