@model FixedAssetInput
@{ ViewData["Title"] = "New fixed asset acquisition"; }
<section class="farm-workspace"><div class="page-head"><h1 data-i18n="New fixed asset acquisition">New fixed asset acquisition</h1><a href="/fixed-assets" data-i18n="Register">Register</a></div>
<div asp-validation-summary="All" class="notice" role="alert"></div><form method="post" action="/fixed-assets/new">@Html.AntiForgeryToken()
<section class="panel"><h2 data-i18n="Source and carrying cost">Source and carrying cost</h2><p data-i18n="Enter the accountant-reviewed book carrying cost, including only the acquisition costs and non-recoverable tax they approve. This workflow does not calculate recoverable VAT, sales tax or statutory capital allowances.">Enter the accountant-reviewed book carrying cost, including only the acquisition costs and non-recoverable tax they approve. This workflow does not calculate recoverable VAT, sales tax or statutory capital allowances.</p>
<label asp-for="AssetCode" data-i18n="Unique asset code">Unique asset code</label><input asp-for="AssetCode" maxlength="60" required/><label asp-for="Name" data-i18n="Name">Name</label><input asp-for="Name" maxlength="160" required/><label asp-for="Category" data-i18n="Category">Category</label><input asp-for="Category" maxlength="120" required/><label asp-for="SerialNumber" data-i18n="Serial number">Serial number</label><input asp-for="SerialNumber" maxlength="160"/>
<label asp-for="SourceReference" data-i18n="Unique source / invoice reference">Unique source / invoice reference</label><input asp-for="SourceReference" maxlength="80" required/><label asp-for="AcquisitionDate" data-i18n="Acquisition date">Acquisition date</label><input asp-for="AcquisitionDate" type="date" required/><label asp-for="Cost" data-i18n="Acquisition carrying cost in company currency">Acquisition carrying cost in company currency</label><input asp-for="Cost" type="number" min="0" step="0.001" required/>
<label asp-for="AcquisitionSettlement" data-i18n="Recorded funding">Recorded funding</label><select asp-for="AcquisitionSettlement" required><option value="" data-i18n="Choose explicitly">Choose explicitly</option><option value="Cash" data-i18n="Cash / bank recorded (1000)">Cash / bank recorded (1000)</option><option value="Payable" data-i18n="Other payable recorded (2500)">Other payable recorded (2500)</option></select><p data-i18n="Acquisition journal: debit asset cost 1600; credit the selected funding account. No payment is made.">Acquisition journal: debit asset cost 1600; credit the selected funding account. No payment is made.</p></section>
<section class="panel"><h2 data-i18n="Explicit book depreciation policy">Explicit book depreciation policy</h2><p data-i18n="No statutory rate is supplied. A different authorized reviewer must approve these estimates before acquisition posting. Straight line uses completed calendar months with no inferred partial-month charge; choose the first day of the approved starting month on or after acquisition.">No statutory rate is supplied. A different authorized reviewer must approve these estimates before acquisition posting. Straight line uses completed calendar months with no inferred partial-month charge; choose the first day of the approved starting month on or after acquisition.</p>
<label asp-for="DepreciationMethod" data-i18n="Method">Method</label><select asp-for="DepreciationMethod" required><option value="" data-i18n="Choose explicitly">Choose explicitly</option><option value="StraightLineMonthly" data-i18n="Straight line, full monthly periods">Straight line, full monthly periods</option><option value="None" data-i18n="Non-depreciable, reviewed reason required">Non-depreciable, reviewed reason required</option></select><label asp-for="UsefulLifeMonths" data-i18n="Useful life in months (0 only for non-depreciable)">Useful life in months (0 only for non-depreciable)</label><input asp-for="UsefulLifeMonths" type="number" min="0" max="1200" required/><label asp-for="ResidualValue" data-i18n="Residual value">Residual value</label><input asp-for="ResidualValue" type="number" min="0" step="0.001" required/><label asp-for="DepreciationStart" data-i18n="Depreciation start date">Depreciation start date</label><input asp-for="DepreciationStart" type="date" required/><label asp-for="PolicyReason" data-i18n="Policy rationale and source evidence">Policy rationale and source evidence</label><textarea asp-for="PolicyReason" maxlength="1000" required></textarea><p data-i18n="For non-depreciable assets, use life 0 and residual equal to cost. Currency precision is validated against the company's approved policy.">For non-depreciable assets, use life 0 and residual equal to cost. Currency precision is validated against the company's approved policy.</p></section>
<section class="panel"><h2 data-i18n="Initial custody">Initial custody</h2><label asp-for="Custodian" data-i18n="Custodian">Custodian</label><input asp-for="Custodian" maxlength="160" required/><label asp-for="Location" data-i18n="Location in this branch">Location in this branch</label><input asp-for="Location" maxlength="160" required/><label asp-for="Notes" data-i18n="Notes">Notes</label><textarea asp-for="Notes" maxlength="1000"></textarea><button class="primary" type="submit" data-i18n="Save acquisition draft for review">Save acquisition draft for review</button> <a href="/fixed-assets" data-i18n="Cancel without saving">Cancel without saving</a></section></form></section>
