@model EnterpriseERP.Web.Controllers.FixedAssetRunDetail
@{ViewData["Title"]="Review depreciation run";var r=Model.Run;var fmt=$"N{r.CurrencyMinorUnits}";}
<section class="farm-workspace"><div class="page-head"><div><h1>@r.Reference</h1><p><span data-i18n-enum="asset" data-i18n-value="@r.Status">@r.Status</span> · <span data-i18n="Period">Period</span> @r.Period.ToString("yyyy-MM-dd")</p></div><a href="/fixed-assets/depreciation" data-i18n="Run history">Run history</a></div><section class="panel"><h2 data-i18n="Reviewed depreciation preview">Reviewed depreciation preview</h2><p><span data-i18n="Total">Total</span>: @r.CurrencyCode @r.Total.ToString(fmt) · <span data-i18n="Company policy version">Company policy version</span> @r.BusinessPolicyVersion</p><p><span data-i18n="Prepared by">Prepared by</span> @r.CreatedBy <span data-i18n="at">at</span> @r.CreatedUtc.ToString("u") · <span data-i18n="Approved by">Approved by</span> @if(r.ApprovedBy is null){<span data-i18n="Pending">Pending</span>}else{@r.ApprovedBy} · <span data-i18n="Posted by">Posted by</span> @if(r.PostedBy is null){<span data-i18n="Pending">Pending</span>}else{@r.PostedBy}</p><p>@r.ReviewNote</p>@if(r.Status=="Cancelled"){<p><span data-i18n="Cancelled by">Cancelled by</span> @r.CancelledBy: @r.CancellationReason</p>}<p data-i18n="Journal: debit 6800 depreciation expense; credit 1690 accumulated depreciation. Zero-rounded runs advance the reviewed period without a fake zero-value journal.">Journal: debit 6800 depreciation expense; credit 1690 accumulated depreciation. Zero-rounded runs advance the reviewed period without a fake zero-value journal.</p><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Asset">Asset</th><th data-i18n="Cost">Cost</th><th data-i18n="Residual floor">Residual floor</th><th data-i18n="Accumulated before">Accumulated before</th><th data-i18n="This period">This period</th><th data-i18n="Accumulated after">Accumulated after</th><th data-i18n="Book value after">Book value after</th></tr></thead><tbody>@foreach(var l in r.Lines.OrderBy(x=>x.AssetCode)){<tr><td><a href="/fixed-assets/@l.FixedAssetId">@l.AssetCode</a></td><td>@l.Cost.ToString(fmt)</td><td>@l.ResidualValue.ToString(fmt)</td><td>@l.AccumulatedBefore.ToString(fmt)</td><td>@l.Amount.ToString(fmt)</td><td>@l.AccumulatedAfter.ToString(fmt)</td><td>@((l.Cost-l.AccumulatedAfter).ToString(fmt))</td></tr>}</tbody></table></div>@if(Model.Voucher is not null){<partial name="_Journal" model="Model.Voucher"/>}</section><partial name="_WorkflowActions" model="@(new EnterpriseERP.Web.Controllers.FixedAssetWorkflowActions($"/fixed-assets/depreciation/{r.Id}",r.RowVersion,r.Status,Model.Can("FixedAssets.Approve"),Model.Can("FixedAssets.Post"),Model.Can("FixedAssets.Depreciate")))"/></section>
