@model EnterpriseERP.Web.Controllers.FixedAssetWorkflowActions
@if(Model.Status=="Draft" && Model.CanApprove){<section class="panel"><h2 data-i18n="Independent review">Independent review</h2><p data-i18n="A different user from the preparer must review the source evidence, policy, amounts and proposed journal.">A different user from the preparer must review the source evidence, policy, amounts and proposed journal.</p><form method="post" action="@(Model.Path+"/approve")">@Html.AntiForgeryToken()<input name="RowVersion" value="@Convert.ToBase64String(Model.Token)" type="hidden"/><label for="approval-note" data-i18n="Review note">Review note</label><textarea id="approval-note" name="ReviewNote" maxlength="1000" required></textarea><label><input type="checkbox" name="ConfirmReviewed" value="true" required/> <span data-i18n="I reviewed the source evidence, policy, amounts and journal.">I reviewed the source evidence, policy, amounts and journal.</span></label><button type="submit" class="primary" data-i18n="Approve reviewed record">Approve reviewed record</button></form></section>}
@if(Model.Status=="Approved" && Model.CanPost){<section class="panel"><h2 data-i18n="Post approved record">Post approved record</h2><p data-i18n="Posting is atomic and cannot be undone here. Current asset values, open accounting period and approved policy are checked again. This records accounting only; no money is transferred.">Posting is atomic and cannot be undone here. Current asset values, open accounting period and approved policy are checked again. This records accounting only; no money is transferred.</p><form method="post" action="@(Model.Path+"/post")">@Html.AntiForgeryToken()<input name="RowVersion" value="@Convert.ToBase64String(Model.Token)" type="hidden"/><button type="submit" class="primary" data-i18n="Post approved recorded journal">Post approved recorded journal</button></form></section>}
@if((Model.Status=="Draft" || Model.Status=="Approved") && Model.CanCancel){<section class="panel"><h2 data-i18n="Cancel unposted draft">Cancel unposted draft</h2><p data-i18n="The cancellation and original source reference remain in the history. No accounting entry is posted.">The cancellation and original source reference remain in the history. No accounting entry is posted.</p><form method="post" action="@(Model.Path+"/cancel")">@Html.AntiForgeryToken()<input name="RowVersion" value="@Convert.ToBase64String(Model.Token)" type="hidden"/><label for="cancel-note" data-i18n="Cancellation reason">Cancellation reason</label><textarea id="cancel-note" name="ReviewNote" maxlength="1000" required></textarea><button type="submit" data-i18n="Cancel this unposted record">Cancel this unposted record</button></form></section>}
