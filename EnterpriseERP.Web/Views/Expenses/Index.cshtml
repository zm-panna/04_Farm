@model EnterpriseERP.Web.ExpensesPage
@{ ViewData["Title"] = "Farm Expenses"; var tags = Model.Animals.ToDictionary(x => x.Id, x => x.Tag); }
<div class="page-header"><div><span class="eyebrow" data-business-i18n="Farm cash expenditure">Farm cash expenditure</span><h1 data-business-i18n="Farm Expenses">Farm Expenses</h1><p class="subtle" data-i18n="Post an expense with an auditable, balanced accounting voucher.">Post an expense with an auditable, balanced accounting voucher.</p></div><a class="muted-btn" href="/Fattening" data-business-i18n="Growth &amp; margins">Growth &amp; margins</a></div>
<div asp-validation-summary="All" class="notice" role="alert"></div>
<p class="notice" data-i18n="This form records an already-paid cash expense: debit the selected expense category, credit cash/bank account 1000. Customer account mappings must be reviewed before live use. Do not re-enter feed stock issues or supplier payments here; those have their own ledgers. Corrections require a controlled accounting adjustment.">This form records an already-paid cash expense: debit the selected expense category, credit cash/bank account 1000. Customer account mappings must be reviewed before live use. Do not re-enter feed stock issues or supplier payments here; those have their own ledgers. Corrections require a controlled accounting adjustment.</p>
<div class="panels"><section class="panel"><h2 data-business-i18n="New paid expense">New paid expense</h2>
<form method="post" action="/Expenses/record">@Html.AntiForgeryToken()
<label asp-for="Expense.Reference" data-business-i18n="Unique reference / receipt number">Unique reference / receipt number</label><input asp-for="Expense.Reference" maxlength="85" required />
<label asp-for="Expense.ExpenseDate" data-business-i18n="Expense date">Expense date</label><input asp-for="Expense.ExpenseDate" type="date" required />
<label asp-for="Expense.Category" data-business-i18n="Category">Category</label><select asp-for="Expense.Category">@foreach (var category in FarmBusinessRules.ExpenseAccounts) { <option value="@category.Key" data-i18n="@(category.Key + " (" + category.Value + ")")">@category.Key (@category.Value)</option> }</select>
<label asp-for="Expense.AnimalId" data-business-i18n="Assign cost to animal (optional)">Assign cost to animal (optional)</label><select asp-for="Expense.AnimalId"><option value="" data-business-i18n="Shared branch expense">Shared branch expense</option>@foreach (var a in Model.Animals) { <option value="@a.Id">@a.Tag @(a.Sold ? "(sold)" : "")</option> }</select>
<label asp-for="Expense.Amount" data-business-i18n="Paid amount (accounting currency)">Paid amount (accounting currency)</label><input asp-for="Expense.Amount" type="number" min="0.001" max="1000000000000" step="0.001" required />
<label asp-for="Expense.Description" data-business-i18n="Description">Description</label><textarea asp-for="Expense.Description" maxlength="1000" rows="4" required></textarea>
<button type="submit" class="primary" data-business-i18n="Post expense &amp; voucher">Post expense &amp; voucher</button></form></section>
<section class="panel"><h2 data-business-i18n="Expense summary">Expense summary</h2><form method="get" action="/Expenses"><label asp-for="From" data-business-i18n="From">From</label><input asp-for="From" type="date" name="from" required /><label asp-for="To" data-business-i18n="Through">Through</label><input asp-for="To" type="date" name="to" required /><button type="submit" class="muted-btn" data-business-i18n="Filter expenses">Filter expenses</button></form>
<p class="subtle">@Model.From.ToString("yyyy-MM-dd") <span data-i18n="Through">Through</span> @Model.To.ToString("yyyy-MM-dd")</p><h2>@Model.Total.ToString("N3") <span data-i18n="Total">Total</span></h2><p>@Model.Records.Count <span data-i18n="posted expenses">posted expenses</span></p>
<div class="farm-table"><table class="data-table"><thead><tr><th data-business-i18n="Category">Category</th><th data-business-i18n="Amount">Amount</th></tr></thead><tbody>@foreach (var group in Model.Records.GroupBy(x => x.Category).OrderBy(x => x.Key)) { <tr><td data-i18n="@group.Key">@group.Key</td><td>@group.Sum(x => x.Amount).ToString("N3")</td></tr> }</tbody></table></div></section></div>
<section class="panel"><h2 data-business-i18n="Posted expense ledger">Posted expense ledger</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-business-i18n="Date / reference">Date / reference</th><th data-business-i18n="Category">Category</th><th data-business-i18n="Animal">Animal</th><th data-business-i18n="Description">Description</th><th data-business-i18n="Amount">Amount</th><th data-business-i18n="Voucher">Voucher</th></tr></thead><tbody>
@foreach (var e in Model.Records) { <tr><td>@e.ExpenseDate.ToString("yyyy-MM-dd")<br/>@e.Reference</td><td data-i18n="@e.Category">@e.Category</td><td>@(e.AnimalId.HasValue ? tags.GetValueOrDefault(e.AnimalId.Value, e.AnimalId.Value.ToString()) : "Shared branch")</td><td>@e.Description</td><td>@e.Amount.ToString("N3")</td><td>#@e.VoucherId<br/>EXP:@e.Reference</td></tr> }
@if (Model.Records.Count == 0) { <tr><td colspan="6"><span data-i18n="No expenses in the selected range.">No expenses in the selected range.</span></td></tr> }
</tbody></table></div></section>


