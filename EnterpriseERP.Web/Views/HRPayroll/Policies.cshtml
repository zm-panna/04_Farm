@model EnterpriseERP.Web.Controllers.HRPayrollPolicyPage
@{ViewData["Title"]="Reviewed payroll policies";}
<h1 data-i18n="Payroll policy versions">Payroll policy versions</h1><partial name="_Nav" />
<div class="notice" data-i18n="No statutory payroll rate is assumed. Daily and monthly pay are supported with an explicitly reviewed proration method. Paid rest days must be entered as paid attendance; no weekend or statutory rule is assumed. A qualified reviewer must confirm jurisdiction-specific treatment before use. Zero deductions also require explicit review. No claim of statutory filing or tax compliance is made.">No statutory payroll rate is assumed. Daily and monthly pay are supported with an explicitly reviewed proration method. Paid rest days must be entered as paid attendance; no weekend or statutory rule is assumed. A qualified reviewer must confirm jurisdiction-specific treatment before use. Zero deductions also require explicit review. No claim of statutory filing or tax compliance is made.</div>
<details open="@(!ViewData.ModelState.IsValid)"><summary data-i18n="Propose a new policy (Payroll.Policy)">Propose a new policy (Payroll.Policy)</summary><form asp-action="CreatePolicy" method="post" class="panel">
<label asp-for="Entry.Name" data-i18n="Policy name / version description">Policy name / version description</label><input asp-for="Entry.Name" required maxlength="200" />
<label asp-for="Entry.PayBasis" data-i18n="Pay basis for this branch payroll run">Pay basis for this branch payroll run</label><select asp-for="Entry.PayBasis" required><option value="" data-i18n="Select explicitly">Select explicitly</option><option value="Daily" data-i18n="Daily">Daily</option><option value="Monthly" data-i18n="Monthly">Monthly</option><option value="Mixed" data-i18n="Mixed daily and monthly contracts">Mixed daily and monthly contracts</option></select>
<label asp-for="Entry.MonthlyProrationMode" data-i18n="Monthly proration denominator">Monthly proration denominator</label><select asp-for="Entry.MonthlyProrationMode" required><option value="" data-i18n="Select explicitly">Select explicitly</option><option value="NotApplicable" data-i18n="NotApplicable">NotApplicable</option><option value="ActualCalendarDays" data-i18n="Actual calendar days in the payroll month">Actual calendar days in the payroll month</option><option value="FixedPaidUnits" data-i18n="Explicit fixed paid units">Explicit fixed paid units</option></select>
<label asp-for="Entry.MonthlyFixedUnits" data-i18n="Fixed monthly paid units (zero for actual calendar days)">Fixed monthly paid units (zero for actual calendar days)</label><input asp-for="Entry.MonthlyFixedUnits" type="number" min="0" max="366" step="0.001" required />
<label for="Entry_CapMonthlyPaidUnits" data-i18n="Cap monthly paid units at the denominator">Cap monthly paid units at the denominator</label><select id="Entry_CapMonthlyPaidUnits" name="Entry.CapMonthlyPaidUnits" required><option value="" selected="@(string.IsNullOrEmpty(Model.Entry.PayBasis))" data-i18n="Select explicitly">Select explicitly</option><option value="true" selected="@(!string.IsNullOrEmpty(Model.Entry.PayBasis)&&Model.Entry.CapMonthlyPaidUnits)" data-i18n="Yes">Yes</option><option value="false" selected="@(!string.IsNullOrEmpty(Model.Entry.PayBasis)&&!Model.Entry.CapMonthlyPaidUnits)" data-i18n="No">No</option></select>
<p data-i18n="A Mixed policy uses each employee’s explicitly reviewed Daily or Monthly contract basis in one payroll run.">A Mixed policy uses each employee’s explicitly reviewed Daily or Monthly contract basis in one payroll run.</p>
<p data-i18n="Monthly base pay is salary multiplied by paid units and divided by the reviewed denominator. Daily policies ignore monthly controls.">Monthly base pay is salary multiplied by paid units and divided by the reviewed denominator. Daily policies ignore monthly controls.</p>
<p data-i18n="Without the cap, a fixed denominator smaller than paid units produces more than the monthly salary. Review this choice explicitly.">Without the cap, a fixed denominator smaller than paid units produces more than the monthly salary. Review this choice explicitly.</p>
<label asp-for="Entry.Currency" data-i18n="Approved company currency (three letters)">Approved company currency (three letters)</label><input asp-for="Entry.Currency" required maxlength="3" minlength="3" placeholder="No default" data-i18n-placeholder="No default" />
<label asp-for="Entry.CurrencyDecimals" data-i18n="Approved currency decimal places">Approved currency decimal places</label><select asp-for="Entry.CurrencyDecimals" required><option value="" data-i18n="Select explicitly">Select explicitly</option>@foreach(var units in new[]{0,1,2,3}){<option value="@units">@units</option>}</select>
<label asp-for="Entry.EffectiveFrom" data-i18n="Effective from">Effective from</label><input asp-for="Entry.EffectiveFrom" type="date" required /><label asp-for="Entry.EffectiveThrough" data-i18n="Effective through">Effective through</label><input asp-for="Entry.EffectiveThrough" type="date" required />
<label asp-for="Entry.DeductionPercent" data-i18n="Employee deduction % of gross">Employee deduction % of gross</label><input asp-for="Entry.DeductionPercent" value="@(Model.Entry.DeductionPercent<0?"":Model.Entry.DeductionPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))" type="number" min="0" max="100" step="0.001" required />
<label asp-for="Entry.EmployerContributionPercent" data-i18n="Employer contribution % of gross">Employer contribution % of gross</label><input asp-for="Entry.EmployerContributionPercent" value="@(Model.Entry.EmployerContributionPercent<0?"":Model.Entry.EmployerContributionPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))" type="number" min="0" max="100" step="0.001" required />
<label asp-for="Entry.JurisdictionAndBasis" data-i18n="Jurisdiction and reviewed basis for daily or monthly pay, proration, leave, deductions and employer contributions">Jurisdiction and reviewed basis for daily or monthly pay, proration, leave, deductions and employer contributions</label><textarea asp-for="Entry.JurisdictionAndBasis" required maxlength="2000"></textarea>
<label asp-for="Entry.ExpenseAccount" data-i18n="Wage expense account (6xxx)">Wage expense account (6xxx)</label><input asp-for="Entry.ExpenseAccount" pattern="6[0-9]{3}" required maxlength="4" />
<label asp-for="Entry.PayableAccount" data-i18n="Employee salary payable (2xxx)">Employee salary payable (2xxx)</label><input asp-for="Entry.PayableAccount" pattern="2[0-9]{3}" required maxlength="4" />
<label asp-for="Entry.DeductionAccount" data-i18n="Deduction payable (different 2xxx)">Deduction payable (different 2xxx)</label><input asp-for="Entry.DeductionAccount" pattern="2[0-9]{3}" required maxlength="4" />
<label asp-for="Entry.EmployerExpenseAccount" data-i18n="Employer contribution expense (6xxx)">Employer contribution expense (6xxx)</label><input asp-for="Entry.EmployerExpenseAccount" pattern="6[0-9]{3}" required maxlength="4" />
<label asp-for="Entry.EmployerPayableAccount" data-i18n="Employer contribution payable (different 2xxx)">Employer contribution payable (different 2xxx)</label><input asp-for="Entry.EmployerPayableAccount" pattern="2[0-9]{3}" required maxlength="4" />
<button class="primary" type="submit" data-i18n="Submit policy for independent review">Submit policy for independent review</button></form></details>
@foreach(var p in Model.Browse.Items){<section class="panel"><h2><span data-i18n="Policy">Policy</span> @p.Id · @p.Name · <span data-i18n="@(p.Reviewed?"Reviewed and immutable":"Awaiting independent review")">@(p.Reviewed?"Reviewed and immutable":"Awaiting independent review")</span></h2><p>@p.EffectiveFrom.ToString("yyyy-MM-dd") <span data-i18n="to">to</span> @p.EffectiveThrough.ToString("yyyy-MM-dd"); @p.Currency, @p.CurrencyDecimals <span data-i18n="decimal places">decimal places</span>; <span data-i18n="Jurisdiction">Jurisdiction</span> @p.CountryCode @p.RegionCode; <span data-i18n="Timezone">Timezone</span> @p.TimeZoneId; <span data-i18n="Company policy">Company policy</span> @p.CompanyBusinessPolicyId.</p><p><span data-i18n="Pay basis">Pay basis</span>: <span data-i18n="@p.PayBasis">@p.PayBasis</span>; <span data-i18n="Monthly denominator mode">Monthly denominator mode</span>: <span data-i18n="@p.MonthlyProrationMode">@p.MonthlyProrationMode</span>; <span data-i18n="Fixed units">Fixed units</span>: @p.MonthlyFixedUnits; <span data-i18n="Cap units">Cap units</span>: <span data-i18n="@(p.CapMonthlyPaidUnits?"Yes":"No")">@(p.CapMonthlyPaidUnits?"Yes":"No")</span>.</p><p><span data-i18n="Employee deduction">Employee deduction</span> @p.DeductionPercent%; <span data-i18n="Employer contribution">Employer contribution</span> @p.EmployerContributionPercent%. @p.JurisdictionAndBasis</p><p><span data-i18n="Wages">Wages</span>: <span data-i18n="Debit">Debit</span> @p.ExpenseAccount; <span data-i18n="Salary payable">Salary payable</span>: <span data-i18n="Credit">Credit</span> @p.PayableAccount; <span data-i18n="Deductions">Deductions</span>: <span data-i18n="Credit">Credit</span> @p.DeductionAccount; <span data-i18n="Employer contribution">Employer contribution</span>: <span data-i18n="Debit">Debit</span> @p.EmployerExpenseAccount / <span data-i18n="Credit">Credit</span> @p.EmployerPayableAccount.</p>
@if(!p.Reviewed){<form asp-action="ReviewPolicy" asp-route-id="@p.Id" method="post"><input type="hidden" name="revision" value="@p.Revision" /><label><span data-i18n="Review note">Review note </span><textarea name="note" required maxlength="1000"></textarea></label><label><input type="checkbox" name="confirm" value="true" required  style="width:auto" /><span data-i18n="I reviewed the jurisdiction, daily/monthly pay, denominator, cap and leave basis, currency, effective dates, explicit rates and accounts."> I reviewed the jurisdiction, daily/monthly pay, denominator, cap and leave basis, currency, effective dates, explicit rates and accounts.</span></label><button class="primary" type="submit" data-i18n="Approve this policy version">Approve this policy version</button></form>}else{<p><span data-i18n="Reviewed by">Reviewed by</span> @p.ReviewedBy: @p.ReviewNote</p>}</section>}
<p>@Model.Browse.Total <span data-i18n="policies">policies</span>. <span data-i18n="Page">Page</span> @Model.Browse.Page <span data-i18n="of">of</span> @Model.Browse.Pages</p>
@if(Model.Browse.Page>1){<a asp-action="Policies" asp-route-page="@(Model.Browse.Page-1)" data-i18n="Previous">Previous</a>}
@if(Model.Browse.Page<Model.Browse.Pages){<a asp-action="Policies" asp-route-page="@(Model.Browse.Page+1)" data-i18n="Next">Next</a>}
