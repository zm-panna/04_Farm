@model HRPayrollPage<HRPayrollStaffInput>
@{ViewData["Title"]="Staff directory";}
<h1 data-i18n="Staff directory">Staff directory</h1><partial name="_Nav" />
<p data-i18n="Staff records are branch-scoped. Compensation is available only through separately authorized payroll screens.">Staff records are branch-scoped. Compensation is available only through separately authorized payroll screens.</p>
<a asp-action="Staff" class="primary" data-i18n="Add staff">Add staff</a>
<form method="get" class="panel"><label for="search" data-i18n="Search">Search</label><input id="search" name="search" value="@Model.Search" placeholder="Code, name or job title" data-i18n-placeholder="Code, name or job title" maxlength="160" /><label for="status" data-i18n="Status">Status</label><select id="status" name="status"><option value="" data-i18n="All">All</option><option value="Active" selected="@(Model.Status=="Active")" data-i18n="Active">Active</option><option value="Inactive" selected="@(Model.Status=="Inactive")" data-i18n="Inactive">Inactive</option></select><button class="primary" type="submit" data-i18n="Filter">Filter</button></form>
<div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Code">Code</th><th data-i18n="Name">Name</th><th data-i18n="Job title">Job title</th><th data-i18n="Employment">Employment</th><th data-i18n="Status">Status</th><th data-i18n="Actions">Actions</th></tr></thead><tbody>
@foreach(var s in Model.Items){<tr><td>@s.Code</td><td>@s.Name</td><td>@s.JobTitle</td><td>@s.StartDate.ToString("yyyy-MM-dd") <span data-i18n="to">to</span> @if(s.EndDate.HasValue){@s.EndDate.Value.ToString("yyyy-MM-dd")}else{<span data-i18n="Present">Present</span>}</td><td><span data-i18n="@(s.Active?"Active":"Inactive")">@(s.Active?"Active":"Inactive")</span></td><td><a asp-action="Staff" asp-route-id="@s.Id" data-i18n="Edit / deactivate">Edit / deactivate</a> · <a asp-action="Rates" asp-route-id="@s.Id" data-i18n="Pay rates">Pay rates</a> · <a asp-action="Identity" asp-route-id="@s.Id" data-i18n="@(s.HasIdentity?"Linked account":"Link verified account")">@(s.HasIdentity?"Linked account":"Link verified account")</a> · <a asp-action="Attendance" asp-route-staffId="@s.Id" data-i18n="Attendance">Attendance</a></td></tr>}
</tbody></table></div>
@if(Model.Items.Count==0){<p data-i18n="No staff match this filter.">No staff match this filter.</p>}
<p>@Model.Total <span data-i18n="records">records</span>. <span data-i18n="Page">Page</span> @Model.Page <span data-i18n="of">of</span> @Model.Pages</p>
@if(Model.Page>1){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page-1)" data-i18n="Previous">Previous</a>}
@if(Model.Page<Model.Pages){<a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page+1)" data-i18n="Next">Next</a>}
