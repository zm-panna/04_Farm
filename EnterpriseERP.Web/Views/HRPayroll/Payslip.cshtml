@model HRPayrollPayslip
@{ViewData["Title"]="Payslip "+Model.Run.Reference;var l=Model.Line;var r=Model.Run;var p=Model.Policy;var format="F"+r.CurrencyDecimals;}
<article class="panel"><h1 data-i18n="Employee payslip">Employee payslip</h1><p>@l.StaffName · @l.StaffCode</p><p><span data-i18n="Payroll">Payroll</span> @r.Reference · @r.PeriodStart.ToString("yyyy-MM-dd") <span data-i18n="to">to</span> @r.PeriodEnd.ToString("yyyy-MM-dd") · @r.Currency</p>
<dl><dt data-i18n="Paid attendance days">Paid attendance days</dt><dd>@l.AttendanceDays</dd><dt data-i18n="Approved paid leave days">Approved paid leave days</dt><dd>@l.PaidLeaveDays</dd><dt data-i18n="Compensation version / effective date">Compensation version / effective date</dt><dd>@l.CompensationVersion / @l.CompensationEffectiveFrom.ToString("yyyy-MM-dd")</dd><dt data-i18n="Pay basis">Pay basis</dt><dd><span data-i18n="@l.PayBasis">@l.PayBasis</span></dd><dt data-i18n="Contractual rate">Contractual rate</dt><dd>@(l.PayBasis=="Monthly"?l.MonthlySalary:l.DailyRate)</dd><dt data-i18n="Monthly proration method / denominator / paid units used">Monthly proration method / denominator / paid units used</dt><dd><span data-i18n="@l.ProrationMode">@l.ProrationMode</span> / @l.ProrationDenominator / @l.PaidUnitsUsed</dd><dt data-i18n="Base pay">Base pay</dt><dd>@l.BasePay.ToString(format)</dd><dt data-i18n="Overtime hours × hourly rate">Overtime hours × hourly rate</dt><dd>@l.OvertimeHours × @l.OvertimeHourlyRate</dd><dt data-i18n="Overtime pay">Overtime pay</dt><dd>@l.OvertimePay.ToString(format)</dd><dt data-i18n="Gross pay">Gross pay</dt><dd>@l.GrossPay.ToString(format)</dd><dt><span data-i18n="Reviewed employee deduction">Reviewed employee deduction</span> (@p.DeductionPercent%)</dt><dd>@l.Deductions.ToString(format)</dd><dt data-i18n="Net salary payable">Net salary payable</dt><dd><strong>@l.NetPay.ToString(format) @r.Currency</strong></dd><dt><span data-i18n="Employer contribution">Employer contribution</span> (@p.EmployerContributionPercent%)</dt><dd>@l.EmployerContribution.ToString(format)</dd></dl>
<p><span data-i18n="Policy">Policy</span> @p.Id: @p.Name. <span data-i18n="Jurisdiction">Jurisdiction</span> @p.CountryCode @p.RegionCode. @p.JurisdictionAndBasis</p><p><span data-i18n="Payroll accrual posted">Payroll accrual posted</span> @r.PostingDate, <span data-i18n="voucher">voucher</span> @r.VoucherId. <span data-i18n="This slip shows accrued salary and does not confirm that money has been transferred.">This slip shows accrued salary and does not confirm that money has been transferred.</span></p>
</article>
