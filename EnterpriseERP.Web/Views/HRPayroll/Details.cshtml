@model EnterpriseERP.Web.Controllers.HRPayrollDetailsPage
@{ViewData["Title"]="Payroll "+Model.Run.Reference;var r=Model.Run;var p=Model.Policy;var format="F"+r.CurrencyDecimals;}
<h1><span data-i18n="Payroll">Payroll</span> @r.Reference</h1><partial name="_Nav" />
<p><span data-i18n="@r.Status">@r.Status</span> · @r.PeriodStart.ToString("yyyy-MM-dd") <span data-i18n="through">through</span> @r.PeriodEnd.ToString("yyyy-MM-dd") · @r.Currency · <span data-i18n="Policy">Policy</span> @p.Id: @p.Name</p>
<p><span data-i18n="Jurisdiction">Jurisdiction</span> @p.CountryCode @p.RegionCode; <span data-i18n="Timezone">Timezone</span> @p.TimeZoneId. @p.JurisdictionAndBasis</p><p><span data-i18n="Gross = rounded base pay + rounded overtime pay; base pay follows the exact policy pay basis and proration. Deductions and employer contributions are rounded per employee, away from zero, to">Gross = rounded base pay + rounded overtime pay; base pay follows the exact policy pay basis and proration. Deductions and employer contributions are rounded per employee, away from zero, to</span> @r.CurrencyDecimals <span data-i18n="decimal places">decimal places</span>.</p>
<div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Staff">Staff</th><th data-i18n="Compensation version / effective date">Compensation version / effective date</th><th data-i18n="Pay basis / contractual rate">Pay basis / contractual rate</th><th data-i18n="Proration denominator / paid units used">Proration denominator / paid units used</th><th data-i18n="Attendance days">Attendance days</th><th data-i18n="Paid leave days">Paid leave days</th><th data-i18n="Overtime hours / rate">Overtime hours / rate</th><th data-i18n="Base pay">Base pay</th><th data-i18n="Overtime pay">Overtime pay</th><th data-i18n="Gross">Gross</th><th data-i18n="Deduction">Deduction</th><th data-i18n="Net payable">Net payable</th><th data-i18n="Employer contribution">Employer contribution</th><th data-i18n="Payslip">Payslip</th></tr></thead><tbody>
@foreach(var l in r.Lines.OrderBy(x=>x.StaffCode)){<tr><td>@l.StaffCode · @l.StaffName</td><td>@l.CompensationVersion / @l.CompensationEffectiveFrom.ToString("yyyy-MM-dd")</td><td><span data-i18n="@l.PayBasis">@l.PayBasis</span> / @(l.PayBasis=="Monthly"?l.MonthlySalary:l.DailyRate)</td><td><span data-i18n="@l.ProrationMode">@l.ProrationMode</span> / @l.ProrationDenominator / @l.PaidUnitsUsed</td><td>@l.AttendanceDays</td><td>@l.PaidLeaveDays</td><td>@l.OvertimeHours / @l.OvertimeHourlyRate</td><td>@l.BasePay.ToString(format)</td><td>@l.OvertimePay.ToString(format)</td><td>@l.GrossPay.ToString(format)</td><td>@l.Deductions.ToString(format)</td><td>@l.NetPay.ToString(format)</td><td>@l.EmployerContribution.ToString(format)</td><td>@if(r.Status=="Posted"){<a asp-action="Payslip" asp-route-id="@l.Id" data-i18n="View">View</a>}</td></tr>}
</tbody></table></div>
<p><span data-i18n="Totals">Totals</span>: <span data-i18n="Gross">Gross</span> @r.Lines.Sum(x=>x.GrossPay).ToString(format); <span data-i18n="Deductions">Deductions</span> @r.Lines.Sum(x=>x.Deductions).ToString(format); <span data-i18n="Net payable">Net payable</span> @r.Lines.Sum(x=>x.NetPay).ToString(format); <span data-i18n="Employer contribution">Employer contribution</span> @r.Lines.Sum(x=>x.EmployerContribution).ToString(format) @r.Currency.</p>
@if(r.Status=="Draft"){
<form asp-action="Recalculate" asp-route-id="@r.Id" method="post"><input type="hidden" name="revision" value="@r.Revision" /><label><span data-i18n="Exact reviewed replacement policy ID">Exact reviewed replacement policy ID</span><input name="replacementPolicyId" type="number" min="1" value="@r.PolicyId" required /></label><p data-i18n="Use the current policy ID or a corrected independently reviewed policy covering this month.">Use the current policy ID or a corrected independently reviewed policy covering this month.</p><button class="primary" type="submit" data-i18n="Recalculate from current source records">Recalculate from current source records</button></form>
<form asp-action="Approve" asp-route-id="@r.Id" method="post" class="panel"><input type="hidden" name="revision" value="@r.Revision" /><label><span data-i18n="Review note">Review note </span><textarea name="note" required maxlength="1000"></textarea></label><label><input type="checkbox" name="confirm" value="true" required  style="width:auto" /><span data-i18n="I reviewed every employee amount, attendance, leave, rates and exact policy."> I reviewed every employee amount, attendance, leave, rates and exact policy.</span></label><p><span data-i18n="Approver must be different from the last calculator">Approver must be different from the last calculator</span> (@r.CreatedBy). <span data-i18n="Approval locks source attendance and leave.">Approval locks source attendance and leave.</span></p><button class="primary" type="submit" data-i18n="Approve reviewed payroll">Approve reviewed payroll</button></form>
}else if(r.Status=="Approved"){
<p><span data-i18n="Approved by">Approved by</span> @r.ApprovedBy. @r.ReviewNote</p><form asp-action="Post" asp-route-id="@r.Id" method="post" class="panel"><input type="hidden" name="revision" value="@r.Revision" /><label><span data-i18n="Accounting posting date">Accounting posting date </span><input name="postingDate" type="date" value="@r.PeriodEnd.ToString("yyyy-MM-dd")" required /></label><p data-i18n="This creates a balanced wage/benefit expense and payable journal. Closed accounting periods are blocked. No bank transfer occurs.">This creates a balanced wage/benefit expense and payable journal. Closed accounting periods are blocked. No bank transfer occurs.</p><button class="primary" type="submit" data-i18n="Post approved payroll accrual">Post approved payroll accrual</button></form>
}else{<p><span data-i18n="Posted by">Posted by</span> @r.PostedBy <span data-i18n="on">on</span> @r.PostingDate. <span data-i18n="Journal voucher">Journal voucher</span> @r.VoucherId. <span data-i18n="Approved by">Approved by</span> @r.ApprovedBy: @r.ReviewNote. <span data-i18n="This payroll is immutable.">This payroll is immutable.</span></p>}
