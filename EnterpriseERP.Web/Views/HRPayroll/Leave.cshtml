@model EnterpriseERP.Web.Controllers.HRPayrollLeavePage
@{ViewData["Title"]="Leave requests and review";}
<h1 data-i18n="Leave requests and review">Leave requests and review</h1><partial name="_Nav" />
<form method="get"><label><span data-i18n="Staff">Staff </span><select name="staffId"><option value="0" data-i18n="All listed staff">All listed staff</option>@foreach(var s in Model.Browse.Staff){<option value="@s.Id" selected="@(Model.Browse.StaffId==s.Id)">@s.Code · @s.Name</option>}</select></label><label><span data-i18n="Status">Status </span><select name="status"><option value="" data-i18n="All">All</option>@foreach(var s in new[]{"Pending","Approved","Rejected"}){<option value="@s" selected="@(Model.Browse.Status==s)" data-i18n="@s">@s</option>}</select></label><button class="primary" type="submit" data-i18n="Filter">Filter</button></form>
<details><summary data-i18n="Request leave for staff (HR.Manage)">Request leave for staff (HR.Manage)</summary><form asp-action="RequestLeave" method="post" class="panel"><label asp-for="Entry.StaffId" data-i18n="Staff">Staff</label><select asp-for="Entry.StaffId" required><option value="" data-i18n="Choose staff">Choose staff</option>@foreach(var s in Model.Browse.Staff){<option value="@s.Id">@s.Code · @s.Name</option>}</select><label asp-for="Entry.From" data-i18n="From">From</label><input asp-for="Entry.From" type="date" required /><label asp-for="Entry.Through" data-i18n="Through (inclusive)">Through (inclusive)</label><input asp-for="Entry.Through" type="date" required /><label><input asp-for="Entry.Paid"  style="width:auto" /><span data-i18n="Request paid leave"> Request paid leave</span></label><label asp-for="Entry.Reason" data-i18n="Reason">Reason</label><textarea asp-for="Entry.Reason" required maxlength="1000"></textarea><button class="primary" type="submit" data-i18n="Request review">Request review</button></form></details>
@foreach(var l in Model.Browse.Items){var staff=Model.Browse.Staff.FirstOrDefault(x=>x.Id==l.StaffId);<section class="panel"><h2 >@(staff?.Code??l.StaffId.ToString()) · @(staff?.Name) · <span data-i18n="@l.Status">@l.Status</span></h2><p>@l.From.ToString("yyyy-MM-dd") <span data-i18n="to">to</span> @l.Through.ToString("yyyy-MM-dd") · <span data-i18n="@(l.Paid?"Paid":"Unpaid")">@(l.Paid?"Paid":"Unpaid")</span> · @l.Reason</p>
@if(l.Status=="Pending") {<form asp-action="ReviewLeave" asp-route-id="@l.Id" method="post"><input type="hidden" name="revision" value="@l.Revision" /><label><span data-i18n="Review note">Review note </span><input name="note" required maxlength="1000" /></label><button class="primary" name="approve" value="true" type="submit" data-i18n="Approve requested leave">Approve requested leave</button><button class="primary" name="approve" value="false" type="submit" data-i18n="Reject">Reject</button><p data-i18n="A different authorized reviewer is required. Attendance and leave cannot cover the same day.">A different authorized reviewer is required. Attendance and leave cannot cover the same day.</p></form>}else{<p><span data-i18n="Reviewer">Reviewer</span>: @l.ReviewedBy. @l.ReviewNote</p>}
</section>}
<p>@Model.Browse.Total <span data-i18n="records">records</span>. <span data-i18n="Page">Page</span> @Model.Browse.Page <span data-i18n="of">of</span> @Model.Browse.Pages</p>
@if(Model.Browse.Page>1){<a asp-action="Leave" asp-route-status="@Model.Browse.Status" asp-route-staffId="@Model.Browse.StaffId" asp-route-page="@(Model.Browse.Page-1)" data-i18n="Previous">Previous</a>}
@if(Model.Browse.Page<Model.Browse.Pages){<a asp-action="Leave" asp-route-status="@Model.Browse.Status" asp-route-staffId="@Model.Browse.StaffId" asp-route-page="@(Model.Browse.Page+1)" data-i18n="Next">Next</a>}
