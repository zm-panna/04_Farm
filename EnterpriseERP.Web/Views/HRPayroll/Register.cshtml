@model HRPayrollPage<EnterpriseERP.Domain.HRPayrollRun>
@{ViewData["Title"]="Payroll register";}
<h1 data-i18n="Payroll register">Payroll register</h1><partial name="_Nav" /><a asp-action="Calculate" class="primary" data-i18n="Calculate payroll draft">Calculate payroll draft</a>
<form method="get" class="panel"><label><span data-i18n="Reference">Reference </span><input name="search" value="@Model.Search" maxlength="60" /></label><label><span data-i18n="Status">Status </span><select name="status"><option value="" data-i18n="All">All</option>@foreach(var status in new[]{"Draft","Approved","Posted"}){<option value="@status" selected="@(Model.Status==status)" data-i18n="@status">@status</option>}</select></label><button class="primary" type="submit" data-i18n="Filter">Filter</button></form>
<div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Reference">Reference</th><th data-i18n="Period">Period</th><th data-i18n="Status">Status</th><th data-i18n="Staff">Staff</th><th data-i18n="Currency">Currency</th><th data-i18n="Gross">Gross</th><th data-i18n="Deductions">Deductions</th><th data-i18n="Net payable">Net payable</th><th data-i18n="Employer">Employer</th></tr></thead><tbody>
@foreach(var r in Model.Items){var format="F"+r.CurrencyDecimals;<tr><td><a asp-action="Details" asp-route-id="@r.Id">@r.Reference</a></td><td>@r.PeriodStart.ToString("yyyy-MM")</td><td><span data-i18n="@r.Status">@r.Status</span></td><td>@r.Lines.Count</td><td>@r.Currency</td><td>@r.Lines.Sum(x=>x.GrossPay).ToString(format)</td><td>@r.Lines.Sum(x=>x.Deductions).ToString(format)</td><td>@r.Lines.Sum(x=>x.NetPay).ToString(format)</td><td>@r.Lines.Sum(x=>x.EmployerContribution).ToString(format)</td></tr>}
</tbody></table></div><p data-i18n="Posting records a liability and expense. It does not pay employees.">Posting records a liability and expense. It does not pay employees.</p><p>@Model.Total <span data-i18n="runs">runs</span>. <span data-i18n="Page">Page</span> @Model.Page <span data-i18n="of">of</span> @Model.Pages</p>
@if(Model.Page>1){<a asp-action="Register" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page-1)" data-i18n="Previous">Previous</a>}
@if(Model.Page<Model.Pages){<a asp-action="Register" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page+1)" data-i18n="Next">Next</a>}
