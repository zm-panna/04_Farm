@model EnterpriseERP.Web.Controllers.HRPayrollCalculatePage
@{ViewData["Title"]="Calculate payroll draft";}
<h1 data-i18n="Calculate payroll draft">Calculate payroll draft</h1><partial name="_Nav" />
<p data-i18n="Only fully ended months are accepted. Complete attendance or approved leave for every calendar date within each person&#x27;s employment. Paid rest days must be recorded as one paid day; unpaid days as zero. Resolve pending leave first.">Only fully ended months are accepted. Complete attendance or approved leave for every calendar date within each person's employment. Paid rest days must be recorded as one paid day; unpaid days as zero. Resolve pending leave first.</p>
<form asp-action="Calculate" method="post" class="panel"><label asp-for="Entry.Reference" data-i18n="Unique payroll reference">Unique payroll reference</label><input asp-for="Entry.Reference" required maxlength="60" /><label asp-for="Entry.PeriodStart" data-i18n="Month start (first day)">Month start (first day)</label><input asp-for="Entry.PeriodStart" type="date" required /><label asp-for="Entry.PolicyId" data-i18n="Exact reviewed policy">Exact reviewed policy</label><select asp-for="Entry.PolicyId" required><option value="" data-i18n="Select policy">Select policy</option>@foreach(var p in Model.Policies){<option value="@p.Id">@p.Id · @p.Name · @p.Currency · @p.EffectiveFrom – @p.EffectiveThrough</option>}</select><button class="primary" type="submit" data-i18n="Calculate reviewable draft">Calculate reviewable draft</button></form>
