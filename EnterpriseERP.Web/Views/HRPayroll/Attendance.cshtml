@model EnterpriseERP.Web.Controllers.HRPayrollAttendancePage
@{ViewData["Title"]="Attendance";}
<h1 data-i18n="Attendance">Attendance</h1><partial name="_Nav" />
<p data-i18n="Every employment date in a payroll month needs one attendance entry or approved leave. Record contracted paid rest days as 1 paid day and unpaid days as 0. Approved or posted periods are locked.">Every employment date in a payroll month needs one attendance entry or approved leave. Record contracted paid rest days as 1 paid day and unpaid days as 0. Approved or posted periods are locked.</p>
<form method="get"><label for="staffFilter" data-i18n="Staff filter">Staff filter</label><select id="staffFilter" name="staffId"><option value="0" data-i18n="All listed staff">All listed staff</option>@foreach(var s in Model.Browse.Staff){<option value="@s.Id" selected="@(Model.Browse.StaffId==s.Id)">@s.Code · @s.Name</option>}</select><button class="primary" type="submit" data-i18n="Filter">Filter</button></form>
<details open><summary data-i18n="Add attendance">Add attendance</summary><form asp-action="SaveAttendance" method="post" class="panel">
<input asp-for="Entry.Id" type="hidden" /><input asp-for="Entry.Revision" type="hidden" />
<label asp-for="Entry.StaffId" data-i18n="Staff">Staff</label><select asp-for="Entry.StaffId" required><option value="" data-i18n="Choose staff">Choose staff</option>@foreach(var s in Model.Browse.Staff){<option value="@s.Id">@s.Code · @s.Name</option>}</select>
<label asp-for="Entry.Date" data-i18n="Date">Date</label><input asp-for="Entry.Date" type="date" required />
<label asp-for="Entry.PaidDays" data-i18n="Paid days">Paid days</label><select asp-for="Entry.PaidDays"><option value="0" data-i18n="0: unpaid day">0: unpaid day</option><option value="0.5" data-i18n="0.5: half day">0.5: half day</option><option value="1" data-i18n="1: full paid day / paid rest">1: full paid day / paid rest</option></select>
<label asp-for="Entry.OvertimeHours" data-i18n="Approved overtime hours">Approved overtime hours</label><input asp-for="Entry.OvertimeHours" type="number" min="0" max="24" step="0.001" />
<label asp-for="Entry.Note" data-i18n="Attendance basis / note">Attendance basis / note</label><input asp-for="Entry.Note" required maxlength="1000" /><button class="primary" type="submit" data-i18n="Save attendance">Save attendance</button></form></details>
@foreach(var a in Model.Browse.Items){var staff=Model.Browse.Staff.FirstOrDefault(x=>x.Id==a.StaffId);<details class="panel"><summary>@(staff?.Code??a.StaffId.ToString()) · @(staff?.Name) · @a.Date.ToString("yyyy-MM-dd") · @a.PaidDays <span data-i18n="Paid days">Paid days</span> · @a.OvertimeHours <span data-i18n="Overtime hours">Overtime hours</span></summary>
<form asp-action="SaveAttendance" method="post"><input type="hidden" name="Entry.Id" value="@a.Id" /><input type="hidden" name="Entry.StaffId" value="@a.StaffId" /><input type="hidden" name="Entry.Date" value="@a.Date.ToString("yyyy-MM-dd")" /><input type="hidden" name="Entry.Revision" value="@a.Revision" />
<label><span data-i18n="Paid days">Paid days </span><input name="Entry.PaidDays" value="@a.PaidDays.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="1" step="0.5" required /></label><label><span data-i18n="Overtime hours">Overtime hours </span><input name="Entry.OvertimeHours" value="@a.OvertimeHours.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="24" step="0.001" required /></label><label><span data-i18n="Note">Note </span><input name="Entry.Note" value="@a.Note" maxlength="1000" required /></label><button class="primary" type="submit" data-i18n="Update this date">Update this date</button></form></details>}
<p>@Model.Browse.Total <span data-i18n="records">records</span>. <span data-i18n="Page">Page</span> @Model.Browse.Page <span data-i18n="of">of</span> @Model.Browse.Pages</p>
@if(Model.Browse.Page>1){<a asp-action="Attendance" asp-route-staffId="@Model.Browse.StaffId" asp-route-page="@(Model.Browse.Page-1)" data-i18n="Previous">Previous</a>}
@if(Model.Browse.Page<Model.Browse.Pages){<a asp-action="Attendance" asp-route-staffId="@Model.Browse.StaffId" asp-route-page="@(Model.Browse.Page+1)" data-i18n="Next">Next</a>}
