@model HRPayrollRateInput
@{ViewData["Title"]="Confidential staff pay rates";}
<h1><span data-i18n="Confidential pay rates">Confidential pay rates</span>: @Model.Name (@Model.Currency)</h1><partial name="_Nav" />
<p data-i18n="Requires Payroll.Rates permission. Enter the applicable daily rate or monthly salary, plus the reviewed overtime hourly rate. The reviewed payroll policy must allow the selected contractual pay basis. Existing approved payslips retain their original rate snapshot.">Requires Payroll.Rates permission. Enter the applicable daily rate or monthly salary, plus the reviewed overtime hourly rate. The reviewed payroll policy must allow the selected contractual pay basis. Existing approved payslips retain their original rate snapshot.</p>
<form asp-action="SaveRates" method="post" class="panel"><input asp-for="StaffId" type="hidden" /><input asp-for="Name" type="hidden" /><input asp-for="Currency" type="hidden" /><input asp-for="Revision" type="hidden" />
<label asp-for="EffectiveFrom" data-i18n="Compensation effective date">Compensation effective date</label><input asp-for="EffectiveFrom" type="date" required /><p data-i18n="Choose a month boundary or the hire date. Compensation history is immutable; historical payroll uses its effective version.">Choose a month boundary or the hire date. Compensation history is immutable; historical payroll uses its effective version.</p>
<label asp-for="PayBasis" data-i18n="Contractual staff pay basis">Contractual staff pay basis</label><select asp-for="PayBasis"><option value="Daily" data-i18n="Daily">Daily</option><option value="Monthly" data-i18n="Monthly">Monthly</option></select>
<label asp-for="DailyRate" data-i18n="Daily rate">Daily rate</label><input asp-for="DailyRate" type="number" step="0.001" min="0" required />
<label asp-for="MonthlySalary" data-i18n="Monthly salary">Monthly salary</label><input asp-for="MonthlySalary" type="number" step="0.001" min="0" required />
<label asp-for="OvertimeHourlyRate" data-i18n="Overtime hourly rate">Overtime hourly rate</label><input asp-for="OvertimeHourlyRate" type="number" step="0.001" min="0" required />
<label asp-for="ReviewNote" data-i18n="Reason / approved rate basis">Reason / approved rate basis</label><textarea asp-for="ReviewNote" required maxlength="1000"></textarea>
<button type="submit" class="primary" data-i18n="Save reviewed rates">Save reviewed rates</button></form>

<section class="panel"><h2 data-i18n="Reviewed compensation history">Reviewed compensation history</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Version">Version</th><th data-i18n="Effective from">Effective from</th><th data-i18n="Pay basis">Pay basis</th><th data-i18n="Daily rate">Daily rate</th><th data-i18n="Monthly salary">Monthly salary</th><th data-i18n="Overtime hourly rate">Overtime hourly rate</th><th data-i18n="Review note">Review note</th></tr></thead><tbody>@foreach(var h in Model.History){<tr><td>@h.Version</td><td>@h.EffectiveFrom.ToString("yyyy-MM-dd")</td><td><span data-i18n="@h.PayBasis">@h.PayBasis</span></td><td>@h.DailyRate</td><td>@h.MonthlySalary</td><td>@h.OvertimeHourlyRate</td><td>@h.ReviewNote</td></tr>}</tbody></table></div></section>
