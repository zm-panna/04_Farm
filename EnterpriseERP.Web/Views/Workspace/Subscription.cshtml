@model EnterpriseERP.Web.Controllers.BillingPage
@{ViewData["Title"]="Subscription";}
@if(Model.CurrencyMinorUnits.HasValue){<p class="notice"><span data-i18n="Currency">Currency</span>: @Model.CurrencyCode · <span data-i18n="Currency decimal places">Currency decimal places</span>: @Model.CurrencyMinorUnits</p><p data-i18n="Historical fractions remain visible. New receipts follow the reviewed currency precision; incompatible historical balances require reviewed correction.">Historical fractions remain visible. New receipts follow the reviewed currency precision; incompatible historical balances require reviewed correction.</p>}
<h1 data-i18n="Subscription">Subscription</h1><section class="panel"><h2 data-i18n-enum="subscription" data-i18n-value="@Model.State.Status">@Model.State.Status</h2><p><span data-i18n="Outstanding">Outstanding</span>: @Model.Money(Model.State.Due) · <span data-i18n="Days overdue">Days overdue</span>: @Model.State.DaysPastDue</p><p data-i18n="Billing and support stay available during suspension. Payments below are manual records of money already received; this screen does not collect or charge money.">Billing and support stay available during suspension. Payments below are manual records of money already received; this screen does not collect or charge money.</p></section>
<section class="panel" id="invoice-browse"><h2 data-i18n="Invoices">Invoices</h2>
<partial name="_ActionableRecordBrowse" model="new EnterpriseERP.Web.Controllers.ActionableRecordBrowseModel(Model)" />
<table class="data-table"><thead><tr><th data-i18n="Reference">Reference</th><th data-i18n="Due date">Due date</th><th data-i18n="Amount">Amount</th><th data-i18n="Paid">Paid</th><th data-i18n="Status">Status</th></tr></thead><tbody>@foreach(var x in Model.Invoices){<tr><td>@x.Reference</td><td>@x.DueDate</td><td>@Model.Money(x.Amount)</td><td>@Model.Money(x.Paid)</td><td data-i18n="@(x.Cancelled?"Cancelled":x.Paid>=x.Amount?"Paid":"Open")">@(x.Cancelled?"Cancelled":x.Paid>=x.Amount?"Paid":"Open")</td></tr>}</tbody></table></section>
@if(User.IsInRole("PlatformAdmin") || User.HasClaim("permission", "platform.billing")) {
<section class="panel"><h2 data-i18n="Record an already received payment">Record an already received payment</h2><form method="post" action="/Subscription/payment">@Html.AntiForgeryToken()<label><span data-i18n="Invoice">Invoice</span><select name="invoiceId" required>@foreach(var x in Model.Invoices.Where(x=>!x.Cancelled&&x.Amount>x.Paid)){<option value="@x.Id" data-i18n-template="invoice-balance" data-i18n-values="@System.Text.Json.JsonSerializer.Serialize(new { reference = x.Reference, amount = Model.Money(x.Amount-x.Paid) })">@x.Reference - @(Model.Money(x.Amount-x.Paid)) due</option>}</select></label><label><span data-i18n="External payment reference">External payment reference</span><input name="reference" maxlength="90" required/></label><label><span data-i18n="Amount">Amount</span><input name="amount" type="number" min="@Model.MoneyStep" step="@Model.MoneyStep" required/></label><button class="primary" data-i18n="Record payment">Record payment</button></form></section>
}
else { <p data-i18n="Only authorized platform billing staff can record subscription payments. Contact support to reconcile a payment.">Only authorized platform billing staff can record subscription payments. Contact support to reconcile a payment.</p> }
<section class="panel"><h2 data-i18n="Recent payments">Recent payments</h2><table class="data-table"><thead><tr><th data-i18n="Reference">Reference</th><th data-i18n="Invoice">Invoice</th><th data-i18n="Amount">Amount</th><th data-i18n="Recorded UTC">Recorded UTC</th></tr></thead><tbody>@foreach(var x in Model.Payments){<tr><td>@x.Reference</td><td>@x.InvoiceId</td><td>@Model.Money(x.Amount)</td><td>@x.RecordedUtc</td></tr>}</tbody></table></section>
