@model EnterpriseERP.Web.Controllers.ReportPage
@{ViewData["Title"]="Reports";}
<h1 data-i18n="Reports">Reports</h1><p data-i18n="Live posted records for the selected company and branch. Account classification must match your approved chart of accounts.">Live posted records for the selected company and branch. Account classification must match your approved chart of accounts.</p>
<section class="kpi-grid"><article class="kpi"><span data-i18n="Active animals">Active animals</span><strong>@Model.Summary.AnimalCount</strong></article><article class="kpi"><span data-i18n="Milk litres">Milk litres</span><strong>@Model.Summary.MilkLitres.ToString("0.###")</strong></article><article class="kpi"><span data-i18n="Stock value">Stock value</span><strong>@Model.Summary.StockValue.ToString("N3")</strong></article><article class="kpi"><span data-i18n="Posted profit">Posted profit</span><strong data-i18n="@(Model.Statement is null ? "Restricted" : null)">@(Model.Statement?.Profit.ToString("N3") ?? "Restricted")</strong></article></section>
<p><a class="muted-btn" href="/api/operations/summary.csv" data-i18n="Summary CSV">Summary CSV</a> <a class="muted-btn" href="/api/advanced/farm-summary.pdf" data-i18n="Summary PDF">Summary PDF</a> <a class="muted-btn" href="/api/advanced/trial-balance.xlsx?through=@Uri.EscapeDataString(Model.ThroughExclusive.ToString("O"))" data-i18n="Trial balance Excel">Trial balance Excel</a></p>
@if(Model.Statement is not null) {
<section class="panel"><h2 data-i18n="Trial balance">Trial balance</h2><table class="data-table"><thead><tr><th data-i18n="Account">Account</th><th data-i18n="Debit">Debit</th><th data-i18n="Credit">Credit</th></tr></thead><tbody>@foreach(var x in Model.TrialBalance){<tr><td>@x.Account</td><td>@x.Debit.ToString("N3")</td><td>@x.Credit.ToString("N3")</td></tr>}<tr><th data-i18n="Total">Total</th><th>@Model.TrialBalance.Sum(x=>x.Debit).ToString("N3")</th><th>@Model.TrialBalance.Sum(x=>x.Credit).ToString("N3")</th></tr></tbody></table></section>
<section class="panel"><h2 data-i18n="Posted financial summary">Posted financial summary</h2><p><span data-i18n="Revenue">Revenue</span>: @Model.Statement.Revenue.ToString("N3") · <span data-i18n="Cost of sales">Cost of sales</span>: @Model.Statement.CostOfSales.ToString("N3") · <span data-i18n="Other expense">Other expense</span>: @Model.Statement.OtherExpense.ToString("N3")</p><p><span data-i18n="Assets">Assets</span>: @Model.Statement.Assets.ToString("N3") · <span data-i18n="Liabilities">Liabilities</span>: @Model.Statement.Liabilities.ToString("N3") · <span data-i18n="Opening equity">Opening equity</span>: @Model.Statement.Equity.ToString("N3")</p></section>

}
else { <p data-i18n="Ledger and financial statements require Accounts.View permission.">Ledger and financial statements require Accounts.View permission.</p> }
