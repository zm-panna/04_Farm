@model EnterpriseERP.Web.Controllers.AnimalHealthPage
@{ViewData["Title"]="Animal Health";var today=Model.Today;}
<div class="page-header"><div><span class="eyebrow" data-i18n="Animal care">Animal care</span><h1 data-i18n="Animal Health">Animal Health</h1><p class="subtle" data-i18n="Vaccination, deworming and veterinary history">Vaccination, deworming and veterinary history</p></div><a class="muted-btn" href="/breeding" data-i18n="Breeding records">Breeding records</a></div>
<section class="panel"><h2 data-i18n="Recorded follow-up dates">Recorded follow-up dates</h2><p class="notice" data-i18n="Dates below come from entered records. Mark completion only after staff confirms the follow-up was performed. This records work completed; it is not a medical decision.">Dates below come from entered records. Mark completion only after staff confirms the follow-up was performed. This records work completed; it is not a medical decision.</p>
<div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Animal">Animal</th><th data-i18n="Event">Event</th><th data-i18n="Reference">Reference</th><th data-i18n="Next Due">Next Due</th><th data-i18n="Review">Review</th><th data-i18n="Record completion">Record completion</th></tr></thead><tbody>
@foreach(var r in Model.DueRecords){<tr><td>@Model.AnimalTags.GetValueOrDefault(r.AnimalId,r.AnimalId.ToString())</td><td><span data-i18n="@r.EventType">@r.EventType</span></td><td>@r.Reference</td><td>@r.NextDueDate?.ToString("yyyy-MM-dd")</td><td><span class="status @(r.NextDueDate<today?"warn":"")" data-i18n="@(r.NextDueDate<today?"Date passed":"Due within 30 days")">@(r.NextDueDate<today?"Date passed":"Due within 30 days")</span></td><td><form method="post" action="/animal-health/follow-up/complete">@Html.AntiForgeryToken()<input type="hidden" name="FollowUp.RecordId" value="@r.Id"/><label for="completed-@r.Id" data-i18n="Completion date">Completion date</label><input id="completed-@r.Id" type="date" name="FollowUp.CompletedDate" value="@today.ToString("yyyy-MM-dd")" min="@r.EventDate.ToString("yyyy-MM-dd")" max="@today.ToString("yyyy-MM-dd")" required/><button class="muted-btn" type="submit" data-i18n="Mark completed">Mark completed</button></form></td></tr>}
@if(Model.DueRecords.Count==0){<tr><td colspan="6" data-i18n="No recorded follow-up dates within 30 days.">No recorded follow-up dates within 30 days.</td></tr>}
</tbody></table></div></section>
<div class="panels"><section class="panel"><h2 data-i18n="New Health Record">New Health Record</h2><div asp-validation-summary="All" role="alert" aria-live="polite"></div>
<form method="post" action="/animal-health/record">@Html.AntiForgeryToken()
<label asp-for="Entry.AnimalId" data-i18n="Animal">Animal</label><select asp-for="Entry.AnimalId" required><option value="" data-i18n="Select animal">Select animal</option>@foreach(var a in Model.Animals){<option value="@a.Id">@a.Tag (@a.Breed)</option>}</select>
<label asp-for="Entry.Reference" data-i18n="Reference">Reference</label><input asp-for="Entry.Reference" maxlength="80" required />
<label asp-for="Entry.EventType" data-i18n="Event">Event</label><select asp-for="Entry.EventType">@foreach(var eventType in new[]{"Vaccination","Deworming","Treatment","VetVisit","Observation"}){<option value="@eventType" data-i18n="@eventType">@eventType</option>}</select>
<label asp-for="Entry.EventDate" data-i18n="Event date">Event date</label><input type="date" asp-for="Entry.EventDate" required />
<label asp-for="Entry.NextDueDate" data-i18n="Next Due">Next Due</label><input type="date" asp-for="Entry.NextDueDate" />
<label asp-for="Entry.Details" data-i18n="Details">Details</label><textarea asp-for="Entry.Details" maxlength="4000" rows="4"></textarea>
<button class="primary" type="submit" data-i18n="Save health record">Save health record</button></form></section>
<section class="panel"><h2 data-i18n="Filter health history">Filter health history</h2><form method="get" action="/animal-health"><label for="filter-animal" data-i18n="Animal">Animal</label><select name="animalId" id="filter-animal"><option value="" data-i18n="All">All</option>@foreach(var a in Model.AnimalTags){<option value="@a.Key" selected="@(Model.Entry.AnimalId==a.Key)">@a.Value</option>}</select><button class="muted-btn" type="submit" data-i18n="Filter">Filter</button></form><p class="subtle" data-i18n="Latest 100 health records and up to 100 recorded follow-up dates are shown.">Latest 100 health records and up to 100 recorded follow-up dates are shown.</p></section></div>
<section class="panel"><h2 data-i18n="Recent records">Recent records</h2><div class="farm-table"><table class="data-table"><thead><tr><th data-i18n="Animal">Animal</th><th data-i18n="Reference">Reference</th><th data-i18n="Event">Event</th><th data-i18n="Date">Date</th><th data-i18n="Next Due">Next Due</th><th data-i18n="Details">Details</th><th data-i18n="Completed">Completed</th></tr></thead><tbody>
@foreach(var r in Model.Records){<tr><td>@Model.AnimalTags.GetValueOrDefault(r.AnimalId,r.AnimalId.ToString())</td><td>@r.Reference</td><td><span data-i18n="@r.EventType">@r.EventType</span></td><td>@r.EventDate.ToString("yyyy-MM-dd")</td><td>@r.NextDueDate?.ToString("yyyy-MM-dd")</td><td>@r.Details</td><td>@r.FollowUpCompletedDate?.ToString("yyyy-MM-dd")</td></tr>}
@if(!Model.Records.Any()){<tr><td colspan="7" data-i18n="No health history">No health history</td></tr>}
</tbody></table></div></section>
