{
  "Database": { "Provider": "SqlServer" },
  "ConnectionStrings": { "DefaultConnection": "" },
  "AllowedHosts": "farm.example.invalid",
  "TrustedVault": {
    "Mode": "OpenBao",
    "RequireInProduction": true,
    "Address": "https://vault.example.invalid",
    "Mount": "secret",
    "AuthMethod": "AppRole",
    "AuthMount": "approle",
    "RoleIdFile": "C:\\ProgramData\\FarmTrusted\\bootstrap\\role-id",
    "SecretIdFile": "C:\\ProgramData\\FarmTrusted\\bootstrap\\secret-id",
    "RecheckSeconds": 30,
    "MaximumTokenLifetimeSeconds": 3600,
    "MaximumSecretLifetimeMinutes": 1440,
    "AllowDevelopmentLoopbackHttp": false
  },
  "TrustedProxy": {
    "Enabled": true,
    "KnownProxyIp": "192.0.2.10",
    "PublicOrigin": "https://farm.example.invalid"
  },
  "Security": {
    "DataProtection": {
      "KeyDirectory": "C:\\ProgramData\\FarmTrusted\\keys",
      "ApplicationName": "Farm-Reviewed-Installation",
      "ProtectionMode": "Dpapi"
    }
  },
  "Scaling": {
    "Cache": { "Enabled": false, "Connection": "", "KeyPrefix": "farm:grid:v1" },
    "SignalR": { "RedisEnabled": false, "Connection": "", "ChannelPrefix": "farm:signalr:v1" }
  }
}
